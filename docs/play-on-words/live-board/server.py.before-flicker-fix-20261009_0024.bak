    tr { border-bottom: 1px solid var(--line); padding: 10px 0; }
    tr.new { box-shadow: inset 3px 0 0 var(--gold); }
  }
  /* --- wordplay highlights (additive) --- */
  #hl-wrap { --su: #5aa9ff; --pl: #ffd84d; --hd: #3ddc84; }
  #hl-wrap .hl-sub { color: var(--text-muted); margin: 0 0 10px; }
  #hl-wrap .hl-legend { display: flex; gap: 14px; flex-wrap: wrap; color: var(--text-muted); font-size: 13px; margin: 0 0 6px; }
  #hl-tabs { margin: 0 0 12px; }
