  .hl-row { background: var(--surface-2); border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; }
  .hl-row.possible { border-style: dashed; opacity: .92; }
  .hl-bar { font: 18px/1.55 Georgia, "Times New Roman", serif; color: var(--text-main); }
  .hl-bar .su { color: #0b1220; background: var(--su); border-radius: 4px; padding: 0 3px; }
  .hl-bar .pl { color: #1a1500; background: var(--pl); border-radius: 4px; padding: 0 3px; font-weight: 700; }
  .hl-legend .su { color: #0b1220; background: var(--su); border-radius: 4px; padding: 0 5px; }
  .hl-legend .pl { color: #1a1500; background: var(--pl); border-radius: 4px; padding: 0 5px; font-weight: 700; }
