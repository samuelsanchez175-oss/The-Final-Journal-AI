  }
  .chip { font: 400 15px/1.2 "DM Mono", "JetBrains Mono", Menlo, monospace; letter-spacing: .02em; }
  .kind, .bad, .ok { color: var(--amber); white-space: nowrap; }
  .meta { color: var(--text-muted); font-size: 13px; }
  tr.new td { box-shadow: inset 3px 0 0 var(--amber); }
  tr { cursor: pointer; }
  tr:hover td { background: var(--surface-2); }
  .detail { display: none; background: var(--surface); }
  tr.open + .detail { display: table-row; }
  .detail td { padding: 4px 8px 16px 16px; }
  a { color: var(--amber); }
  .empty { color: var(--text-muted); padding: 18px 0; }
  .batch td { font-size: 15px; }
  .bar {
    width: min(180px, 100%);
