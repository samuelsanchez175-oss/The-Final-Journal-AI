    margin: 6px 0 0;
  }
  h2 { font-size: 13px; margin: 0 0 10px; }
  .status { color: var(--text-muted); max-width: 980px; margin: 8px 0 0; }
  .row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 12px; }
  .telemetry {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    padding: 1px;
    background: var(--line);
  }
  .readout {
    background: var(--surface);
    min-height: 118px;
    padding: 18px 20px;
