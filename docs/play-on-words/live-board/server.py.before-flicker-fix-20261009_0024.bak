    background: var(--line);
    padding: 1px;
  }
  .brand,
  .terminal-feed {
    background: var(--surface);
    padding: 18px 20px;
  }
  .eyebrow {
    color: var(--text-muted);
    font: 10px/1.2 "DM Mono", "JetBrains Mono", Menlo, monospace;
    letter-spacing: .18em;
