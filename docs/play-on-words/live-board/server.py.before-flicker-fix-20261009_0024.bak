STOP = {
    "a", "an", "the", "my", "your", "his", "her", "our", "their", "like",
    "im", "its", "it", "on", "in", "to", "of", "and", "with", "for", "me",
    "you", "that", "this", "was", "were", "from", "just", "got", "get",
}
SEX = re.compile(
    r"\b(sex|sexual|condom|orgasm|nude|naked|ejacul\w*|sperm|intercourse|"
    r"from the rear|rear end|in bed|one night stand)\b",
    re.I,
)
TAG_RE = re.compile(r"<[^>]+>")
VIEW_RE = re.compile(r"\d+(?:\.\d+)?[KMB]\s*$")

SOUNDEX_MAP = str.maketrans(
    {
        **{c: "1" for c in "bfpv"},
        **{c: "2" for c in "cgjkqsxz"},
        **{c: "3" for c in "dt"},
        **{c: "4" for c in "l"},
        **{c: "5" for c in "mn"},
        **{c: "6" for c in "r"},
    }
)


def normalize(word: str) -> str:
    text = unicodedata.normalize("NFKD", word)
    text = "".join(ch for ch in text if not unicodedata.combining(ch))
    text = text.lower().replace("\u2019", "").replace("'", "")
    text = re.sub(r"[^a-z0-9\s]", " ", text)
    return " ".join(text.split())


def content_tokens(text: str) -> list[str]:
    return [t for t in normalize(text).split() if t not in STOP and len(t) > 2]


def soundex(word: str) -> str:
    cleaned = re.sub(r"[^a-z]", "", normalize(word))
    if not cleaned:
        return ""
    coded = cleaned[0] + cleaned[1:].translate(SOUNDEX_MAP)
    squashed = coded[0]
    for ch in coded[1:]:
        if ch != squashed[-1] and ch != "0":
            squashed += ch
    return (squashed + "000")[:4]


def skeleton(word: str) -> str:
    cleaned = re.sub(r"[^a-z]", "", normalize(word))
    return re.sub(r"[aeiouy]", "", cleaned)


def edit_distance(left: str, right: str) -> int:
    if abs(len(left) - len(right)) > 2:
        return 9
    prev = list(range(len(right) + 1))
    for i, ca in enumerate(left, 1):
        cur = [i]
        for j, cb in enumerate(right, 1):
            cur.append(min(prev[j] + 1, cur[-1] + 1, prev[j - 1] + (ca != cb)))
        prev = cur
    return prev[-1]


def sounds_alike(left: str, right: str) -> bool:
    a = [t for t in content_tokens(left) if len(t) > 2]
    b = [t for t in content_tokens(right) if len(t) > 2]
    if not a or not b:
        return False
    for x in a:
        for y in b:
            if x == y:
                continue
            if soundex(x) == soundex(y) and soundex(x):
                return True
            if edit_distance(x, y) <= 2:
                return True
            sx, sy = skeleton(x), skeleton(y)
            if len(sx) >= 3 and len(sy) >= 3 and (sx[:3] == sy[:3] or sx in sy or sy in sx):
                return True
    return False


def swift_strings(block: str) -> list[str]:
    out: list[str] = []
    i = 0
    n = len(block)
    while i < n:
        if block[i] != '"':
            i += 1
            continue
        j = i + 1
        chars: list[str] = []
        closed = False
        while j < n:
            c = block[j]
            if c == "\\":
                if j + 1 < n:
                    chars.append(block[j + 1])
                    j += 2
                    continue
            if c == '"':
                out.append("".join(chars))
                i = j + 1
                closed = True
                break
            chars.append(c)
            j += 1
        if not closed:
            break
    return out


def case_block(text: str, name: str) -> str | None:
    key = f"case .{name}:"
    i = text.find(key)
    if i < 0:
        return None
    rest = text[i + len(key) :]
    m = re.search(r"\n        case \.", rest)
    return rest[: m.start()] if m else rest


def parse_sections(text: str) -> list[tuple[str, list[str]]]:
    block = case_block(text, "wordplay")
    if block is None:
        raise ValueError("wordplay case missing in sections")
    found = []
    for match in re.finditer(
        r'NounChipSection\(title:\s*"((?:\\.|[^"\\])*)",\s*words:\s*\[(.*?)\]\s*\)',
        block,
        re.S,
    ):
        title = match.group(1).replace('\\"', '"')
        words = swift_strings(match.group(2))
        if words:
            found.append((title, words))
    if not found:
        raise ValueError("no wordplay sections")
    return found


def parse_store(text: str) -> list[str]:
    key = "case .wordplay:"
    start = 0
    while True:
        i = text.find(key, start)
        if i < 0:
            raise ValueError("wordplay store list missing")
        rest = text[i + len(key) :]
        match = re.search(r"\n        case \.", rest)
        block = rest[: match.start()] if match else rest
        open_at = block.find("[")
        close_at = block.rfind("]")
        if open_at >= 0 and close_at > open_at:
            words = swift_strings(block[open_at : close_at + 1])
            if words:
                return words
        start = i + len(key)


def collection_body(text: str, marker: str) -> str:
    """Body of a Swift array or dictionary written with square brackets."""
    i = text.find(marker)
    if i < 0:
        raise ValueError(f"missing {marker}")
    match = re.search(r"=\s*\[", text[i:])
    if not match:
        raise ValueError(f"missing collection after {marker}")
    a = i + match.end() - 1
    depth = 0
    in_string = False
    j = a
    while j < len(text):
        char = text[j]
        if in_string:
            if char == "\\":
                j += 2
                continue
            if char == '"':
                in_string = False
            j += 1
            continue
        if char == '"':
            in_string = True
            j += 1
            continue
        if char == "[":
            depth += 1
        elif char == "]":
            depth -= 1
            if depth == 0:
                return text[a + 1 : j]
        j += 1
    raise ValueError(f"unclosed collection after {marker}")


def parse_pairs(body: str) -> dict[str, list[str]]:
    """Swift dictionary of string -> string or string -> [string]."""
    pairs: dict[str, list[str]] = {}
    i = 0
    n = len(body)
    while i < n:
        if body[i] != '"':
            i += 1
            continue
        key, i = read_swift_string(body, i)
        while i < n and body[i] in " \t\r\n":
            i += 1
        if i >= n or body[i] != ":":
            continue
        i += 1
        while i < n and body[i] in " \t\r\n":
            i += 1
        if i < n and body[i] == "[":
            end = body.find("]", i)
            if end < 0:
                break
            pairs[normalize(key)] = swift_strings(body[i : end + 1])
            i = end + 1
        elif i < n and body[i] == '"':
            value, i = read_swift_string(body, i)
            pairs[normalize(key)] = [value]
        else:
            i += 1
    return pairs


def read_swift_string(text: str, i: int) -> tuple[str, int]:
    if text[i] != '"':
        raise ValueError("expected string")
    j = i + 1
    chars: list[str] = []
    while j < len(text):
        c = text[j]
        if c == "\\":
            if j + 1 < len(text):
                chars.append(text[j + 1])
                j += 2
                continue
        if c == '"':
            return "".join(chars), j + 1
        chars.append(c)
        j += 1
    raise ValueError("unclosed string")


def clean_song(song: str, artist: str) -> str:
    text = TAG_RE.sub("", song or "")
    text = text.replace("\u2019", "'")
    if artist and artist in text:
        text = text.replace(artist, " ", 1)
    text = VIEW_RE.sub("", text)
    text = " ".join(text.split())
    return text or "Untitled song"


def load_notes(paths: list[Path]) -> list[dict]:
    notes = []
    for path in paths:
        if not path.exists():
            continue
        with path.open(encoding="utf-8", errors="replace") as handle:
            for line in handle:
                line = line.strip()
                if not line:
                    continue
                try:
                    row = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if row.get("type") not in (None, "line"):
                    continue
                lyric = row.get("line") or ""
                meaning = row.get("meaning") or ""
                artist = row.get("artist") or ""
                notes.append(
                    {
                        "id": str(row.get("annotation_id") or ""),
                        "artist": artist,
                        "song": clean_song(row.get("song") or "", artist),
                        "line": lyric,
                        "line_norm": normalize(lyric),
                        "meaning": meaning,
                        "votes": int(row.get("votes") or 0),
                        "state": row.get("state") or "",
                        "strength": row.get("strength") or "",
                        "url": row.get("url") or "",
                    }
                )
    return notes


def load_artist_progress() -> list[dict]:
    rows = []
    logs = dict(CLICK_LOGS)
    for path in sorted(NOTES_DIR.glob("*.jsonl")):
        artist = path.stem.replace("-", " ").title()
        artist = {
            "juice wrld": "Juice WRLD",
            "lil uzi vert": "Lil Uzi Vert",
            "nocap": "NoCap",
        }.get(path.stem, artist)
        logs.setdefault(artist, path)
    ordered = sorted(logs.items(), key=lambda item: (ARTIST_ORDER.index(item[0]) if item[0] in ARTIST_ORDER else 999, item[0]))
    for artist, path in ordered:
        stats = {
            "artist": artist,
            "path": str(path.relative_to(ROOT)),
            "exists": path.exists(),
            "age": None,
            "rows": 0,
            "valid": 0,
            "invalid": 0,
            "songs": set(),
            "opened": set(),
            "done": 0,
            "missing": 0,
            "saved_notes": 0,
            "second_sense": 0,
            "not_new": 0,
            "last_song": "",
            "last_line": "",
        }
        if not path.exists():
            rows.append(stats)
            continue
        stats["age"] = time.time() - path.stat().st_mtime
        with path.open(encoding="utf-8", errors="replace") as handle:
            for line in handle:
                line = line.strip()
                if not line:
                    continue
                stats["rows"] += 1
                try:
                    row = json.loads(line)
                except json.JSONDecodeError:
                    stats["invalid"] += 1
                    continue
                stats["valid"] += 1
                song = clean_song(row.get("song") or "", row.get("artist") or artist)
                if song:
                    stats["songs"].add(song)
                if row.get("clicked") or ((row.get("type") or "line") == "song" and (row.get("status") or "").lower() == "done"):
                    stats["opened"].add(song)
                kind = row.get("type") or "line"
                status = (row.get("click_status") or "").lower()
                meaning = row.get("meaning") or ""
                if kind == "song":
                    if status == "done":
                        stats["done"] += 1
                    elif status == "missing":
                        stats["missing"] += 1
                if row.get("second_sense"):
                    stats["second_sense"] += 1
                if meaning and meaning != "Opened. Not a new chip.":
                    stats["saved_notes"] += 1
                else:
                    stats["not_new"] += 1
                stats["last_song"] = song
                stats["last_line"] = row.get("line") or status or kind
        total_songs = len(stats["songs"])
        opened_songs = len(stats["opened"])
        stats["song_total"] = total_songs
        stats["opened_songs"] = opened_songs
        stats["unopened_songs"] = max(total_songs - opened_songs, stats["missing"])
        stats["pct"] = round((opened_songs / total_songs) * 100) if total_songs else 0
        stats["status"] = "open" if stats["unopened_songs"] or stats["invalid"] else "done"
        stats["songs"] = total_songs
        stats["opened"] = opened_songs
        rows.append(stats)
    return rows


def build_index(notes: list[dict]) -> dict[str, list[int]]:
    index: dict[str, list[int]] = {}
    for i, note in enumerate(notes):
        for token in set(note["line_norm"].split()):
            if len(token) < 3 or token in STOP:
                continue
            index.setdefault(token, []).append(i)
    return index


def best_note(chip_norm: str, brief: str, partners: list[str], notes: list[dict], index: dict[str, list[int]]) -> dict | None:
    tokens = content_tokens(chip_norm) or [t for t in chip_norm.split() if len(t) > 2]
    if not tokens:
        return None
    lists = []
    for token in tokens:
        hits = index.get(token)
        if hits:
            lists.append(hits)
    if not lists:
        return None
    lists.sort(key=len)
    chosen = set(lists[0])
    for other in lists[1:]:
        chosen &= set(other)
        if not chosen:
            break
    if not chosen and len(tokens) > 1:
        longest = max(tokens, key=len)
        chosen = set(index.get(longest, []))
    if not chosen:
        return None
    senses = [word for word in second_sense(brief) if len(word) >= 4]
    for partner in partners:
        senses.extend(token for token in content_tokens(partner) if len(token) >= 4)
    if senses:
        preferred = []
        for i in chosen:
            blob = notes[i]["line_norm"] + " " + normalize(notes[i]["meaning"])
            if any(word in blob for word in senses):
                preferred.append(i)
        if preferred:
            chosen = set(preferred)
        elif len(tokens) == 1:
            # A lone name with a claimed second word, and no note mentions that word.
            # Attaching a different bar that only says the name hides the miss.
            return None
    phrase = chip_norm

    def rank(i: int) -> tuple:
        note = notes[i]
        line_norm = note["line_norm"]
        phrase_hit = 1 if phrase and phrase in line_norm else 0
        accepted = 1 if note["strength"] == "accepted" or note["state"] == "accepted" else 0
        return (phrase_hit, accepted, note["votes"])

    winner = max(chosen, key=rank)
    if rank(winner)[0] == 0 and len(tokens) > 1:
        return None
    return notes[winner]


def second_sense(brief: str) -> list[str]:
    if not brief or "in the line" in brief.lower():
        return []
    match = re.match(r"(.+?) is (.+?)(?:\.|$)", brief.strip())
    if not match:
        return []
    return content_tokens(match.group(2))


def echo_note(note: dict) -> bool:
    meaning = normalize(note["meaning"])
    line = note["line_norm"]
    if not meaning or not line:
        return False
    if meaning == line or meaning in line or line in meaning:
        return True
    if SequenceMatcher(None, meaning[:280], line[:280]).ratio() > 0.72:
        extra = set(content_tokens(meaning)) - set(content_tokens(line))
        return len(extra) < 2
    return False


def hidden_flip(brief: str) -> str:
    """The sense that shows up once both halves of the pair are on the line."""
    text = (brief or "").strip()
    if not text:
        return ""
    sound = re.search(r"sounds like\s+(.+?)(?:\.|$)", text, re.I)
    if sound:
        flip = sound.group(1)
    else:
        match = re.match(r".+?\bis\b\s+(.+?)(?:\.|$)", text, re.I)
        if not match:
            return ""
        flip = match.group(1)
        if "in the line" in flip.lower():
            rest = text[match.end() :].strip()
            rest = re.sub(r"^[^.]*\bis\b\s+", "", rest, count=1, flags=re.I)
            return rest.strip(" .")
    flip = re.sub(r",?\s*said beside\b.*$", "", flip, flags=re.I)
    return flip.strip(" .")


def both_halves_on_line(partners: list[str], note: dict | None) -> bool:
    if not partners or note is None:
        return False
    line = note["line_norm"]
    for partner in partners:
        tokens = content_tokens(partner) or [token for token in normalize(partner).split() if len(token) > 2]
        if tokens and all(token in line for token in tokens):
            return True
    return False


def classify(chip: str, brief: str, note: dict | None) -> str:
    text = brief or ""
    lowered = text.lower()
    match = re.match(r"(.+?) is (.+?)(?:\.|$)", text.strip())
    if "sounds like" in lowered or (
        match and "in the line" not in lowered and (sounds_alike(chip, match.group(2)) or sounds_alike(match.group(1), match.group(2)))
    ):
        return "Phonetic"
    # The sentence is the claim. A Genius note can mention sex while explaining a different flip.
    if SEX.search(text) or re.search(r"\b(breasts|skeet|condom)\b", lowered):
        return "Double entendre"
    if text:
        return "Double meaning"
    if note and SEX.search(note["meaning"]):
        return "Double entendre"
    return "Play on words"


def check_labels(chip_norm: str, brief: str, partners: list[str], note: dict | None, in_store: bool, in_section: bool) -> list[str]:
    labels = []
    if in_store != in_section:
        labels.append("Only in one file")
    if not brief:
        labels.append("Missing sentence")
    if not partners:
        labels.append("Missing partner")
    if note is None:
        labels.append("No Genius note joined")
    else:
        if echo_note(note):
            labels.append("Note repeats the line")
        weak = note["votes"] <= 0 or note["state"] == "pending" or note["strength"] == "weak"
        if weak:
            labels.append("Weak note")
        senses = second_sense(brief)
        if senses:
            meaning = normalize(note["meaning"])
            line = note["line_norm"]
            in_note = any(word in meaning.split() or word in meaning for word in senses)
            in_line = any(word in line.split() for word in senses)
            if in_note:
                labels.append("Note names the second sense")
            elif in_line:
                labels.append("Bar names the second sense")
            else:
                labels.append("Sentence is ahead of the note")
        elif brief and "in the line" in brief.lower():
            labels.append("Name half of a pair")
    if not labels:
        labels.append("Clean")
    return labels


NEEDS = {
    "Only in one file",
    "Missing sentence",
    "Missing partner",
    "No Genius note joined",
    "Note repeats the line",
    "Weak note",
    "Sentence is ahead of the note",
}


def harness_snapshot() -> dict:
    sentence = "The other terminal has not posted a status line yet."
    batch: list[dict] = []
    age = None
    if HARNESS_CHAT.exists():
        age = time.time() - HARNESS_CHAT.stat().st_mtime
        texts: list[str] = []
        with HARNESS_CHAT.open(encoding="utf-8", errors="replace") as handle:
            for line in handle:
                try:
                    row = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if row.get("type") == "assistant" and isinstance(row.get("content"), str):
                    text = row["content"].strip()
                    if text:
                        texts.append(text)
        if texts:
            sentence = " ".join(texts[-1].split())
            if len(sentence) > 420:
                sentence = sentence[:417] + "..."
            for text in reversed(texts):
                if "| Chip |" in text or "| chip |" in text.lower():
                    batch = parse_table(text)
                    break
    return {"sentence": sentence, "age": age, "batch": batch}


def takeover_snapshot() -> dict:
    if not TAKEOVER_STATUS.exists():
        return {
            "agent": "Codex takeover",
            "lane": "No active takeover lane",
            "state": "standby",
            "detail": "No local takeover status file is present.",
            "done": 0,
            "total": 0,
            "age": None,
        }
    try:
        payload = json.loads(TAKEOVER_STATUS.read_text(encoding="utf-8", errors="replace"))
    except (OSError, json.JSONDecodeError) as exc:
        return {
            "agent": "Codex takeover",
            "lane": "Status parse error",
            "state": "blocked",
            "detail": str(exc),
            "done": 0,
            "total": 0,
            "age": None,
        }
    payload["age"] = time.time() - TAKEOVER_STATUS.stat().st_mtime
    payload.setdefault("done", 0)
    payload.setdefault("total", 0)
    payload.setdefault("subagents", [])
    return payload


def load_highlights() -> dict:
    """Read docs/play-on-words/wordplay-highlights.jsonl at request time."""
    out = {"ok": True, "path": str(HIGHLIGHTS), "mtime": None, "rows": [], "bad_lines": 0}
    try:
        stat = HIGHLIGHTS.stat()
        out["mtime"] = stat.st_mtime
        with HIGHLIGHTS.open(encoding="utf-8") as fh:
            for raw in fh:
                raw = raw.strip()
                if not raw:
                    continue
                try:
                    row = json.loads(raw)
                except json.JSONDecodeError:
                    out["bad_lines"] += 1
                    continue
                if isinstance(row, dict) and row.get("bar"):
                    out["rows"].append(row)
    except FileNotFoundError:
        out["ok"] = False
        out["error"] = "wordplay-highlights.jsonl not found"
    except OSError as err:
        out["ok"] = False
        out["error"] = str(err)
    out["count"] = len(out["rows"])
    out["confirmed"] = sum(1 for r in out["rows"] if not str(r.get("list", "")).startswith("possible"))
    out["possible"] = out["count"] - out["confirmed"]
    return out


def parse_table(text: str) -> list[dict]:
    rows = []
    for line in text.splitlines():
        if not line.startswith("|"):
            continue
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        if len(cells) < 4:
            continue
        if cells[0].lower() == "chip" or set(cells[0]) <= {"-", ":"}:
            continue
        rows.append(
            {
                "chip": cells[0],
                "partner": cells[1],
                "song": cells[2],
                "line": cells[3],
            }
        )
    return rows[-40:]


class Board:
    def __init__(self) -> None:
        self.gen = 0
        self.payload: dict = {}
        self.baseline: set[str] | None = None
        self.landed: dict[str, float] = {}
        self.note_cache_key = None
        self.notes: list[dict] = []
        self.index: dict[str, list[int]] = {}
        self.chat_key = None
        self.chat_info: dict = {"sentence": "", "age": None, "batch": []}
        self.takeover_info: dict = takeover_snapshot()
        self.swift_key = None

    def refresh(self) -> dict:
        progress = load_artist_progress()
        self.takeover_info = takeover_snapshot()
        note_key = tuple(
            (path.name, path.stat().st_mtime if path.exists() else 0)
            for path in CLICK_LOGS.values()
        )
        if note_key != self.note_cache_key:
            self.notes = load_notes(list(CLICK_LOGS.values()))
            self.index = build_index(self.notes)
            self.note_cache_key = note_key
            self.swift_key = None

        chat_key = HARNESS_CHAT.stat().st_mtime if HARNESS_CHAT.exists() else 0
        if chat_key != self.chat_key:
            self.chat_info = harness_snapshot()
            self.chat_key = chat_key
            self.swift_key = None

        swift_key = tuple(
            path.stat().st_mtime if path.exists() else 0
            for path in (SECTIONS, STORE, BRIEFS, CATALOG)
        )
        if swift_key == self.swift_key and self.payload:
            self.payload["harness"]["age"] = self.chat_info.get("age")
            self.payload["progress"] = progress
            self.payload["takeover"] = self.takeover_info
            self.payload["live"] = self._live()
            return self.payload

        try:
            sections = parse_sections(SECTIONS.read_text(encoding="utf-8", errors="replace"))
            store_words = parse_store(STORE.read_text(encoding="utf-8", errors="replace"))
            briefs = parse_pairs(collection_body(BRIEFS.read_text(encoding="utf-8", errors="replace"), "private static let wordplay"))
            partners = parse_pairs(
                collection_body(CATALOG.read_text(encoding="utf-8", errors="replace"), "private static let mentionPartnerTable")
            )
        except (OSError, ValueError) as exc:
            if self.payload:
                self.payload["parse_error"] = str(exc)
                self.payload["live"] = self._live()
                return self.payload
            raise

        store_set = {normalize(w) for w in store_words}
        section_order: list[tuple[str, str]] = []
        seen = set()
        for title, words in sections:
            for word in words:
                key = normalize(word)
                if key in seen:
                    continue
                seen.add(key)
                section_order.append((title, word))
        for word in store_words:
            key = normalize(word)
            if key in seen:
                continue
            seen.add(key)
            section_order.append(("In the store only", word))

        if self.baseline is None:
            self.baseline = set(seen)

        now = time.time()
        chips = []
        counts = {
            "Both on the line": 0,
            "Partner filed": 0,
            "Other half missing": 0,
            "Needs a look": 0,
        }
        for title, word in section_order:
            key = normalize(word)
            brief = (briefs.get(key) or [""])[0]
            partner = partners.get(key) or []
            note = best_note(key, brief, partner, self.notes, self.index)
            kind = classify(word, brief, note)
            labels = check_labels(key, brief, partner, note, key in store_set, title != "In the store only")
            needs = any(label in NEEDS for label in labels)
            if not partner:
                pair = "missing"
                counts["Other half missing"] += 1
            elif both_halves_on_line(partner, note):
                pair = "both"
                counts["Both on the line"] += 1
            else:
                pair = "filed"
                counts["Partner filed"] += 1
            if needs:
                counts["Needs a look"] += 1
            if key not in self.baseline and key not in self.landed:
                self.landed[key] = now
            chips.append(
                {
                    "chip": word,
                    "key": key,
                    "section": title,
                    "kind": kind,
                    "pair": pair,
                    "flip": hidden_flip(brief),
                    "labels": labels,
                    "needs": needs,
                    "brief": brief,
                    "partner": ", ".join(partner),
                    "new": key in self.landed,
                    "landed": self.landed.get(key, 0),
                    "note": None
                    if note is None
                    else {
                        "artist": note["artist"],
                        "song": note["song"],
                        "line": note["line"],
                        "meaning": note["meaning"][:900],
                        "votes": note["votes"],
                        "state": note["state"],
                        "strength": note["strength"],
                        "url": note["url"],
                    },
                }
            )

        batch = []
        by_key = {chip["key"]: chip for chip in chips}
        for row in self.chat_info.get("batch") or []:
            key = normalize(row["chip"])
            filed = by_key.get(key)
            batch.append({**row, "in_bank": filed is not None, "kind": filed["kind"] if filed else "", "needs": bool(filed and filed["needs"])})

        swift_age = now - max(swift_key)
        self.gen += 1
        self.payload = {
            "gen": self.gen,
            "chips": chips,
            "counts": counts,
            "total": len(chips),
            "store": len(store_set),
            "section": sum(len(words) for _, words in sections),
            "notes": len(self.notes),
            "just_landed": sum(1 for chip in chips if chip["new"]),
            "batch": batch,
            "progress": progress,
            "takeover": self.takeover_info,
            "harness": {
                "name": "Penwork Play on Words Genius Harness",
                "sentence": self.chat_info.get("sentence") or "",
                "age": self.chat_info.get("age"),
                "swift_age": swift_age,
            },
            "live": self._live(swift_age),
            "parse_error": "",
        }
        self.swift_key = swift_key
        return self.payload

    def _live(self, swift_age: float | None = None) -> bool:
        ages = []
        if swift_age is not None:
            ages.append(swift_age)
        elif self.payload.get("harness", {}).get("swift_age") is not None:
            ages.append(self.payload["harness"]["swift_age"])
        chat_age = self.chat_info.get("age")
        if chat_age is not None:
            ages.append(chat_age)
        return any(age < 120 for age in ages)


BOARD = Board()

PAGE = r"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Word flips</title>
<style>
  :root {
