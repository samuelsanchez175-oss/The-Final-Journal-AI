  .hl-meta { color: var(--text-muted); font-size: 13px; margin-top: 4px; display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: baseline; }
  .hl-meta a { color: var(--su); }
  .hl-rank { font: 11px/1 "DM Mono", "JetBrains Mono", Menlo, monospace; letter-spacing: .12em; color: var(--amber); }
  .hl-why { color: var(--text-muted); font-size: 13px; margin-top: 4px; font-style: italic; }
  #hl-wrap details { margin-top: 14px; }
  #hl-wrap summary { cursor: pointer; color: var(--text-muted); font: 12px/1.4 "DM Mono", "JetBrains Mono", Menlo, monospace; letter-spacing: .12em; text-transform: uppercase; margin-bottom: 10px; }
</style>
</head>
<body>
<header>
  <div class="topbar">
    <div class="brand">
      <div class="eyebrow">PENWORK / RAP CATALOG</div>
      <h1><span class="dot" id="dot"></span>WORD_FLIPS</h1>
      <p class="status" id="status">Reading the pairs…</p>
    </div>
    <div class="terminal-feed">
      <div class="eyebrow">CURRENT WORK BY TERMINAL / AI</div>
      <div class="focus-grid" id="focus-lanes"></div>
    </div>
  </div>
  <div class="telemetry" id="telemetry"></div>
  <div class="controls">
    <div class="row" id="filters"></div>
    <div class="row">
      <input id="q" type="search" placeholder="SEARCH EITHER HALF, FLIP, OR LINE" aria-label="Search the pairs">
    </div>
  </div>
</header>
<main>
  <section>
    <h2>Project watcher</h2>
    <table>
      <thead><tr><th>Artist</th><th>Resolved</th><th>Saved notes</th><th>Second sense</th><th>Last touch</th><th>State</th></tr></thead>
      <tbody id="progress"></tbody>
    </table>
  </section>
  <section id="hl-wrap">
    <h2>Wordplay highlights</h2>
    <p class="hl-sub" id="hl-status">Loading wordplay highlights…</p>
    <div class="hl-legend"><span><span class="su">blue</span> = setup</span><span><span class="pl">yellow</span> = words he plays on</span><span><span class="hd">green</span> = what it becomes</span></div>
    <div class="row" id="hl-tabs"></div>
    <div class="hl-list" id="hl-confirmed"></div>
    <details id="hl-possible-wrap" hidden>
      <summary id="hl-possible-title">Possible, note doesn't confirm</summary>
      <div class="hl-list" id="hl-possible"></div>
    </details>
  </section>
  <section id="batch-wrap" hidden>
    <h2>Last pairs the other terminal reported</h2>
    <table>
      <thead><tr><th>Heard</th><th>On the same line</th><th>Song</th><th>Line</th><th>In the bank</th></tr></thead>
      <tbody id="batch"></tbody>
    </table>
  </section>
  <h2 id="list-title">Pairs</h2>
  <table>
    <thead>
      <tr><th>Heard</th><th>On the same line</th><th>What appears</th><th>The bar</th></tr>
    </thead>
    <tbody id="list"></tbody>
  </table>
  <p class="empty" id="empty" hidden>Nothing matches this filter.</p>
</main>
<script>
const filters = ["All", "Both on the line", "Partner filed", "Other half missing", "Needs a look"];
let current = "All";
let data = null;
let gen = 0;
const scoreMemory = new Map();

const filterRow = document.getElementById("filters");
filters.forEach(name => {
  const b = document.createElement("button");
  b.textContent = name;
  b.dataset.filter = name;
  if (name === "All") b.className = "on";
  b.addEventListener("click", () => {
    current = name;
    [...filterRow.querySelectorAll("button")].forEach(x => x.classList.toggle("on", x.dataset.filter === name));
    paint();
  });
  filterRow.appendChild(b);
});
document.getElementById("q").addEventListener("input", paint);

function age(seconds) {
  if (seconds == null) return "unknown";
  if (seconds < 90) return "just now";
  const m = Math.round(seconds / 60);
  if (m < 60) return m + " min ago";
  return Math.round(m / 60) + " hr ago";
}

function pad(value, width) {
  return String(Math.max(0, Number(value) || 0)).padStart(width, "0");
}

function animateScore(node, key, target, width, unit) {
  const previous = scoreMemory.has(key) ? scoreMemory.get(key) : 0;
  const start = Math.min(previous, target);
  const delta = Math.max(0, target - start);
  const duration = delta ? 900 + Math.min(700, delta * 9) : 450;
  const startTime = performance.now();
  scoreMemory.set(key, target);
  node.parentElement.classList.toggle("scoring", delta > 0);
  function tick(now) {
    const t = Math.min(1, (now - startTime) / duration);
    const eased = 1 - Math.pow(1 - t, 3);
    const value = Math.round(start + (target - start) * eased);
    node.firstChild.nodeValue = pad(value, width);
    if (t < 1) {
      requestAnimationFrame(tick);
    } else {
      node.firstChild.nodeValue = pad(target, width);
      setTimeout(() => node.parentElement.classList.remove("scoring"), 280);
    }
  }
  if (!node.firstChild) node.appendChild(document.createTextNode(""));
  node.firstChild.nodeValue = pad(start, width);
  requestAnimationFrame(tick);
}

function readout(label, value, unit, caption, key, width=2) {
  const cell = document.createElement("div");
  cell.className = "readout";
  const eyebrow = document.createElement("div");
  eyebrow.className = "eyebrow";
  eyebrow.textContent = label;
  const val = document.createElement("div");
  val.className = "value";
  val.appendChild(document.createTextNode(""));
  if (unit) {
    const span = document.createElement("span");
    span.className = "unit";
    span.textContent = unit;
    val.appendChild(span);
  }
  const cap = document.createElement("div");
  cap.className = "caption";
  cap.textContent = caption || "";
  cell.append(eyebrow, val, cap);
  requestAnimationFrame(() => animateScore(val, key || label, Number(value) || 0, width, unit));
  return cell;
}

function lane(title, state, body, pct, active=false) {
  const cell = document.createElement("div");
  cell.className = active ? "lane active-work" : "lane";
  const head = document.createElement("div");
  head.className = "lane-head";
  const name = document.createElement("div");
  name.className = "lane-title";
  name.textContent = title;
  const status = document.createElement("div");
  status.className = "lane-state";
  status.textContent = state;
  head.append(name, status);
  const meta = document.createElement("div");
  meta.className = "meta";
  meta.textContent = body;
  const bar = document.createElement("div");
  bar.className = "bar";
  const fill = document.createElement("span");
  const clampedPct = Math.max(0, Math.min(100, pct || 0));
  fill.style.width = "0%";
  requestAnimationFrame(() => { fill.style.width = clampedPct + "%"; });
  bar.appendChild(fill);
  const points = document.createElement("div");
  points.className = "points";
  points.textContent = String(Math.round(clampedPct)).padStart(3, "0") + " pts";
  cell.append(head, meta, points, bar);
  return cell;
}

function paint() {
  if (!data) return;
  const q = document.getElementById("q").value.trim().toLowerCase();
  const counts = data.counts || {};
  [...filterRow.querySelectorAll("button")].forEach(b => {
    const name = b.dataset.filter;
    const n = name === "All" ? data.total : (name === "Needs a look" ? counts["Needs a look"] : counts[name] || 0);
    b.textContent = name + " " + n;
  });
  const h = data.harness || {};
  const takeover = data.takeover || {};
  document.getElementById("dot").className = data.live ? "dot on" : "dot";
  document.getElementById("status").textContent =
    (data.live ? "The other terminal is writing. " : "The other terminal is quiet. ") +
    data.total + " pairs. " +
    (counts["Both on the line"] || 0) + " show both halves on a bar. " +
    (counts["Other half missing"] || 0) + " still have no partner. " +
    "Swift " + age(h.swift_age) + ". " +
    (h.sentence || "");

  const progress = data.progress || [];
  const openArtists = progress.filter(row => row.status !== "done");
  const avg = progress.length ? Math.round(progress.reduce((sum, row) => sum + (row.pct || 0), 0) / progress.length) : 0;
  const telemetry = document.getElementById("telemetry");
  telemetry.replaceChildren(
    readout("PAIRS FILED", data.total, "", (counts["Both on the line"] || 0) + " confirmed bars", "pairs", 4),
    readout("NOTE INDEX", data.notes, "", "Genius community notes loaded", "notes", 5),
    readout("OPEN LANES", openArtists.length, "", progress.length + " artist logs watched", "open-lanes", 2),
    readout("CATALOG AVG", avg, "%", "Resolved-song progress", "catalog-avg", 3)
  );

  const focus = document.getElementById("focus-lanes");
  const priority = {"Drake": 0, "Veeze": 1};
  const activeArtists = [...openArtists].sort((a, b) => (priority[a.artist] ?? 10) - (priority[b.artist] ?? 10) || b.unopened_songs - a.unopened_songs);
  const takeoverPct = takeover.total ? Math.round(((takeover.done || 0) / takeover.total) * 100) : 0;
  const subagentLanes = (takeover.subagents || []).slice(0, 3).map(agent =>
    lane((agent.name || "SUBAGENT").toUpperCase(), (agent.state || "active").toUpperCase(), (agent.lane || "Working") + " · " + (agent.detail || ""), agent.pct || 45, (agent.state || "active") === "active")
  );
  const lanes = [
    lane((takeover.agent || "CODEX TAKEOVER").toUpperCase(), (takeover.state || "standby").toUpperCase(), (takeover.lane || "No active lane") + " · " + (takeover.detail || ""), takeoverPct, takeover.state === "active"),
    ...subagentLanes,
    lane("CODEX WATCHER", data.live ? "LIVE" : "STANDBY", "This page is reading Swift, note logs, and chip state every tick.", data.live ? 100 : 30),
    lane("GROK HARNESS", h.age == null ? "NO SIGNAL" : age(h.age).toUpperCase(), h.sentence || "No terminal status line has been posted.", h.age != null && h.age < 120 ? 100 : 35),
    ...activeArtists.slice(0, 3).map(row => lane(row.artist + " LOG", row.status.toUpperCase(), row.opened + " of " + row.songs + " songs resolved · " + row.unopened_songs + " missing · last: " + (row.last_song || "none"), row.pct, row.status !== "done"))
  ];
  focus.replaceChildren(...lanes);

  const batch = data.batch || [];
  document.getElementById("batch-wrap").hidden = batch.length === 0;
  const batchBody = document.getElementById("batch");
  batchBody.replaceChildren();
  batch.forEach(row => {
    const tr = document.createElement("tr");
    [row.chip, row.partner, row.song, row.line, row.in_bank ? "Filed" : "Not in the bank yet"].forEach((text, i) => {
      const td = document.createElement("td");
      td.textContent = text;
      if (i === 4) td.className = row.in_bank ? "ok" : "bad";
      tr.appendChild(td);
    });
    batchBody.appendChild(tr);
  });

  const progressBody = document.getElementById("progress");
  progressBody.replaceChildren();
  (data.progress || []).forEach(row => {
    const tr = document.createElement("tr");
    tr.className = "watcher";
    const artist = document.createElement("td");
    artist.innerHTML = "";
    const strong = document.createElement("div");
    strong.className = "chip";
    strong.textContent = row.artist;
    const file = document.createElement("div");
    file.className = "meta";
    file.textContent = row.path;
    artist.append(strong, file);
    tr.appendChild(artist);

    const opened = document.createElement("td");
    opened.textContent = row.opened + " / " + row.songs + " resolved · " + row.pct + "%";
    const bar = document.createElement("div");
    bar.className = "bar";
    const fill = document.createElement("span");
    fill.style.width = Math.max(0, Math.min(100, row.pct || 0)) + "%";
    bar.appendChild(fill);
    opened.appendChild(bar);
    tr.appendChild(opened);

    addCell(tr, String(row.saved_notes || 0), "");
    addCell(tr, String(row.second_sense || 0), "");
    const last = document.createElement("td");
    last.textContent = row.last_song || "No log yet";
    const line = document.createElement("div");
    line.className = "meta";
    line.textContent = row.last_line || "";
    last.appendChild(line);
    tr.appendChild(last);
    const state = document.createElement("td");
    const stale = row.age == null ? "unknown" : age(row.age);
    state.textContent = row.status === "done" ? "Done · " + stale : "Open · " + stale;
    state.className = row.status === "done" ? "ok" : "bad";
    if (row.invalid) {
      const invalid = document.createElement("div");
      invalid.className = "meta";
      invalid.textContent = row.invalid + " partial line" + (row.invalid === 1 ? "" : "s") + " ignored";
      state.appendChild(invalid);
    }
    tr.appendChild(state);
    progressBody.appendChild(tr);
  });

  const list = document.getElementById("list");
  list.replaceChildren();
  const pairName = { both: "Both on the line", filed: "Partner filed", missing: "Other half missing" };
  const rows = data.chips.filter(chip => {
    if (current === "Needs a look" && !chip.needs) return false;
    if (current !== "All" && current !== "Needs a look" && pairName[chip.pair] !== current) return false;
    if (!q) return true;
    const blob = [chip.chip, chip.partner, chip.flip, chip.brief, ...(chip.labels || []),
      chip.note ? chip.note.song : "", chip.note ? chip.note.line : "", chip.note ? chip.note.meaning : ""
    ].join(" ").toLowerCase();
    return blob.includes(q);
  });
  rows.sort((a, b) => Number(b.new) - Number(a.new) || Number(a.pair === "missing") - Number(b.pair === "missing") || a.chip.localeCompare(b.chip));
  document.getElementById("list-title").textContent = current === "All" ? "Heard, then the other half, then the flip" : current;
  document.getElementById("empty").hidden = rows.length !== 0;
  rows.forEach(chip => {
    const tr = document.createElement("tr");
    if (chip.new) tr.className = "new";
    const good = new Set(["Clean", "Note names the second sense", "Bar names the second sense", "Name half of a pair"]);
    const labels = (chip.labels || []).filter(x => x !== "Clean" && !good.has(x));
    addCell(tr, chip.chip, "chip");
    const partnerCell = document.createElement("td");
    partnerCell.textContent = chip.partner || "No partner yet";
    partnerCell.className = chip.pair === "missing" ? "bad" : "kind";
    tr.appendChild(partnerCell);
    addCell(tr, chip.flip || "—", "chip");
    const td = document.createElement("td");
    const song = chip.note ? (chip.note.artist + " · " + chip.note.song) : "No bar joined yet";
    const s = document.createElement("div");
    s.textContent = song;
    const l = document.createElement("div");
    l.className = "meta";
    l.textContent = chip.note ? chip.note.line : "";
    const flag = document.createElement("div");
    flag.className = chip.pair === "both" ? "ok" : (chip.pair === "missing" ? "bad" : "meta");
    const pairLabel = chip.pair === "both" ? "Both words are on this bar" : (chip.pair === "missing" ? "The other half is not filed" : "Partner is filed");
    flag.textContent = [pairLabel, ...labels].join(" · ");
    td.append(s, l, flag);
    tr.appendChild(td);
    tr.addEventListener("click", () => tr.classList.toggle("open"));
    const detail = document.createElement("tr");
    detail.className = "detail";
    const cell = document.createElement("td");
    cell.colSpan = 4;
    const brief = document.createElement("div");
    brief.textContent = chip.brief ? ("Sentence: " + chip.brief) : "No sentence filed for this chip.";
    cell.appendChild(brief);
    if (chip.note) {
      const note = document.createElement("div");
      note.textContent = "Genius (" + chip.note.votes + " votes, " + (chip.note.strength || chip.note.state || "unrated") + "): " + chip.note.meaning;
      cell.appendChild(note);
      if (chip.note.url) {
        const a = document.createElement("a");
        a.href = chip.note.url;
        a.target = "_blank";
        a.rel = "noopener";
        a.textContent = "Open the Genius note";
        cell.appendChild(document.createElement("div")).appendChild(a);
      }
    }
    detail.appendChild(cell);
    list.append(tr, detail);
  });
}

function addCell(tr, text, cls) {
  const td = document.createElement("td");
  td.textContent = text;
  if (cls) td.className = cls;
  tr.appendChild(td);
}

async function tick() {
  try {
    const res = await fetch("/api/state?gen=" + gen, { cache: "no-store" });
    const body = await res.json();
    if (!body.unchanged) {
      gen = body.gen;
      data = body;
      paint();
    } else if (data) {
      data.live = body.live;
      document.getElementById("dot").className = body.live ? "dot on" : "dot";
    }
  } catch (err) {
    document.getElementById("status").textContent = "The board lost the local page. Refresh.";
    document.getElementById("dot").className = "dot";
  }
}
tick();
setInterval(tick, 2000);

// --- wordplay highlights (additive; separate endpoint, read live from jsonl) ---
let hlData = null;
let hlMtime = null;
let hlArtist = "All";
function hlBar(bar, setupSpans, playSpans) {
  const frag = document.createDocumentFragment();
  const spans = [];
  (setupSpans || []).forEach(s => spans.push({start: s.start, end: s.end, cls: "su", heard: null}));
  (playSpans || []).forEach(s => spans.push({start: s.start, end: s.end, cls: "pl", heard: s.heard}));
  spans.sort((a, b) => a.start - b.start || b.end - a.end);
  let pos = 0;
  spans.forEach(sp => {
    if (sp.start == null || sp.end == null || sp.start < pos || sp.end > bar.length) return;
    if (sp.start > pos) frag.appendChild(document.createTextNode(bar.slice(pos, sp.start)));
    const el = document.createElement("span");
    el.className = sp.cls;
    el.textContent = bar.slice(sp.start, sp.end);
    el.title = sp.cls === "su" ? "setup" : ("play" + (sp.heard ? " → " + sp.heard : ""));
    frag.appendChild(el);
    pos = sp.end;
  });
  if (pos < bar.length) frag.appendChild(document.createTextNode(bar.slice(pos)));
  return frag;
}
function hlRow(row, possible) {
  const card = document.createElement("div");
  card.className = possible ? "hl-row possible" : "hl-row";
  const b = document.createElement("div");
  b.className = "hl-bar";
  b.appendChild(hlBar(row.bar || "", row.setup_spans, row.play_spans));
  const heard = document.createElement("div");
  heard.className = "hl-heard";
  heard.append("Heard as: ");
  const hb = document.createElement("b");
  hb.textContent = row.heard_as || "—";
  heard.appendChild(hb);
  const meta = document.createElement("div");
  meta.className = "hl-meta";
  if (row.rank != null) {
    const r = document.createElement("span");
    r.className = "hl-rank";
    r.textContent = (row.list === "ranked" ? "#" + row.rank : (possible ? "POSSIBLE" : "HM"));
    meta.appendChild(r);
  }
  const who = document.createElement("span");
  who.textContent = (row.artist || "") + " · " + (row.song || "");
  meta.appendChild(who);
  if (!(row.setup_spans || []).length) {
    const ns = document.createElement("span");
    ns.textContent = "no setup word";
    meta.appendChild(ns);
  }
  if (row.votes != null) {
    const v = document.createElement("span");
    v.textContent = row.votes + " votes";
    meta.appendChild(v);
  }
  if (row.url) {
    const a = document.createElement("a");
    a.href = row.url;
    a.target = "_blank";
    a.rel = "noopener";
    a.textContent = "Genius annotation";
    meta.appendChild(a);
  }
  card.append(b, heard, meta);
  if (possible && row.why_unconfirmed) {
    const w = document.createElement("div");
    w.className = "hl-why";
    w.textContent = "Why unconfirmed: " + row.why_unconfirmed;
    card.appendChild(w);
  }
  return card;
}
function hlPaint() {
  if (!hlData) return;
  const rows = hlData.rows || [];
  const isPossible = r => String(r.list || "").startsWith("possible");
  const artists = [];
  rows.forEach(r => { if (r.artist && !artists.includes(r.artist)) artists.push(r.artist); });
  if (hlArtist !== "All" && !artists.includes(hlArtist)) hlArtist = "All";
  const tabs = document.getElementById("hl-tabs");
  tabs.replaceChildren();
  ["All", ...artists].forEach(name => {
    const n = name === "All" ? rows.length : rows.filter(r => r.artist === name).length;
    const btn = document.createElement("button");
    btn.textContent = name + " " + n;
    if (name === hlArtist) btn.className = "on";
    btn.addEventListener("click", () => { hlArtist = name; hlPaint(); });
    tabs.appendChild(btn);
  });
  const order = {"ranked": 0, "honorable mention": 1};
  const pick = rows.filter(r => hlArtist === "All" || r.artist === hlArtist);
  const sorter = (a, b) => artists.indexOf(a.artist) - artists.indexOf(b.artist) ||
    (order[a.list] ?? 2) - (order[b.list] ?? 2) || (a.rank ?? 9999) - (b.rank ?? 9999);
  const confirmed = pick.filter(r => !isPossible(r)).sort(sorter);
  const possible = pick.filter(isPossible).sort(sorter);
  const box = document.getElementById("hl-confirmed");
  box.replaceChildren();
  let lastArtist = null;
  confirmed.forEach(r => {
    if (hlArtist === "All" && r.artist !== lastArtist) {
      const h = document.createElement("div");
      h.className = "eyebrow";
      h.style.margin = "10px 0 0";
      h.textContent = r.artist + " · " + confirmed.filter(x => x.artist === r.artist).length + " confirmed";
      box.appendChild(h);
      lastArtist = r.artist;
    }
    box.appendChild(hlRow(r, false));
  });
  const pbox = document.getElementById("hl-possible");
  pbox.replaceChildren(...possible.map(r => hlRow(r, true)));
  document.getElementById("hl-possible-wrap").hidden = possible.length === 0;
  document.getElementById("hl-possible-title").textContent = "Possible, note doesn't confirm (" + possible.length + ")";
  document.getElementById("hl-status").textContent = hlData.ok
    ? (rows.length + " bars · " + (hlData.confirmed || 0) + " confirmed · " + (hlData.possible || 0) + " possible (collapsed). Live from docs/play-on-words/wordplay-highlights.jsonl.")
    : ("Highlights file unavailable: " + (hlData.error || "unknown error"));
}
async function hlTick() {
  try {
    const res = await fetch("/api/highlights", { cache: "no-store" });
    const body = await res.json();
    if (hlData === null || body.mtime !== hlMtime || body.ok !== hlData.ok) {
      hlMtime = body.mtime;
      hlData = body;
      hlPaint();
    }
  } catch (err) {
    document.getElementById("hl-status").textContent = "Could not reach /api/highlights.";
  }
}
hlTick();
setInterval(hlTick, 5000);
</script>
</body>
</html>
"""


class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt: str, *args) -> None:
        return

    def do_GET(self) -> None:  # noqa: N802
        parsed = urlparse(self.path)
        if parsed.path in ("/", "/index.html"):
            body = PAGE.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)
            return
        if parsed.path == "/api/health":
            payload = {"ok": True}
            raw = json.dumps(payload).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(raw)))
            self.end_headers()
            self.wfile.write(raw)
            return
        if parsed.path == "/api/state":
            state = BOARD.refresh()
            query = parse_qs(parsed.query)
            client_gen = query.get("gen", ["0"])[0]
            if client_gen.isdigit() and int(client_gen) == state["gen"] and state["gen"] != 0:
                raw = json.dumps({"unchanged": True, "gen": state["gen"], "live": state["live"]}).encode("utf-8")
            else:
                raw = json.dumps({"unchanged": False, **state}).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Content-Length", str(len(raw)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(raw)
            return
        if parsed.path == "/api/highlights":
            raw = json.dumps(load_highlights()).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Content-Length", str(len(raw)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(raw)
            return
        self.send_response(404)
        self.end_headers()


def main() -> None:
    server = ThreadingHTTPServer(("127.0.0.1", BOARD_PORT), Handler)
    print(f"PLAY_ON_WORDS_BOARD http://127.0.0.1:{BOARD_PORT}", flush=True)
    server.serve_forever()


if __name__ == "__main__":
    main()
