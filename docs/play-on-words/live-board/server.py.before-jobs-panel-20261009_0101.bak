  }
  .bar { display: flex; }
  .roster { margin-top: 16px; border-top: 1px solid var(--line); padding-top: 12px; }
  .roster-list { max-height: 440px; overflow-y: auto; margin-top: 8px; padding-right: 6px; }
  .roster-group { color: var(--text-muted); font: 10px/1.2 "DM Mono", "JetBrains Mono", Menlo, monospace; letter-spacing: .16em; text-transform: uppercase; margin: 12px 0 4px; }
  .roster-row { padding: 6px 0; border-bottom: 1px solid #1d1d20; }
  .roster-row .r-head { display: flex; justify-content: space-between; gap: 8px; align-items: baseline; }
  .roster-row .r-name { font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .roster-row .r-num { color: var(--text-muted); font: 11px/1.2 "DM Mono", "JetBrains Mono", Menlo, monospace; white-space: nowrap; }
  .roster-row .bar { width: 100%; height: 5px; margin-top: 5px; }
  .roster-row .r-lane { color: #5aa9ff; font: 9px/1 "DM Mono", "JetBrains Mono", Menlo, monospace; letter-spacing: .12em; text-transform: uppercase; border: 1px solid rgba(90,169,255,.5); border-radius: 999px; padding: 2px 6px; margin-left: 6px; }
  .roster-row .r-lane:empty { display: none; }
  .roster-row.completed .bar span:first-child { background: #3f7d4f; box-shadow: none; }
  .roster-row .newnote:empty { display: none; }
  .bar span.new-work {
