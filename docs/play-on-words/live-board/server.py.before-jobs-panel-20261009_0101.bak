  .hl-bar .pl { color: #1a1500; background: var(--pl); border-radius: 4px; padding: 0 3px; font-weight: 700; }
  .hl-legend .su { color: #0b1220; background: var(--su); border-radius: 4px; padding: 0 5px; }
  .hl-legend .pl { color: #1a1500; background: var(--pl); border-radius: 4px; padding: 0 5px; font-weight: 700; }
  .hl-heard { margin-top: 6px; }
  .hl-heard b, .hl-legend .hd { color: #06200f; background: var(--hd); border-radius: 4px; padding: 0 5px; font-weight: 700; }
  .hl-meta { color: var(--text-muted); font-size: 13px; margin-top: 4px; display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: baseline; }
  .hl-meta a { color: var(--su); }
  .hl-rank { font: 11px/1 "DM Mono", "JetBrains Mono", Menlo, monospace; letter-spacing: .12em; color: var(--amber); }
  .hl-row.is-new { border-color: rgba(90,169,255,.75); box-shadow: inset 3px 0 0 #5aa9ff; }
  .hl-new { color: #0b1220; background: #5aa9ff; border-radius: 999px; padding: 1px 7px; font: 700 10px/1.4 "DM Mono", "JetBrains Mono", Menlo, monospace; letter-spacing: .12em; }
  .hl-seq { font: 13px/1 "DM Mono", "JetBrains Mono", Menlo, monospace; color: var(--amber); letter-spacing: .06em; }
  .hl-why { color: var(--text-muted); font-size: 13px; margin-top: 4px; font-style: italic; }
  #hl-wrap details { margin-top: 14px; }
  #hl-wrap summary { cursor: pointer; color: var(--text-muted); font: 12px/1.4 "DM Mono", "JetBrains Mono", Menlo, monospace; letter-spacing: .12em; text-transform: uppercase; margin-bottom: 10px; }
</style>
</head>
<body>
<header>
  <div class="topbar">
    <div class="brand">
      <div class="eyebrow">PENWORK / RAP CATALOG</div>
      <h1><span class="dot" id="dot"></span>WORD_FLIPS</h1>
      <p class="status" id="status">Reading the pairs…</p>
      <div class="roster">
        <div class="eyebrow" id="roster-title">ARTIST ROSTER · loading catalog…</div>
        <div class="roster-list" id="roster"></div>
      </div>
    </div>
    <div class="terminal-feed">
      <div class="eyebrow">CURRENT WORK BY TERMINAL / AI</div>
      <div class="focus-grid" id="focus-lanes"></div>
    </div>
  </div>
  <div class="telemetry" id="telemetry"></div>
  <div class="controls">
    <div class="row" id="filters"></div>
    <div class="row">
      <input id="q" type="search" placeholder="SEARCH EITHER HALF, FLIP, OR LINE" aria-label="Search the pairs">
    </div>
  </div>
</header>
<main>
  <section>
    <h2>Project watcher</h2>
    <table>
      <thead><tr><th>Artist</th><th>Resolved</th><th>Saved notes</th><th>Second sense</th><th>Last touch</th><th>State</th></tr></thead>
      <tbody id="progress"></tbody>
    </table>
  </section>
  <section id="hl-wrap">
    <h2>Wordplay highlights</h2>
    <p class="hl-sub" id="hl-status">Loading wordplay highlights…</p>
    <div class="hl-legend"><span><span class="su">blue</span> = setup</span><span><span class="pl">yellow</span> = words he plays on</span><span><span class="hd">green</span> = what it becomes</span></div>
    <div class="row" id="hl-tabs"></div>
    <div class="hl-list" id="hl-confirmed"></div>
    <details id="hl-possible-wrap" hidden>
      <summary id="hl-possible-title">Possible, note doesn't confirm</summary>
      <div class="hl-list" id="hl-possible"></div>
    </details>
  </section>
  <section id="batch-wrap" hidden>
    <h2>Last pairs the other terminal reported</h2>
    <table>
      <thead><tr><th>Heard</th><th>On the same line</th><th>Song</th><th>Line</th><th>In the bank</th></tr></thead>
      <tbody id="batch"></tbody>
    </table>
  </section>
  <h2 id="list-title">Pairs</h2>
  <table>
    <thead>
      <tr><th>Heard</th><th>On the same line</th><th>What appears</th><th>The bar</th></tr>
    </thead>
    <tbody id="list"></tbody>
  </table>
  <p class="empty" id="empty" hidden>Nothing matches this filter.</p>
</main>
<script>
const filters = ["All", "Both on the line", "Partner filed", "Other half missing", "Needs a look"];
let current = "All";
let data = null;
let gen = 0;
let listSig = "";
let inFlight = false;
const scoreMemory = new Map();

const filterRow = document.getElementById("filters");
filters.forEach(name => {
  const b = document.createElement("button");
  b.textContent = name;
  b.dataset.filter = name;
  if (name === "All") b.className = "on";
  b.addEventListener("click", () => {
    current = name;
    [...filterRow.querySelectorAll("button")].forEach(x => x.classList.toggle("on", x.dataset.filter === name));
    paint();
  });
  filterRow.appendChild(b);
});
document.getElementById("q").addEventListener("input", () => { listSig = ""; paint(); });

function age(seconds) {
  if (seconds == null) return "unknown";
  if (seconds < 90) return "just now";
  const m = Math.round(seconds / 60);
  if (m < 60) return m + " min ago";
  return Math.round(m / 60) + " hr ago";
}

function pad(value, width) {
  return String(Math.max(0, Number(value) || 0)).padStart(width, "0");
}

// Counters keep their own displayed value. A counter only moves when its target
// changes, and "monotonic" counters (line points) never go down on a transient read.
const counters = new Map();
function setCounter(key, node, target, width, opts={}) {
  target = Math.max(0, Number(target) || 0);
  let c = counters.get(key);
  if (!c) {
    c = { node, shown: target, target, width, timer: null, monotonic: !!opts.monotonic, suffix: opts.suffix || "" };
    counters.set(key, c);
    node.textContent = pad(target, width) + c.suffix;
    return;
  }
  c.node = node;
  if (c.monotonic && target < c.target) return;
  if (target === c.target) return;
  c.target = target;
  if (c.timer) return;
  const host = node.closest(".readout");
  if (host) host.classList.add("scoring");
  const stepOnce = () => {
    if (c.shown === c.target) {
      c.timer = null;
      if (host) setTimeout(() => host.classList.remove("scoring"), 280);
      return;
    }
    c.shown += c.shown < c.target ? 1 : -1;   // always +1 / -1 steps, never a jump
    c.node.textContent = pad(c.shown, c.width) + c.suffix;
    const gap = Math.abs(c.target - c.shown);
    c.timer = setTimeout(stepOnce, gap > 60 ? 12 : gap > 15 ? 40 : 110);
  };
  c.timer = setTimeout(stepOnce, 0);
}

function setText(node, text) { if (node.textContent !== text) node.textContent = text; }
function setClass(node, cls) { if (node.className !== cls) node.className = cls; }
function setWidth(fill, pct) {
  const w = Math.max(0, Math.min(100, Number(pct) || 0)) + "%";
  if (fill.style.width !== w) fill.style.width = w;
}

const readoutNodes = new Map();
function readoutNode(key, label, unit) {
  let r = readoutNodes.get(key);
  if (r) return r;
  const cell = document.createElement("div");
  cell.className = "readout";
  const eyebrow = document.createElement("div");
  eyebrow.className = "eyebrow";
  eyebrow.textContent = label;
  const val = document.createElement("div");
  val.className = "value";
  const num = document.createElement("span");
  val.appendChild(num);
  if (unit) {
    const span = document.createElement("span");
    span.className = "unit";
    span.textContent = unit;
    val.appendChild(span);
  }
  const cap = document.createElement("div");
  cap.className = "caption";
  cell.append(eyebrow, val, cap);
  r = { cell, num, cap };
  readoutNodes.set(key, r);
  return r;
}
function updateReadout(key, label, value, unit, caption, width, opts) {
  const r = readoutNode(key, label, unit);
  setText(r.cap, caption || "");
  setCounter("readout:" + key, r.num, value, width, opts);
  return r.cell;
}

const laneNodes = new Map();
function laneNode(key) {
  let l = laneNodes.get(key);
  if (l) return l;
  const cell = document.createElement("div");
  const head = document.createElement("div");
  head.className = "lane-head";
  const name = document.createElement("div");
  name.className = "lane-title";
  const status = document.createElement("div");
  status.className = "lane-state";
  head.append(name, status);
  const meta = document.createElement("div");
  meta.className = "meta";
  const points = document.createElement("div");
  points.className = "points";
  const bar = document.createElement("div");
  bar.className = "bar";
  const fill = document.createElement("span");
  fill.style.width = "0%";
  const newFill = document.createElement("span");
  newFill.className = "new-work";
  newFill.style.width = "0%";
  bar.append(fill, newFill);
  const newNote = document.createElement("div");
  newNote.className = "newnote";
  cell.append(head, meta, points, bar, newNote);
  l = { cell, name, status, meta, points, fill, newFill, newNote };
  laneNodes.set(key, l);
  return l;
}
// spec: {title, state, body, pct, active, points (line points, artist lanes only)}
function updateLane(key, spec) {
  const l = laneNode(key);
  setClass(l.cell, spec.active ? "lane active-work" : "lane");
  setText(l.name, spec.title);
  setText(l.status, spec.state);
  setText(l.meta, spec.body);
  if (spec.newPct != null) {
    setWidth(l.fill, spec.basePct);
    setWidth(l.newFill, spec.newPct);
  } else {
    setWidth(l.fill, spec.pct);
    setWidth(l.newFill, 0);
  }
  setText(l.newNote, spec.newNote || "");
  if (spec.points != null) {
    setCounter("lane-pts:" + key, l.points, spec.points, 3, { monotonic: true, suffix: " pts" });
  } else {
    setText(l.points, String(Math.round(Math.max(0, Math.min(100, spec.pct || 0)))).padStart(3, "0") + "%");
  }
  return l.cell;
}

// Put `nodes` into `parent` in order, touching only what moved. Existing nodes are
// reused, so CSS animations and width transitions are not restarted.
function syncChildren(parent, nodes) {
  nodes.forEach((node, i) => {
    if (parent.children[i] !== node) parent.insertBefore(node, parent.children[i] || null);
  });
  while (parent.children.length > nodes.length) parent.removeChild(parent.lastElementChild);
}

const progressRows = new Map();
function progressRow(artist) {
  let p = progressRows.get(artist);
  if (p) return p;
  const tr = document.createElement("tr");
  tr.className = "watcher";
  const a = document.createElement("td");
  const strong = document.createElement("div");
  strong.className = "chip";
  const file = document.createElement("div");
  file.className = "meta";
  a.append(strong, file);
  const opened = document.createElement("td");
  const openedText = document.createElement("div");
  const bar = document.createElement("div");
  bar.className = "bar";
  const fill = document.createElement("span");
  fill.style.width = "0%";
  const newFill = document.createElement("span");
  newFill.className = "new-work";
  newFill.style.width = "0%";
  bar.append(fill, newFill);
  const newNote = document.createElement("div");
  newNote.className = "newnote";
  opened.append(openedText, bar, newNote);
  const saved = document.createElement("td");
  const second = document.createElement("td");
  const last = document.createElement("td");
  const lastSong = document.createElement("div");
  const lastLine = document.createElement("div");
  lastLine.className = "meta";
  last.append(lastSong, lastLine);
  const state = document.createElement("td");
  const stateText = document.createElement("div");
  const stateNote = document.createElement("div");
  stateNote.className = "meta";
  state.append(stateText, stateNote);
  tr.append(a, opened, saved, second, last, state);
  p = { tr, strong, file, openedText, fill, newFill, newNote, saved, second, lastSong, lastLine, state, stateText, stateNote };
  progressRows.set(artist, p);
  return p;
}

// Highest line-point count seen per artist this page load (client stays monotonic).
const pointsHigh = new Map();
function artistPoints(row) {
  const prev = pointsHigh.get(row.artist) || 0;
  const next = Math.max(prev, Number(row.points) || 0);
  pointsHigh.set(row.artist, next);
  return next;
}

function newNoteText(row) {
  const w = data.window || {};
  if (!w.start_label) return "";
  const n = row.new_points || 0;
  const songs = row.new_songs || 0;
  return "+" + n + " new line" + (n === 1 ? "" : "s") + (songs ? " · +" + songs + " song" + (songs === 1 ? "" : "s") : "") +
    " since " + w.start_label + ", resets " + w.end_label.replace(" ET", "");
}

const rosterNodes = new Map();
const rosterGroups = new Map();
let rosterSig = "";
let rosterRows = [];
function rosterGroup(state, label) {
  let g = rosterGroups.get(state);
  if (!g) {
    g = document.createElement("div");
    g.className = "roster-group";
    rosterGroups.set(state, g);
  }
  setText(g, label);
  return g;
}
function rosterRow(artist) {
  let r = rosterNodes.get(artist);
  if (r) return r;
  const el = document.createElement("div");
  const head = document.createElement("div");
  head.className = "r-head";
  const nameWrap = document.createElement("div");
  nameWrap.className = "r-name";
  const name = document.createElement("span");
  const lane = document.createElement("span");
  lane.className = "r-lane";
  nameWrap.append(name, lane);
  const num = document.createElement("div");
  num.className = "r-num";
  head.append(nameWrap, num);
  const bar = document.createElement("div");
  bar.className = "bar";
  const fill = document.createElement("span");
  fill.style.width = "0%";
  const newFill = document.createElement("span");
  newFill.className = "new-work";
  newFill.style.width = "0%";
  bar.append(fill, newFill);
  const note = document.createElement("div");
  note.className = "newnote";
  el.append(head, bar, note);
  r = { el, name, lane, num, fill, newFill, note };
  rosterNodes.set(artist, r);
  return r;
}
function paintRoster() {
  const roster = data.roster || {};
  if (roster.rows && roster.sig !== rosterSig) { rosterSig = roster.sig; rosterRows = roster.rows; }
  const c = roster.counts || {};
  if (!roster.ready && !rosterRows.length) {
    setText(document.getElementById("roster-title"), "ARTIST ROSTER · " + (roster.error ? "catalog unavailable: " + roster.error : "loading catalog…"));
    return;
  }
  setText(document.getElementById("roster-title"), "ARTIST ROSTER · " + rosterRows.length + " artists · " + (c.in_progress || 0) + " in progress · " + (c.completed || 0) + " completed");
  const labels = { in_progress: "In progress", not_started: "Not started", completed: "Completed" };
  const nodes = [];
  let lastState = null;
  rosterRows.forEach(row => {
    if (row.state !== lastState) {
      nodes.push(rosterGroup(row.state, labels[row.state] + " · " + (c[row.state] || 0)));
      lastState = row.state;
    }
    const r = rosterRow(row.artist);
    setClass(r.el, "roster-row " + row.state);
    setText(r.name, row.artist);
    setText(r.lane, row.lane || "");
    setText(r.num, row.opened + "/" + row.vault_songs + " · " + (Math.round(row.pct || 0)) + "%");
    setWidth(r.fill, row.base_pct != null ? row.base_pct : row.pct);
    setWidth(r.newFill, row.new_pct || 0);
    setText(r.note, (row.new_points || row.new_songs) ? newNoteText(row) : "");
    nodes.push(r.el);
  });
  syncChildren(document.getElementById("roster"), nodes);
}

function paintTop() {
  if (!data) return;
  const counts = data.counts || {};
  const h = data.harness || {};
  const takeover = data.takeover || {};
  setClass(document.getElementById("dot"), data.live ? "dot on" : "dot");
  setText(document.getElementById("status"),
    (data.live ? "The other terminal is writing. " : "The other terminal is quiet. ") +
    data.total + " pairs. " +
    (counts["Both on the line"] || 0) + " show both halves on a bar. " +
    (counts["Other half missing"] || 0) + " still have no partner. " +
    "Swift " + age(h.swift_age) + ". " +
    (h.sentence || ""));

  const progress = data.progress || [];
  const openArtists = progress.filter(row => row.status !== "done");
  const avg = progress.length ? Math.round(progress.reduce((sum, row) => sum + (row.pct || 0), 0) / progress.length) : 0;
  const totalPoints = progress.reduce((sum, row) => sum + artistPoints(row), 0);
  syncChildren(document.getElementById("telemetry"), [
    updateReadout("pairs", "PAIRS FILED", data.total, "", (counts["Both on the line"] || 0) + " confirmed bars", 4),
    updateReadout("notes", "NOTE INDEX", data.notes, "", "Genius community notes loaded", 5),
    updateReadout("points", "LINE POINTS", totalPoints, "", "+1 per completed line (artist+song+line)", 5, { monotonic: true }),
    updateReadout("open-lanes", "OPEN LANES", openArtists.length, "", progress.length + " artist logs watched", 2),
    updateReadout("catalog-avg", "CATALOG AVG", avg, "%", "Resolved-song progress", 3)
  ]);

  const priority = {"Drake": 0, "Veeze": 1};
  const activeArtists = [...openArtists].sort((a, b) => (priority[a.artist] ?? 10) - (priority[b.artist] ?? 10) || b.unopened_songs - a.unopened_songs || a.artist.localeCompare(b.artist));
  const takeoverPct = takeover.total ? Math.round(((takeover.done || 0) / takeover.total) * 100) : 0;
  const lanes = [
    updateLane("takeover", { title: (takeover.agent || "CODEX TAKEOVER").toUpperCase(), state: (takeover.state || "standby").toUpperCase(), body: (takeover.lane || "No active lane") + " · " + (takeover.detail || ""), pct: takeoverPct, active: takeover.state === "active" }),
    ...(takeover.subagents || []).slice(0, 3).map((agent, i) =>
      updateLane("sub:" + (agent.name || i), { title: (agent.name || "SUBAGENT").toUpperCase(), state: (agent.state || "active").toUpperCase(), body: (agent.lane || "Working") + " · " + (agent.detail || ""), pct: agent.pct || 45, active: (agent.state || "active") === "active" })),
    updateLane("watcher", { title: "CODEX WATCHER", state: data.live ? "LIVE" : "STANDBY", body: "This page is reading Swift, note logs, and chip state every tick.", pct: data.live ? 100 : 30, active: false }),
    updateLane("harness", { title: "GROK HARNESS", state: h.age == null ? "NO SIGNAL" : age(h.age).toUpperCase(), body: h.sentence || "No terminal status line has been posted.", pct: h.age != null && h.age < 120 ? 100 : 35, active: false }),
    ...activeArtists.slice(0, 3).map(row => updateLane("artist:" + row.artist, { title: row.artist + " LOG", state: row.status.toUpperCase(), body: row.opened + " of " + row.songs + " songs resolved · " + row.unopened_songs + " missing · last: " + (row.last_song || "none"), pct: row.pct, basePct: row.base_pct, newPct: row.new_pct, newNote: newNoteText(row), active: row.status !== "done", points: artistPoints(row) }))
  ];
  syncChildren(document.getElementById("focus-lanes"), lanes);

  paintRoster();

  const progressBody = document.getElementById("progress");
  syncChildren(progressBody, progress.map(row => {
    const p = progressRow(row.artist);
    setText(p.strong, row.artist);
    setText(p.file, row.path);
    setText(p.openedText, row.opened + " / " + row.songs + " resolved · " + row.pct + "% · " + artistPoints(row) + " line pts");
    setWidth(p.fill, row.base_pct != null ? row.base_pct : row.pct);
    setWidth(p.newFill, row.new_pct || 0);
    setText(p.newNote, newNoteText(row));
    setText(p.saved, String(row.saved_notes || 0));
    setText(p.second, String(row.second_sense || 0));
    setText(p.lastSong, row.last_song || "No log yet");
    setText(p.lastLine, row.last_line || "");
    const stale = row.age == null ? "unknown" : age(row.age);
    setText(p.stateText, row.status === "done" ? "Done · " + stale : "Open · " + stale);
    setClass(p.state, row.status === "done" ? "ok" : "bad");
    setText(p.stateNote, row.invalid ? row.invalid + " partial line" + (row.invalid === 1 ? "" : "s") + " ignored" : "");
    return p.tr;
  }));
}

function paint() {
  if (!data) return;
  const q = document.getElementById("q").value.trim().toLowerCase();
  const counts = data.counts || {};
  [...filterRow.querySelectorAll("button")].forEach(b => {
    const name = b.dataset.filter;
    const n = name === "All" ? data.total : (name === "Needs a look" ? counts["Needs a look"] : counts[name] || 0);
    b.textContent = name + " " + n;
  });
  paintTop();

  const batch = data.batch || [];
  document.getElementById("batch-wrap").hidden = batch.length === 0;
  const batchBody = document.getElementById("batch");
  batchBody.replaceChildren();
  batch.forEach(row => {
    const tr = document.createElement("tr");
    [row.chip, row.partner, row.song, row.line, row.in_bank ? "Filed" : "Not in the bank yet"].forEach((text, i) => {
      const td = document.createElement("td");
      td.textContent = text;
      if (i === 4) td.className = row.in_bank ? "ok" : "bad";
      tr.appendChild(td);
    });
    batchBody.appendChild(tr);
  });

  if (listSig === data.chips_sig + "|" + current + "|" + q) return;
  listSig = data.chips_sig + "|" + current + "|" + q;
  const list = document.getElementById("list");
  list.replaceChildren();
  const pairName = { both: "Both on the line", filed: "Partner filed", missing: "Other half missing" };
  const rows = data.chips.filter(chip => {
    if (current === "Needs a look" && !chip.needs) return false;
    if (current !== "All" && current !== "Needs a look" && pairName[chip.pair] !== current) return false;
    if (!q) return true;
    const blob = [chip.chip, chip.partner, chip.flip, chip.brief, ...(chip.labels || []),
      chip.note ? chip.note.song : "", chip.note ? chip.note.line : "", chip.note ? chip.note.meaning : ""
    ].join(" ").toLowerCase();
    return blob.includes(q);
  });
  rows.sort((a, b) => Number(b.new) - Number(a.new) || Number(a.pair === "missing") - Number(b.pair === "missing") || a.chip.localeCompare(b.chip));
  document.getElementById("list-title").textContent = current === "All" ? "Heard, then the other half, then the flip" : current;
  document.getElementById("empty").hidden = rows.length !== 0;
  rows.forEach(chip => {
    const tr = document.createElement("tr");
    if (chip.new) tr.className = "new";
    const good = new Set(["Clean", "Note names the second sense", "Bar names the second sense", "Name half of a pair"]);
    const labels = (chip.labels || []).filter(x => x !== "Clean" && !good.has(x));
    addCell(tr, chip.chip, "chip");
    const partnerCell = document.createElement("td");
    partnerCell.textContent = chip.partner || "No partner yet";
    partnerCell.className = chip.pair === "missing" ? "bad" : "kind";
    tr.appendChild(partnerCell);
    addCell(tr, chip.flip || "—", "chip");
    const td = document.createElement("td");
    const song = chip.note ? (chip.note.artist + " · " + chip.note.song) : "No bar joined yet";
    const s = document.createElement("div");
    s.textContent = song;
    const l = document.createElement("div");
    l.className = "meta";
    l.textContent = chip.note ? chip.note.line : "";
    const flag = document.createElement("div");
    flag.className = chip.pair === "both" ? "ok" : (chip.pair === "missing" ? "bad" : "meta");
    const pairLabel = chip.pair === "both" ? "Both words are on this bar" : (chip.pair === "missing" ? "The other half is not filed" : "Partner is filed");
    flag.textContent = [pairLabel, ...labels].join(" · ");
    td.append(s, l, flag);
    tr.appendChild(td);
    tr.addEventListener("click", () => tr.classList.toggle("open"));
    const detail = document.createElement("tr");
    detail.className = "detail";
    const cell = document.createElement("td");
    cell.colSpan = 4;
    const brief = document.createElement("div");
    brief.textContent = chip.brief ? ("Sentence: " + chip.brief) : "No sentence filed for this chip.";
    cell.appendChild(brief);
    if (chip.note) {
      const note = document.createElement("div");
      note.textContent = "Genius (" + chip.note.votes + " votes, " + (chip.note.strength || chip.note.state || "unrated") + "): " + chip.note.meaning;
      cell.appendChild(note);
      if (chip.note.url) {
        const a = document.createElement("a");
        a.href = chip.note.url;
        a.target = "_blank";
        a.rel = "noopener";
        a.textContent = "Open the Genius note";
        cell.appendChild(document.createElement("div")).appendChild(a);
      }
    }
    detail.appendChild(cell);
    list.append(tr, detail);
  });
}

function addCell(tr, text, cls) {
  const td = document.createElement("td");
  td.textContent = text;
  if (cls) td.className = cls;
  tr.appendChild(td);
}

async function tick() {
  if (inFlight) return;              // never let two polls race / land out of order
  inFlight = true;
  try {
    const res = await fetch("/api/state?gen=" + gen + "&rsig=" + encodeURIComponent(rosterSig), { cache: "no-store" });
    const body = await res.json();
    if (!body.unchanged) {
      if (body.gen < gen) return;    // stale payload from an older refresh
      gen = body.gen;
      data = body;
      paint();
    } else if (data) {
      data.live = body.live;
      if (body.progress) data.progress = body.progress;
      if (body.window) data.window = body.window;
      if (body.roster) data.roster = body.roster;
      if (body.takeover) data.takeover = body.takeover;
      if (data.harness) data.harness.age = body.harness_age;
      paintTop();                    // in-place update only
    }
  } catch (err) {
    document.getElementById("status").textContent = "The board lost the local page. Refresh.";
    document.getElementById("dot").className = "dot";
  } finally {
    inFlight = false;
  }
}
tick();
setInterval(tick, 2000);

// --- wordplay highlights (additive; separate endpoint, read live from jsonl) ---
let hlData = null;
let hlMtime = null;
let hlArtist = "All";
function hlBar(bar, setupSpans, playSpans) {
  const frag = document.createDocumentFragment();
  const spans = [];
  (setupSpans || []).forEach(s => spans.push({start: s.start, end: s.end, cls: "su", heard: null}));
  (playSpans || []).forEach(s => spans.push({start: s.start, end: s.end, cls: "pl", heard: s.heard}));
  spans.sort((a, b) => a.start - b.start || b.end - a.end);
  let pos = 0;
  spans.forEach(sp => {
    if (sp.start == null || sp.end == null || sp.start < pos || sp.end > bar.length) return;
    if (sp.start > pos) frag.appendChild(document.createTextNode(bar.slice(pos, sp.start)));
    const el = document.createElement("span");
    el.className = sp.cls;
    el.textContent = bar.slice(sp.start, sp.end);
    el.title = sp.cls === "su" ? "setup" : ("play" + (sp.heard ? " → " + sp.heard : ""));
    frag.appendChild(el);
    pos = sp.end;
  });
  if (pos < bar.length) frag.appendChild(document.createTextNode(bar.slice(pos)));
  return frag;
}
function hlRow(row, possible) {
  const card = document.createElement("div");
  card.className = possible ? "hl-row possible" : (row.is_new ? "hl-row is-new" : "hl-row");
  const b = document.createElement("div");
  b.className = "hl-bar";
  b.appendChild(hlBar(row.bar || "", row.setup_spans, row.play_spans));
  const heard = document.createElement("div");
  heard.className = "hl-heard";
  heard.append("Heard as: ");
  const hb = document.createElement("b");
  hb.textContent = row.heard_as || "—";
  heard.appendChild(hb);
  const meta = document.createElement("div");
  meta.className = "hl-meta";
  if (!possible && row.seq != null) {
    const n = document.createElement("span");
    n.className = "hl-seq";
    n.textContent = "#" + row.seq;
    meta.appendChild(n);
    if (row.is_new) {
      const nb = document.createElement("span");
      nb.className = "hl-new";
      nb.textContent = "NEW";
      meta.appendChild(nb);
    }
  }
  if (row.rank != null || possible || (row.list || "").startsWith("confirmed (")) {
    const r = document.createElement("span");
    r.className = "hl-rank";
    r.textContent = possible ? "POSSIBLE" : (row.list === "ranked" ? "rank " + row.rank : (row.list === "honorable mention" ? "HM" : row.list.slice(11, -1)));
    meta.appendChild(r);
  }
  const who = document.createElement("span");
  who.textContent = (row.artist || "") + " · " + (row.song || "");
  meta.appendChild(who);
  if (!(row.setup_spans || []).length) {
    const ns = document.createElement("span");
    ns.textContent = "no setup word";
    meta.appendChild(ns);
  }
  if (row.votes != null) {
    const v = document.createElement("span");
    v.textContent = row.votes + " votes";
    meta.appendChild(v);
  }
  if (row.url) {
    const a = document.createElement("a");
    a.href = row.url;
    a.target = "_blank";
    a.rel = "noopener";
    a.textContent = "Genius annotation";
    meta.appendChild(a);
  }
  card.append(b, heard, meta);
  if (possible && row.why_unconfirmed) {
    const w = document.createElement("div");
    w.className = "hl-why";
    w.textContent = "Why unconfirmed: " + row.why_unconfirmed;
    card.appendChild(w);
  }
  return card;
}
// Keyed, in-place rendering: each confirmed line's card is built once (keyed by its permanent
// number) and only moved/inserted; a new line is inserted at the top without rebuilding the list.
const hlNodes = new Map();      // "c:<seq>" or "p:<key>" -> {el, sig}
const hlHeads = new Map();
const hlTabNodes = new Map();
function hlCard(row, possible) {
  const id = (possible ? "p:" : "c:") + (possible ? (row.artist + "|" + row.song + "|" + row.bar) : row.seq);
  const sig = JSON.stringify([row.bar, row.setup_spans, row.play_spans, row.heard_as, row.url, row.votes, row.is_new, row.list, row.rank]);
  const hit = hlNodes.get(id);
  if (hit && hit.sig === sig) return hit.el;
  const el = hlRow(row, possible);
  if (hit && hit.el.parentNode) hit.el.parentNode.replaceChild(el, hit.el);
  hlNodes.set(id, { el, sig });
  return el;
}
function hlHead(artist, text) {
  let h = hlHeads.get(artist);
  if (!h) {
    h = document.createElement("div");
    h.className = "eyebrow";
    h.style.margin = "10px 0 0";
    hlHeads.set(artist, h);
  }
  setText(h, text);
  return h;
}
function hlPaint() {
  if (!hlData) return;
  const rows = hlData.rows || [];
  const isPossible = r => String(r.list || "").startsWith("possible");
  const confirmedAll = rows.filter(r => !isPossible(r)).sort((a, b) => b.seq - a.seq);
  // artist order = most recent confirmed line first, so the newest line is at the very top
  const artists = [];
  confirmedAll.forEach(r => { if (r.artist && !artists.includes(r.artist)) artists.push(r.artist); });
  rows.forEach(r => { if (r.artist && !artists.includes(r.artist)) artists.push(r.artist); });
  if (hlArtist !== "All" && !artists.includes(hlArtist)) hlArtist = "All";
  const tabs = document.getElementById("hl-tabs");
  syncChildren(tabs, ["All", ...artists].map(name => {
    let btn = hlTabNodes.get(name);
    if (!btn) {
      btn = document.createElement("button");
      btn.addEventListener("click", () => { hlArtist = name; hlPaint(); });
      hlTabNodes.set(name, btn);
    }
    const n = name === "All" ? rows.length : rows.filter(r => r.artist === name).length;
    setText(btn, name + " " + n);
    setClass(btn, name === hlArtist ? "on" : "");
    return btn;
  }));
  const pick = r => hlArtist === "All" || r.artist === hlArtist;
  const confirmed = confirmedAll.filter(pick);
  const nodes = [];
  if (hlArtist === "All") {
    artists.forEach(a => {
      const mine = confirmed.filter(r => r.artist === a);
      if (!mine.length) return;
      const fresh = mine.filter(r => r.is_new).length;
      nodes.push(hlHead(a, a + " · " + mine.length + " confirmed" + (fresh ? " · " + fresh + " new" : "")));
      mine.forEach(r => nodes.push(hlCard(r, false)));
    });
  } else {
    confirmed.forEach(r => nodes.push(hlCard(r, false)));
  }
  syncChildren(document.getElementById("hl-confirmed"), nodes);
  const possible = rows.filter(r => isPossible(r) && pick(r));
  syncChildren(document.getElementById("hl-possible"), possible.map(r => hlCard(r, true)));
  document.getElementById("hl-possible-wrap").hidden = possible.length === 0;
  setText(document.getElementById("hl-possible-title"), "Possible, note doesn't confirm (" + possible.length + ")");
  setText(document.getElementById("hl-status"), hlData.ok
    ? ((hlData.confirmed || 0) + " confirmed (#1–#" + (hlData.max_seq || 0) + ", newest first" + (hlData.new ? ", " + hlData.new + " new this window" : "") + ") · " + (hlData.possible || 0) + " possible (collapsed). Live from wordplay-highlights.jsonl + verified.jsonl + kept sound-flip candidates.")
    : ("Highlights file unavailable: " + (hlData.error || "unknown error")));
}
let hlInFlight = false;
let hlSig = null;
async function hlTick() {
  if (hlInFlight) return;
  hlInFlight = true;
  try {
    const res = await fetch("/api/highlights", { cache: "no-store" });
    const body = await res.json();
    if (hlData === null || body.sig !== hlSig || body.ok !== hlData.ok) {
      hlSig = body.sig;
      hlMtime = body.mtime;
      hlData = body;
      hlPaint();
    }
  } catch (err) {
    document.getElementById("hl-status").textContent = "Could not reach /api/highlights.";
  } finally {
    hlInFlight = false;
  }
}
hlTick();
setInterval(hlTick, 5000);
</script>
</body>
</html>
"""


class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt: str, *args) -> None:
        return

    def do_GET(self) -> None:  # noqa: N802
        parsed = urlparse(self.path)
        if parsed.path in ("/", "/index.html"):
            body = PAGE.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)
            return
        if parsed.path == "/api/health":
            payload = {"ok": True}
            raw = json.dumps(payload).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(raw)))
            self.end_headers()
            self.wfile.write(raw)
            return
        if parsed.path == "/api/state":
            state = BOARD.refresh()
            query = parse_qs(parsed.query)
            client_gen = query.get("gen", ["0"])[0]
            client_rsig = query.get("rsig", [""])[0]
            roster_out = state.get("roster") or {}
            if client_rsig and client_rsig == roster_out.get("sig"):
                roster_out = {k: v for k, v in roster_out.items() if k != "rows"}
                roster_out["unchanged"] = True
            if client_gen.isdigit() and int(client_gen) == state["gen"] and state["gen"] != 0:
                raw = json.dumps({
                    "unchanged": True,
                    "gen": state["gen"],
                    "live": state["live"],
                    "progress": state.get("progress", []),
                    "window": state.get("window", {}),
                    "roster": roster_out,
                    "takeover": state.get("takeover", {}),
                    "harness_age": (state.get("harness") or {}).get("age"),
                }).encode("utf-8")
            else:
                raw = json.dumps({"unchanged": False, **state, "roster": roster_out}).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Content-Length", str(len(raw)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(raw)
            return
        if parsed.path == "/api/highlights":
            raw = json.dumps(load_highlights()).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Content-Length", str(len(raw)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(raw)
            return
        self.send_response(404)
        self.end_headers()


def main() -> None:
    server = ThreadingHTTPServer(("127.0.0.1", BOARD_PORT), Handler)
    print(f"PLAY_ON_WORDS_BOARD http://127.0.0.1:{BOARD_PORT}", flush=True)
    server.serve_forever()


if __name__ == "__main__":
    main()
