  .newnote { color: #5aa9ff; font: 10px/1.3 "DM Mono", "JetBrains Mono", Menlo, monospace; letter-spacing: .06em; margin-top: 6px; min-height: 13px; }
  .bar span {
    flex: none;
    display: block;
    height: 100%;
    background: var(--amber);
    box-shadow: 0 0 18px var(--amber-glow);
    position: relative;
