STOP = {
    "a", "an", "the", "my", "your", "his", "her", "our", "their", "like",
    "im", "its", "it", "on", "in", "to", "of", "and", "with", "for", "me",
    "you", "that", "this", "was", "were", "from", "just", "got", "get",
}
SEX = re.compile(
    r"\b(sex|sexual|condom|orgasm|nude|naked|ejacul\w*|sperm|intercourse|"
    r"from the rear|rear end|in bed|one night stand)\b",
    re.I,
)
TAG_RE = re.compile(r"<[^>]+>")
VIEW_RE = re.compile(r"\d+(?:\.\d+)?[KMB]\s*$")

SOUNDEX_MAP = str.maketrans(
    {
        **{c: "1" for c in "bfpv"},
        **{c: "2" for c in "cgjkqsxz"},
        **{c: "3" for c in "dt"},
        **{c: "4" for c in "l"},
        **{c: "5" for c in "mn"},
        **{c: "6" for c in "r"},
    }
)


def normalize(word: str) -> str:
    text = unicodedata.normalize("NFKD", word)
    text = "".join(ch for ch in text if not unicodedata.combining(ch))
    text = text.lower().replace("\u2019", "").replace("'", "")
    text = re.sub(r"[^a-z0-9\s]", " ", text)
    return " ".join(text.split())


def content_tokens(text: str) -> list[str]:
    return [t for t in normalize(text).split() if t not in STOP and len(t) > 2]


def soundex(word: str) -> str:
    cleaned = re.sub(r"[^a-z]", "", normalize(word))
    if not cleaned:
        return ""
    coded = cleaned[0] + cleaned[1:].translate(SOUNDEX_MAP)
    squashed = coded[0]
    for ch in coded[1:]:
        if ch != squashed[-1] and ch != "0":
            squashed += ch
    return (squashed + "000")[:4]


def skeleton(word: str) -> str:
    cleaned = re.sub(r"[^a-z]", "", normalize(word))
    return re.sub(r"[aeiouy]", "", cleaned)


def edit_distance(left: str, right: str) -> int:
    if abs(len(left) - len(right)) > 2:
        return 9
    prev = list(range(len(right) + 1))
    for i, ca in enumerate(left, 1):
        cur = [i]
        for j, cb in enumerate(right, 1):
            cur.append(min(prev[j] + 1, cur[-1] + 1, prev[j - 1] + (ca != cb)))
        prev = cur
    return prev[-1]


def sounds_alike(left: str, right: str) -> bool:
    a = [t for t in content_tokens(left) if len(t) > 2]
    b = [t for t in content_tokens(right) if len(t) > 2]
    if not a or not b:
        return False
    for x in a:
        for y in b:
            if x == y:
                continue
            if soundex(x) == soundex(y) and soundex(x):
                return True
            if edit_distance(x, y) <= 2:
                return True
            sx, sy = skeleton(x), skeleton(y)
            if len(sx) >= 3 and len(sy) >= 3 and (sx[:3] == sy[:3] or sx in sy or sy in sx):
                return True
    return False


def swift_strings(block: str) -> list[str]:
    out: list[str] = []
    i = 0
    n = len(block)
    while i < n:
        if block[i] != '"':
            i += 1
            continue
        j = i + 1
        chars: list[str] = []
        closed = False
        while j < n:
            c = block[j]
            if c == "\\":
                if j + 1 < n:
                    chars.append(block[j + 1])
                    j += 2
                    continue
            if c == '"':
                out.append("".join(chars))
                i = j + 1
                closed = True
                break
            chars.append(c)
            j += 1
        if not closed:
            break
    return out


def case_block(text: str, name: str) -> str | None:
    key = f"case .{name}:"
    i = text.find(key)
    if i < 0:
        return None
    rest = text[i + len(key) :]
    m = re.search(r"\n        case \.", rest)
    return rest[: m.start()] if m else rest


def parse_sections(text: str) -> list[tuple[str, list[str]]]:
    block = case_block(text, "wordplay")
    if block is None:
        raise ValueError("wordplay case missing in sections")
    found = []
    for match in re.finditer(
        r'NounChipSection\(title:\s*"((?:\\.|[^"\\])*)",\s*words:\s*\[(.*?)\]\s*\)',
        block,
        re.S,
    ):
        title = match.group(1).replace('\\"', '"')
        words = swift_strings(match.group(2))
        if words:
            found.append((title, words))
    if not found:
        raise ValueError("no wordplay sections")
    return found


def parse_store(text: str) -> list[str]:
    key = "case .wordplay:"
    start = 0
    while True:
        i = text.find(key, start)
        if i < 0:
            raise ValueError("wordplay store list missing")
        rest = text[i + len(key) :]
        match = re.search(r"\n        case \.", rest)
        block = rest[: match.start()] if match else rest
        open_at = block.find("[")
        close_at = block.rfind("]")
        if open_at >= 0 and close_at > open_at:
            words = swift_strings(block[open_at : close_at + 1])
            if words:
                return words
        start = i + len(key)


def collection_body(text: str, marker: str) -> str:
    """Body of a Swift array or dictionary written with square brackets."""
    i = text.find(marker)
    if i < 0:
        raise ValueError(f"missing {marker}")
    match = re.search(r"=\s*\[", text[i:])
    if not match:
        raise ValueError(f"missing collection after {marker}")
    a = i + match.end() - 1
    depth = 0
    in_string = False
    j = a
    while j < len(text):
        char = text[j]
        if in_string:
            if char == "\\":
                j += 2
                continue
            if char == '"':
                in_string = False
            j += 1
            continue
        if char == '"':
            in_string = True
            j += 1
            continue
        if char == "[":
            depth += 1
        elif char == "]":
            depth -= 1
            if depth == 0:
                return text[a + 1 : j]
        j += 1
    raise ValueError(f"unclosed collection after {marker}")


def parse_pairs(body: str) -> dict[str, list[str]]:
    """Swift dictionary of string -> string or string -> [string]."""
    pairs: dict[str, list[str]] = {}
    i = 0
    n = len(body)
    while i < n:
        if body[i] != '"':
            i += 1
            continue
        key, i = read_swift_string(body, i)
        while i < n and body[i] in " \t\r\n":
            i += 1
        if i >= n or body[i] != ":":
            continue
        i += 1
        while i < n and body[i] in " \t\r\n":
            i += 1
        if i < n and body[i] == "[":
            end = body.find("]", i)
            if end < 0:
                break
            pairs[normalize(key)] = swift_strings(body[i : end + 1])
            i = end + 1
        elif i < n and body[i] == '"':
            value, i = read_swift_string(body, i)
            pairs[normalize(key)] = [value]
        else:
            i += 1
    return pairs


def read_swift_string(text: str, i: int) -> tuple[str, int]:
    if text[i] != '"':
        raise ValueError("expected string")
    j = i + 1
    chars: list[str] = []
    while j < len(text):
        c = text[j]
        if c == "\\":
            if j + 1 < len(text):
                chars.append(text[j + 1])
                j += 2
                continue
        if c == '"':
            return "".join(chars), j + 1
        chars.append(c)
        j += 1
    raise ValueError("unclosed string")


def clean_song(song: str, artist: str) -> str:
    text = TAG_RE.sub("", song or "")
    text = text.replace("\u2019", "'")
    if artist and artist in text:
        text = text.replace(artist, " ", 1)
    text = VIEW_RE.sub("", text)
    text = " ".join(text.split())
    return text or "Untitled song"


def load_notes(paths: list[Path]) -> list[dict]:
    notes = []
    for path in paths:
        if not path.exists():
            continue
        with path.open(encoding="utf-8", errors="replace") as handle:
            for line in handle:
                line = line.strip()
                if not line:
                    continue
                try:
                    row = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if row.get("type") not in (None, "line"):
                    continue
                lyric = row.get("line") or ""
                meaning = row.get("meaning") or ""
                artist = row.get("artist") or ""
                notes.append(
                    {
                        "id": str(row.get("annotation_id") or ""),
                        "artist": artist,
                        "song": clean_song(row.get("song") or "", artist),
                        "line": lyric,
                        "line_norm": normalize(lyric),
                        "meaning": meaning,
                        "votes": int(row.get("votes") or 0),
                        "state": row.get("state") or "",
                        "strength": row.get("strength") or "",
                        "url": row.get("url") or "",
                    }
                )
    return notes


_PROGRESS_CACHE: dict = {}


def _progress_file_key(path: Path):
    try:
        st = path.stat()
    except OSError:
        return None
    return (st.st_mtime_ns, st.st_size)


def load_artist_progress() -> list[dict]:
    rows = []
    logs = dict(CLICK_LOGS)
    for path in sorted(NOTES_DIR.glob("*.jsonl")):
        artist = path.stem.replace("-", " ").title()
        artist = {
            "juice wrld": "Juice WRLD",
            "lil uzi vert": "Lil Uzi Vert",
            "nocap": "NoCap",
        }.get(path.stem, artist)
        logs.setdefault(artist, path)
    ordered = sorted(logs.items(), key=lambda item: (ARTIST_ORDER.index(item[0]) if item[0] in ARTIST_ORDER else 999, item[0]))
    for artist, path in ordered:
        rows.append(scan_artist_log(artist, path))
    return rows


def scan_artist_log(artist: str, path: Path) -> dict:
    """Stats for one genius-clicks log. Re-scanned only when the file's mtime/size changes;
    a half-written last line is ignored (partial_tail)."""
    stats = {
        "artist": artist,
        "path": str(path.relative_to(ROOT)),
        "exists": path.exists(),
        "age": None,
        "rows": 0,
        "valid": 0,
        "invalid": 0,
        "songs": set(),
        "opened": set(),
        "done": 0,
        "missing": 0,
        "saved_notes": 0,
        "second_sense": 0,
        "not_new": 0,
        "last_song": "",
        "last_line": "",
    }
    if not path.exists():
        return stats
    stats["age"] = time.time() - path.stat().st_mtime
    file_key = _progress_file_key(path)
    cached = _PROGRESS_CACHE.get(str(path))
    if cached and cached[0] == file_key:
        done_stats = dict(cached[1])
        done_stats["age"] = stats["age"]
        return done_stats
    # One completed line = one point, deduped by artist + song + line.
    point_keys: set = set()
    pending_bad = 0  # a bad line only counts as invalid once a good line follows it
    with path.open(encoding="utf-8", errors="replace") as handle:
        for line in handle:
            line = line.strip()
            if not line:
                continue
            try:
                row = json.loads(line)
            except json.JSONDecodeError:
                pending_bad += 1
                continue
            if pending_bad:
                stats["invalid"] += pending_bad
                stats["rows"] += pending_bad
                pending_bad = 0
            stats["rows"] += 1
            if not isinstance(row, dict):
                stats["invalid"] += 1
                continue
            if (row.get("type") or "line") == "line" and (row.get("line") or "").strip():
                point_keys.add((
                    normalize(row.get("artist") or artist),
                    normalize(clean_song(row.get("song") or "", row.get("artist") or artist)),
                    " ".join((row.get("line") or "").lower().split()),
                ))
            stats["valid"] += 1
            song = clean_song(row.get("song") or "", row.get("artist") or artist)
            if song:
                stats["songs"].add(song)
            if row.get("clicked") or ((row.get("type") or "line") == "song" and (row.get("status") or "").lower() == "done"):
                stats["opened"].add(song)
            kind = row.get("type") or "line"
            status = (row.get("click_status") or "").lower()
            meaning = row.get("meaning") or ""
            if kind == "song":
                if status == "done":
                    stats["done"] += 1
                elif status == "missing":
                    stats["missing"] += 1
            if row.get("second_sense"):
                stats["second_sense"] += 1
            if meaning and meaning != "Opened. Not a new chip.":
                stats["saved_notes"] += 1
            else:
                stats["not_new"] += 1
            stats["last_song"] = song
            stats["last_line"] = row.get("line") or status or kind
    total_songs = len(stats["songs"])
    opened_songs = len(stats["opened"])
    stats["song_total"] = total_songs
    stats["opened_songs"] = opened_songs
    stats["unopened_songs"] = max(total_songs - opened_songs, stats["missing"])
    stats["pct"] = round((opened_songs / total_songs) * 100) if total_songs else 0
    stats["status"] = "open" if stats["unopened_songs"] or stats["invalid"] else "done"
    stats["songs"] = total_songs
    stats["opened"] = opened_songs
    stats["points"] = len(point_keys)
    stats["partial_tail"] = pending_bad  # trailing line still being written; ignored
    _PROGRESS_CACHE[str(path)] = (file_key, dict(stats))
    return stats


def build_index(notes: list[dict]) -> dict[str, list[int]]:
    index: dict[str, list[int]] = {}
    for i, note in enumerate(notes):
        for token in set(note["line_norm"].split()):
            if len(token) < 3 or token in STOP:
                continue
            index.setdefault(token, []).append(i)
    return index


def best_note(chip_norm: str, brief: str, partners: list[str], notes: list[dict], index: dict[str, list[int]]) -> dict | None:
    tokens = content_tokens(chip_norm) or [t for t in chip_norm.split() if len(t) > 2]
    if not tokens:
        return None
    lists = []
    for token in tokens:
        hits = index.get(token)
        if hits:
            lists.append(hits)
    if not lists:
        return None
    lists.sort(key=len)
    chosen = set(lists[0])
    for other in lists[1:]:
        chosen &= set(other)
        if not chosen:
            break
    if not chosen and len(tokens) > 1:
        longest = max(tokens, key=len)
        chosen = set(index.get(longest, []))
    if not chosen:
        return None
    senses = [word for word in second_sense(brief) if len(word) >= 4]
    for partner in partners:
        senses.extend(token for token in content_tokens(partner) if len(token) >= 4)
    if senses:
        preferred = []
        for i in chosen:
            blob = notes[i]["line_norm"] + " " + normalize(notes[i]["meaning"])
            if any(word in blob for word in senses):
                preferred.append(i)
        if preferred:
            chosen = set(preferred)
        elif len(tokens) == 1:
            # A lone name with a claimed second word, and no note mentions that word.
            # Attaching a different bar that only says the name hides the miss.
            return None
    phrase = chip_norm

    def rank(i: int) -> tuple:
        note = notes[i]
        line_norm = note["line_norm"]
        phrase_hit = 1 if phrase and phrase in line_norm else 0
        accepted = 1 if note["strength"] == "accepted" or note["state"] == "accepted" else 0
        return (phrase_hit, accepted, note["votes"])

    winner = max(chosen, key=rank)
    if rank(winner)[0] == 0 and len(tokens) > 1:
        return None
    return notes[winner]


def second_sense(brief: str) -> list[str]:
    if not brief or "in the line" in brief.lower():
        return []
    match = re.match(r"(.+?) is (.+?)(?:\.|$)", brief.strip())
    if not match:
        return []
    return content_tokens(match.group(2))


def echo_note(note: dict) -> bool:
    meaning = normalize(note["meaning"])
    line = note["line_norm"]
    if not meaning or not line:
        return False
    if meaning == line or meaning in line or line in meaning:
        return True
    if SequenceMatcher(None, meaning[:280], line[:280]).ratio() > 0.72:
        extra = set(content_tokens(meaning)) - set(content_tokens(line))
        return len(extra) < 2
    return False


def hidden_flip(brief: str) -> str:
    """The sense that shows up once both halves of the pair are on the line."""
    text = (brief or "").strip()
    if not text:
        return ""
    sound = re.search(r"sounds like\s+(.+?)(?:\.|$)", text, re.I)
    if sound:
        flip = sound.group(1)
    else:
        match = re.match(r".+?\bis\b\s+(.+?)(?:\.|$)", text, re.I)
        if not match:
            return ""
        flip = match.group(1)
        if "in the line" in flip.lower():
            rest = text[match.end() :].strip()
            rest = re.sub(r"^[^.]*\bis\b\s+", "", rest, count=1, flags=re.I)
            return rest.strip(" .")
    flip = re.sub(r",?\s*said beside\b.*$", "", flip, flags=re.I)
    return flip.strip(" .")


def both_halves_on_line(partners: list[str], note: dict | None) -> bool:
    if not partners or note is None:
        return False
    line = note["line_norm"]
    for partner in partners:
        tokens = content_tokens(partner) or [token for token in normalize(partner).split() if len(token) > 2]
        if tokens and all(token in line for token in tokens):
            return True
    return False


def classify(chip: str, brief: str, note: dict | None) -> str:
    text = brief or ""
    lowered = text.lower()
    match = re.match(r"(.+?) is (.+?)(?:\.|$)", text.strip())
    if "sounds like" in lowered or (
        match and "in the line" not in lowered and (sounds_alike(chip, match.group(2)) or sounds_alike(match.group(1), match.group(2)))
    ):
        return "Phonetic"
    # The sentence is the claim. A Genius note can mention sex while explaining a different flip.
    if SEX.search(text) or re.search(r"\b(breasts|skeet|condom)\b", lowered):
        return "Double entendre"
    if text:
        return "Double meaning"
    if note and SEX.search(note["meaning"]):
        return "Double entendre"
    return "Play on words"


def check_labels(chip_norm: str, brief: str, partners: list[str], note: dict | None, in_store: bool, in_section: bool) -> list[str]:
    labels = []
    if in_store != in_section:
        labels.append("Only in one file")
    if not brief:
        labels.append("Missing sentence")
    if not partners:
        labels.append("Missing partner")
    if note is None:
        labels.append("No Genius note joined")
    else:
        if echo_note(note):
            labels.append("Note repeats the line")
        weak = note["votes"] <= 0 or note["state"] == "pending" or note["strength"] == "weak"
        if weak:
            labels.append("Weak note")
        senses = second_sense(brief)
        if senses:
            meaning = normalize(note["meaning"])
            line = note["line_norm"]
            in_note = any(word in meaning.split() or word in meaning for word in senses)
            in_line = any(word in line.split() for word in senses)
            if in_note:
                labels.append("Note names the second sense")
            elif in_line:
                labels.append("Bar names the second sense")
            else:
                labels.append("Sentence is ahead of the note")
        elif brief and "in the line" in brief.lower():
            labels.append("Name half of a pair")
    if not labels:
        labels.append("Clean")
    return labels


NEEDS = {
    "Only in one file",
    "Missing sentence",
    "Missing partner",
    "No Genius note joined",
    "Note repeats the line",
    "Weak note",
    "Sentence is ahead of the note",
}


def harness_snapshot() -> dict:
    sentence = "The other terminal has not posted a status line yet."
    batch: list[dict] = []
    age = None
    if HARNESS_CHAT.exists():
        age = time.time() - HARNESS_CHAT.stat().st_mtime
        texts: list[str] = []
        with HARNESS_CHAT.open(encoding="utf-8", errors="replace") as handle:
            for line in handle:
                try:
                    row = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if row.get("type") == "assistant" and isinstance(row.get("content"), str):
                    text = row["content"].strip()
                    if text:
                        texts.append(text)
        if texts:
            sentence = " ".join(texts[-1].split())
            if len(sentence) > 420:
                sentence = sentence[:417] + "..."
            for text in reversed(texts):
                if "| Chip |" in text or "| chip |" in text.lower():
                    batch = parse_table(text)
                    break
    return {"sentence": sentence, "age": age, "batch": batch}


def takeover_snapshot() -> dict:
    if not TAKEOVER_STATUS.exists():
        return {
            "agent": "Codex takeover",
            "lane": "No active takeover lane",
            "state": "standby",
            "detail": "No local takeover status file is present.",
            "done": 0,
            "total": 0,
            "age": None,
        }
    try:
        payload = json.loads(TAKEOVER_STATUS.read_text(encoding="utf-8", errors="replace"))
    except (OSError, json.JSONDecodeError) as exc:
        return {
            "agent": "Codex takeover",
            "lane": "Status parse error",
            "state": "blocked",
            "detail": str(exc),
            "done": 0,
            "total": 0,
            "age": None,
        }
    payload["age"] = time.time() - TAKEOVER_STATUS.stat().st_mtime
    payload.setdefault("done", 0)
    payload.setdefault("total", 0)
    payload.setdefault("subagents", [])
    return payload


def load_highlights() -> dict:
    """Read docs/play-on-words/wordplay-highlights.jsonl at request time."""
    out = {"ok": True, "path": str(HIGHLIGHTS), "mtime": None, "rows": [], "bad_lines": 0}
    try:
        stat = HIGHLIGHTS.stat()
        out["mtime"] = stat.st_mtime
        with HIGHLIGHTS.open(encoding="utf-8") as fh:
            for raw in fh:
                raw = raw.strip()
                if not raw:
                    continue
                try:
                    row = json.loads(raw)
                except json.JSONDecodeError:
                    out["bad_lines"] += 1
                    continue
                if isinstance(row, dict) and row.get("bar"):
                    out["rows"].append(row)
    except FileNotFoundError:
        out["ok"] = False
        out["error"] = "wordplay-highlights.jsonl not found"
    except OSError as err:
        out["ok"] = False
        out["error"] = str(err)
    # Confirmed lines from all sources, deduped by artist+song+bar, numbered permanently.
    confirmed, seen = [], set()
    extra = []
    try:
        extra = _verified_confirmed() + _candidate_confirmed()
    except Exception as exc:  # never break the section because of a side source
        out["side_error"] = str(exc)
    for row in [dict(r, source="highlights") for r in out["rows"] if not _is_possible(r)] + extra:
        k = confirmed_key(row.get("artist"), row.get("song"), row.get("bar"))
        if k in seen:
            continue
        seen.add(k)
        confirmed.append(row)
    confirmed, top = number_confirmed(confirmed)
    possible = [r for r in out["rows"] if _is_possible(r) and confirmed_key(r.get("artist"), r.get("song"), r.get("bar")) not in seen]
    out["rows"] = confirmed + possible
    out["max_seq"] = top
    out["count"] = len(out["rows"])
    out["confirmed"] = len(confirmed)
    out["possible"] = len(possible)
    out["new"] = sum(1 for r in confirmed if r.get("is_new"))
    out["sig"] = hashlib.md5(json.dumps(out["rows"], sort_keys=True, default=str).encode("utf-8")).hexdigest()
    return out


VERIFIED_FILE = ROOT / "docs/play-on-words/possible-wordplay-verify/verified.jsonl"
CONFIRMED_SEQ_FILE = Path(__file__).resolve().parent / "confirmed-seq.json"
_SEQ_LOCK = threading.Lock()
_JSONL_CACHE: dict = {}


def _read_jsonl_cached(path: Path) -> list:
    """Tolerant jsonl read, re-parsed only when mtime/size change; a half-written tail is skipped."""
    key = _progress_file_key(path)
    if key is None:
        return []
    hit = _JSONL_CACHE.get(str(path))
    if hit and hit[0] == key:
        return hit[1]
    rows = []
    try:
        with path.open(encoding="utf-8", errors="replace") as fh:
            for raw in fh:
                raw = raw.strip()
                if not raw:
                    continue
                try:
                    row = json.loads(raw)
                except json.JSONDecodeError:
                    continue
                if isinstance(row, dict):
                    rows.append(row)
    except OSError:
        return []
    _JSONL_CACHE[str(path)] = (key, rows)
    return rows


def confirmed_key(artist: str, song: str, bar: str) -> str:
    return "|".join([normalize(artist or ""), normalize(song or ""), " ".join((bar or "").lower().split())])


def _is_possible(row: dict) -> bool:
    return str(row.get("list", "")).startswith("possible")


def _verified_confirmed() -> list:
    out = []
    for r in _read_jsonl_cached(VERIFIED_FILE):
        if str(r.get("verdict", "")).strip().upper() != "CONFIRMED" or not r.get("bar"):
            continue
        sources = r.get("sources") or []
        url = r.get("url") or r.get("genius_annotation_url") or (sources[0].get("url") if sources and isinstance(sources[0], dict) else None)
        out.append({
            "artist": r.get("artist"), "list": "confirmed (verified)", "rank": None, "song": r.get("song"),
            "bar": r.get("bar"), "setup_spans": r.get("setup_spans") or [], "play_spans": r.get("play_spans") or [],
            "heard_as": r.get("heard_as"), "note_excerpt": r.get("sound_note") or "", "why_unconfirmed": None,
            "url": url, "votes": r.get("votes"), "source": "verified", "source_id": r.get("id"),
        })
    return out


def _candidate_confirmed() -> list:
    out = []
    paths = sorted(set(NOTES_DIR.parent.glob("*-candidates.jsonl")) | set(NOTES_DIR.glob("*-candidates.jsonl")))
    for path in paths:
        artist_guess = path.name[: -len("-candidates.jsonl")]
        for r in _read_jsonl_cached(path):
            if r.get("signal_type") != "sound_flip":
                continue
            kept = r.get("kept") is True or str(r.get("status", "")).lower() == "kept" or (
                "kept" not in r and "reject_reason" in r and not r.get("reject_reason"))
            plays = r.get("play_spans") or []
            bar = r.get("vault_line") or r.get("bar") or ""
            if not kept or not plays or not r.get("setup_spans") or not bar:
                continue
            aid = r.get("annotation_id")
            out.append({
                "artist": r.get("artist") or artist_guess.title(), "list": "confirmed (candidate)", "rank": None,
                "song": r.get("song"), "bar": bar, "setup_spans": r.get("setup_spans") or [], "play_spans": plays,
                "heard_as": r.get("heard_as") or r.get("heard"), "note_excerpt": r.get("note_excerpt") or "",
                "why_unconfirmed": None, "url": r.get("url") or (f"https://genius.com/{aid}" if aid else None),
                "votes": r.get("votes"), "source": "candidates:" + path.name, "source_id": aid,
            })
    return out


def number_confirmed(confirmed: list) -> tuple:
    """Give every confirmed line a permanent sequence number (confirmed-seq.json).
    First run seeds the existing highlights rows 1..N in file order; anything later gets max+1."""
    from datetime import datetime
    window_start = current_window()[0].timestamp()
    now = time.time()
    with _SEQ_LOCK:
        try:
            saved = json.loads(CONFIRMED_SEQ_FILE.read_text(encoding="utf-8"))
            items = saved.get("items") or {}
        except (OSError, ValueError):
            saved, items = None, {}
        seeding = saved is None
        changed = seeding
        top = max([v.get("n", 0) for v in items.values()] or [0])
        for row in confirmed:
            key = confirmed_key(row.get("artist"), row.get("song"), row.get("bar"))
            row["key"] = key
            hit = items.get(key)
            if hit is None:
                top += 1
                old = seeding and row.get("source") == "highlights"
                hit = items[key] = {
                    "n": top, "first_seen": 0 if old else now,
                    "first_seen_at": "seed" if old else datetime.now().astimezone().isoformat(timespec="seconds"),
                    "source": row.get("source"), "artist": row.get("artist"), "song": row.get("song"),
                    "annotation": row.get("url"),
                }
                changed = True
            row["seq"] = hit["n"]
            row["first_seen"] = hit.get("first_seen", 0)
            row["is_new"] = bool(hit.get("first_seen")) and hit["first_seen"] >= window_start
        if changed:
            tmp = CONFIRMED_SEQ_FILE.with_suffix(".json.tmp")
            try:
                tmp.write_text(json.dumps({"note": "Permanent confirmed-line numbers. Never renumber.",
                                           "max": top, "items": items}, indent=1), encoding="utf-8")
                tmp.replace(CONFIRMED_SEQ_FILE)
            except OSError:
                pass
    confirmed.sort(key=lambda r: -r["seq"])
    return confirmed, top


def parse_table(text: str) -> list[dict]:
    rows = []
    for line in text.splitlines():
        if not line.startswith("|"):
            continue
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        if len(cells) < 4:
            continue
        if cells[0].lower() == "chip" or set(cells[0]) <= {"-", ":"}:
            continue
        rows.append(
            {
                "chip": cells[0],
                "partner": cells[1],
                "song": cells[2],
                "line": cells[3],
            }
        )
    return rows[-40:]


REFRESH_LOCK = threading.Lock()
CATALOG_DB = ROOT / "tools/bar-hits-catalog/BarHitsCatalog.sqlite"
CATALOG_CACHE_FILE = Path(__file__).resolve().parent / "catalog-artists.json"
LANE_CLAIMS = ROOT / "docs/play-on-words/lane-claims"
ALL_ARTISTS_PROGRESS = ROOT / "docs/play-on-words/all-artists-progress.md"
MAIN_RUN_ACTIVE_SECONDS = 30 * 60
_CATALOG = {"key": None, "artists": None, "loading": False, "error": None}
_CATALOG_LOCK = threading.Lock()
_PASS_DONE_CACHE: dict = {"key": None, "artists": set()}


def _catalog_key():
    try:
        st = CATALOG_DB.stat()
        return [st.st_mtime_ns, st.st_size]
    except OSError:
        return None


def _load_catalog_worker(key) -> None:
    import sqlite3
    try:
        uri = "file:" + str(CATALOG_DB) + "?mode=ro"
        con = sqlite3.connect(uri, uri=True, timeout=5)
        try:
            rows = con.execute(
                "select artist, count(distinct song) from bars "
                "where artist is not null and artist != '' group by artist order by 2 desc, artist"
            ).fetchall()
        finally:
            con.close()
        artists = [{"artist": a, "songs": int(n)} for a, n in rows]
        try:
            tmp = CATALOG_CACHE_FILE.with_suffix(".json.tmp")
            tmp.write_text(json.dumps({"key": key, "artists": artists}), encoding="utf-8")
            tmp.replace(CATALOG_CACHE_FILE)
        except OSError:
            pass
        with _CATALOG_LOCK:
            _CATALOG.update(key=key, artists=artists, loading=False, error=None)
    except Exception as exc:  # keep the board up even if the catalog can't be read
        with _CATALOG_LOCK:
            _CATALOG.update(loading=False, error=str(exc))


def catalog_artists():
    """Distinct artists + distinct song counts from BarHitsCatalog.sqlite (read-only).
    Cached in memory and in catalog-artists.json; the query runs once, in the background."""
    key = _catalog_key()
    with _CATALOG_LOCK:
        if _CATALOG["artists"] is not None and _CATALOG["key"] == key:
            return _CATALOG["artists"]
        if _CATALOG["artists"] is None:
            try:
                cached = json.loads(CATALOG_CACHE_FILE.read_text(encoding="utf-8"))
                if cached.get("key") == key and isinstance(cached.get("artists"), list):
                    _CATALOG.update(key=key, artists=cached["artists"])
                    return _CATALOG["artists"]
            except (OSError, ValueError):
                pass
        if key is not None and not _CATALOG["loading"] and _CATALOG["error"] is None:
            _CATALOG["loading"] = True
            threading.Thread(target=_load_catalog_worker, args=(key,), daemon=True).start()
        return _CATALOG["artists"]  # previous list (or None) while loading


def _pass_done_artists() -> set:
    """Artists with a line in all-artists-progress.md (their pass finished)."""
    key = _progress_file_key(ALL_ARTISTS_PROGRESS)
    if key == _PASS_DONE_CACHE["key"]:
        return _PASS_DONE_CACHE["artists"]
    names = set()
    try:
        for line in ALL_ARTISTS_PROGRESS.read_text(encoding="utf-8", errors="replace").splitlines():
            if not line.startswith("|"):
                continue
            cell = line.strip().strip("|").split("|")[0].strip()
            if not cell or cell.lower() == "artist" or set(cell) <= {"-", ":", " "}:
                continue
            names.add(re.sub(r"\s*\[lane\d*\]\s*", "", cell, flags=re.I).strip().lower())
    except OSError:
        pass
    _PASS_DONE_CACHE.update(key=key, artists=names)
    return names


def _lane_claims() -> dict:
    claims = {}
    try:
        for p in LANE_CLAIMS.iterdir():
            if p.suffix not in (".claim", ".done"):
                continue
            who = "lane2"
            try:
                first = p.read_text(encoding="utf-8", errors="replace").split()
                if first:
                    who = first[0].strip(",;:")
            except OSError:
                pass
            prev = claims.get(p.stem.lower())
            if prev and prev[0] == ".claim":
                continue
            claims[p.stem.lower()] = (p.suffix, who)
    except OSError:
        pass
    return claims


def load_roster() -> dict:
    artists = catalog_artists()
    if artists is None:
        return {"ready": False, "error": _CATALOG.get("error"), "rows": []}
    claims = _lane_claims()
    pass_done = _pass_done_artists()
    now = time.time()
    rows = []
    for item in artists:
        artist = item["artist"]
        vault = item["songs"]
        path = NOTES_DIR / (artist.lower() + ".jsonl")
        row = {"artist": artist, "vault_songs": vault, "exists": False, "opened": 0, "points": 0,
               "lane": None, "mtime": None, "log_born": None}
        try:
            st = path.stat()
            row["exists"] = True
            row["mtime"] = st.st_mtime
            row["log_born"] = getattr(st, "st_birthtime", None)
        except OSError:
            pass
        if row["exists"]:
            stats = scan_artist_log(artist, path)
            row["opened"] = min(int(stats.get("opened") or 0), vault) if vault else int(stats.get("opened") or 0)
            row["points"] = int(stats.get("points") or 0)
        claim = claims.get(artist.lower())
        if claim and claim[0] == ".claim":
            row["lane"] = claim[1] or "lane2"
        row["pct"] = round(row["opened"] / vault * 100, 1) if vault else 0
        if (vault and row["opened"] >= vault) or (claim and claim[0] == ".done") or artist.lower() in pass_done:
            row["state"] = "completed"
        elif row["exists"] or row["lane"]:
            row["state"] = "in_progress"
        else:
            row["state"] = "not_started"
        rows.append(row)
    # The main run's current artist: freshest log not claimed by another lane, written recently.
    live = [r for r in rows if r["exists"] and not r["lane"] and r["mtime"] and now - r["mtime"] < MAIN_RUN_ACTIVE_SECONDS]
    if live:
        main = max(live, key=lambda r: r["mtime"])
        main["lane"] = "main run"
        if main["state"] == "not_started":
            main["state"] = "in_progress"
    order = {"in_progress": 0, "not_started": 1, "completed": 2}
    rows.sort(key=lambda r: (order[r["state"]], -r["vault_songs"], r["artist"].lower()))
    for r in rows:
        r.pop("mtime", None)
    return {"ready": True, "rows": rows}
WINDOW_HOURS = 2
WINDOW_FILE = Path(__file__).resolve().parent / "window-baseline.json"
try:
    from zoneinfo import ZoneInfo
    BOARD_TZ = ZoneInfo("America/New_York")
except Exception:  # pragma: no cover - fall back to the Mac's local zone (ET)
    BOARD_TZ = None


def _clock_label(dt) -> str:
    return dt.strftime("%I:%M %p").lstrip("0") + " ET"


def current_window():
    """Start/end of the clock-aligned 2-hour window (00:00, 02:00, ... America/New_York)."""
    from datetime import datetime, timedelta
    now = datetime.now(BOARD_TZ) if BOARD_TZ else datetime.now().astimezone()
    start = now.replace(hour=now.hour - now.hour % WINDOW_HOURS, minute=0, second=0, microsecond=0)
    end = start + timedelta(hours=WINDOW_HOURS)
    if BOARD_TZ:  # normalise across DST changes
        end = end.astimezone(BOARD_TZ)
    return start, end


def apply_window(progress: list[dict], roster: list[dict] | None = None) -> dict:
    """Attach new_points / new_songs since the window start. Baseline persists in WINDOW_FILE."""
    start, end = current_window()
    key = start.isoformat()
    try:
        saved = json.loads(WINDOW_FILE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        saved = {}
    changed = False
    if saved.get("window_start") != key or not isinstance(saved.get("artists"), dict):
        saved = {"window_start": key, "window_end": end.isoformat(), "artists": {}}
        changed = True
    base = saved["artists"]
    fresh_window = changed
    start_ts = start.timestamp()
    for row, total_key in [(r, "songs") for r in progress] + [(r, "vault_songs") for r in (roster or [])]:
        if not row.get("exists"):
            continue
        b = base.get(row["artist"])
        if b is None:
            # A log first seen mid-window that was created after the window began is all new work.
            born = row.get("log_born")
            if not fresh_window and born is not None and born >= start_ts:
                b = {"points": 0, "opened": 0}
            else:
                b = {"points": row.get("points", 0), "opened": row.get("opened", 0)}
            base[row["artist"]] = b
            changed = True
        row["new_points"] = max(0, row.get("points", 0) - b.get("points", 0))
        row["new_songs"] = max(0, min(row.get("opened", 0) - b.get("opened", 0), row.get("opened", 0)))
        songs = row.get(total_key) or 0
        row["new_pct"] = round(min(row["new_songs"], songs) / songs * 100, 2) if songs else 0
        row["base_pct"] = round(max(0, min(row.get("opened", 0), songs) - row["new_songs"]) / songs * 100, 2) if songs else 0
    if changed:
        try:
            tmp = WINDOW_FILE.with_suffix(".json.tmp")
            tmp.write_text(json.dumps(saved, indent=2), encoding="utf-8")
            tmp.replace(WINDOW_FILE)
        except OSError:
            pass
    return {
        "start": key,
        "end": end.isoformat(),
        "start_label": _clock_label(start),
        "end_label": _clock_label(end),
    }
NOTE_RELOAD_SECONDS = 30


class Board:
    def __init__(self) -> None:
        self.gen = 0
        self.payload: dict = {}
        self.baseline: set[str] | None = None
        self.landed: dict[str, float] = {}
        self.note_cache_key = None
        self.notes: list[dict] = []
        self.index: dict[str, list[int]] = {}
        self.chat_key = None
        self.chat_info: dict = {"sentence": "", "age": None, "batch": []}
        self.takeover_info: dict = takeover_snapshot()
        self.swift_key = None
        self.notes_loaded_at = 0.0

    def refresh(self) -> dict:
        if not REFRESH_LOCK.acquire(blocking=not self.payload):
            return self.payload
        try:
            return self._refresh()
        finally:
            REFRESH_LOCK.release()

    def _refresh(self) -> dict:
        progress = [dict(row) for row in load_artist_progress()]
        roster = load_roster()
        window = apply_window(progress, roster["rows"])
        for r in roster["rows"]:
            r.pop("log_born", None)
        roster["sig"] = hashlib.md5(json.dumps(roster["rows"], sort_keys=True).encode("utf-8")).hexdigest()
        roster["counts"] = {k: sum(1 for r in roster["rows"] if r["state"] == k) for k in ("in_progress", "not_started", "completed")}
        self.roster = roster
        self.takeover_info = takeover_snapshot()
        note_key = tuple(
            (path.name, path.stat().st_mtime if path.exists() else 0)
            for path in CLICK_LOGS.values()
        )
        # Re-index Genius notes at most every NOTE_RELOAD_SECONDS while a log is being
        # appended to (progress/points above are still read live, from a per-file cache).
        if note_key != self.note_cache_key and (
            self.note_cache_key is None or time.time() - self.notes_loaded_at >= NOTE_RELOAD_SECONDS
        ):
            self.notes_loaded_at = time.time()
            self.notes = load_notes(list(CLICK_LOGS.values()))
            self.index = build_index(self.notes)
            self.note_cache_key = note_key
            self.swift_key = None

        chat_key = HARNESS_CHAT.stat().st_mtime if HARNESS_CHAT.exists() else 0
        if chat_key != self.chat_key:
            self.chat_info = harness_snapshot()
            self.chat_key = chat_key
            self.swift_key = None

        swift_key = tuple(
            path.stat().st_mtime if path.exists() else 0
            for path in (SECTIONS, STORE, BRIEFS, CATALOG)
        )
        if swift_key == self.swift_key and self.payload:
            self.payload["harness"]["age"] = self.chat_info.get("age")
            self.payload["progress"] = progress
            self.payload["window"] = window
            self.payload["roster"] = roster
            self.payload["takeover"] = self.takeover_info
            self.payload["live"] = self._live()
            return self.payload

        try:
            sections = parse_sections(SECTIONS.read_text(encoding="utf-8", errors="replace"))
            store_words = parse_store(STORE.read_text(encoding="utf-8", errors="replace"))
            briefs = parse_pairs(collection_body(BRIEFS.read_text(encoding="utf-8", errors="replace"), "private static let wordplay"))
            partners = parse_pairs(
                collection_body(CATALOG.read_text(encoding="utf-8", errors="replace"), "private static let mentionPartnerTable")
            )
        except (OSError, ValueError) as exc:
            if self.payload:
                self.payload["parse_error"] = str(exc)
                self.payload["live"] = self._live()
                return self.payload
            raise

        store_set = {normalize(w) for w in store_words}
        section_order: list[tuple[str, str]] = []
        seen = set()
        for title, words in sections:
            for word in words:
                key = normalize(word)
                if key in seen:
                    continue
                seen.add(key)
                section_order.append((title, word))
        for word in store_words:
            key = normalize(word)
            if key in seen:
                continue
            seen.add(key)
            section_order.append(("In the store only", word))

        if self.baseline is None:
            self.baseline = set(seen)

        now = time.time()
        chips = []
        counts = {
            "Both on the line": 0,
            "Partner filed": 0,
            "Other half missing": 0,
            "Needs a look": 0,
        }
        for title, word in section_order:
            key = normalize(word)
            brief = (briefs.get(key) or [""])[0]
            partner = partners.get(key) or []
            note = best_note(key, brief, partner, self.notes, self.index)
            kind = classify(word, brief, note)
            labels = check_labels(key, brief, partner, note, key in store_set, title != "In the store only")
            needs = any(label in NEEDS for label in labels)
            if not partner:
                pair = "missing"
                counts["Other half missing"] += 1
            elif both_halves_on_line(partner, note):
                pair = "both"
                counts["Both on the line"] += 1
            else:
                pair = "filed"
                counts["Partner filed"] += 1
            if needs:
                counts["Needs a look"] += 1
            if key not in self.baseline and key not in self.landed:
                self.landed[key] = now
            chips.append(
                {
                    "chip": word,
                    "key": key,
                    "section": title,
                    "kind": kind,
                    "pair": pair,
                    "flip": hidden_flip(brief),
                    "labels": labels,
                    "needs": needs,
                    "brief": brief,
                    "partner": ", ".join(partner),
                    "new": key in self.landed,
                    "landed": self.landed.get(key, 0),
                    "note": None
                    if note is None
                    else {
                        "artist": note["artist"],
                        "song": note["song"],
                        "line": note["line"],
                        "meaning": note["meaning"][:900],
                        "votes": note["votes"],
                        "state": note["state"],
                        "strength": note["strength"],
                        "url": note["url"],
                    },
                }
            )

        batch = []
        by_key = {chip["key"]: chip for chip in chips}
        for row in self.chat_info.get("batch") or []:
            key = normalize(row["chip"])
            filed = by_key.get(key)
            batch.append({**row, "in_bank": filed is not None, "kind": filed["kind"] if filed else "", "needs": bool(filed and filed["needs"])})

        swift_age = now - max(swift_key)
        chips_sig = hashlib.md5(json.dumps(chips, sort_keys=True, default=str).encode("utf-8")).hexdigest()
        self.gen += 1
        self.payload = {
            "gen": self.gen,
            "chips": chips,
            "chips_sig": chips_sig,
            "counts": counts,
            "total": len(chips),
            "store": len(store_set),
            "section": sum(len(words) for _, words in sections),
            "notes": len(self.notes),
            "just_landed": sum(1 for chip in chips if chip["new"]),
            "batch": batch,
            "progress": progress,
            "window": window,
            "roster": roster,
            "takeover": self.takeover_info,
            "harness": {
                "name": "Penwork Play on Words Genius Harness",
                "sentence": self.chat_info.get("sentence") or "",
                "age": self.chat_info.get("age"),
                "swift_age": swift_age,
            },
            "live": self._live(swift_age),
            "parse_error": "",
        }
        self.swift_key = swift_key
        return self.payload

    def _live(self, swift_age: float | None = None) -> bool:
        ages = []
        if swift_age is not None:
            ages.append(swift_age)
        elif self.payload.get("harness", {}).get("swift_age") is not None:
            ages.append(self.payload["harness"]["swift_age"])
        chat_age = self.chat_info.get("age")
        if chat_age is not None:
            ages.append(chat_age)
        return any(age < 120 for age in ages)


BOARD = Board()

PAGE = r"""<!DOCTYPE html>
<html lang="en">
<head>
