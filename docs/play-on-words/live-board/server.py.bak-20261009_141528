    """Per-tile baselines for the current 24-hour ET window (same clock rule as apply_window)."""
    with _STATS_WINDOW_LOCK:
        return _stats_window_locked(values)


def _stats_window_locked(values: dict):
    start, end = current_window()
    wkey = start.isoformat()
    try:
        saved = json.loads(STATS_WINDOW_FILE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        saved = {}
    changed = False
    if saved.get("window_start") != wkey or not isinstance(saved.get("tiles"), dict):
        saved = {"window_start": wkey, "window_end": end.isoformat(), "tiles": {}}
        changed = True
    base = saved["tiles"]
    for k, v in values.items():
        if not isinstance(base.get(k), int):
            base[k] = v
            changed = True
    if changed:
        try:
            tmp = STATS_WINDOW_FILE.with_suffix(".json.tmp")
            tmp.write_text(json.dumps(saved, indent=2), encoding="utf-8")
            tmp.replace(STATS_WINDOW_FILE)
        except OSError:
            pass
    new = {k: max(0, v - base[k]) for k, v in values.items()}
