def _done_claim_complete(artist: str) -> bool:
    """lane-claims/<artist>.done written by the artist's own lane on finishing with nothing left:
    'processed=N/M' with N >= M > 0."""
    m = re.search(r"processed=(\d+)/(\d+)", _read_text_cached(LANE_CLAIMS / (artist.lower() + ".done")) or "")
    return bool(m) and int(m.group(2)) > 0 and int(m.group(1)) >= int(m.group(2))


def artist_finished(vault: int, opened: int, unresolved_left: int, done_claim_complete: bool) -> bool:
    """THE shared "finished" rule (roster completed section + CATALOG DONE + history): every vault song is
    resolved or recorded unresolved (done + missing/unresolved >= vault), or the artist's own lane wrote a .done
    claim with no songs remaining. A progress-file row alone, or a bare .done claim, does not count."""
    return bool(vault and opened + unresolved_left >= vault) or bool(done_claim_complete)


def _lane_claims() -> dict:
    claims = {}
    try:
        for p in LANE_CLAIMS.iterdir():
            if p.suffix not in (".claim", ".done"):
                continue
            who = "lane2"
            try:
                first = p.read_text(encoding="utf-8", errors="replace").split()
                if first:
                    who = first[0].strip(",;:")
            except OSError:
                pass
            prev = claims.get(p.stem.lower())
            if prev and prev[0] == ".claim":
                continue
            claims[p.stem.lower()] = (p.suffix, who)
    except OSError:
        pass
    return claims


# --- People split (display only: roster + Project Watcher lists) ----------------------------------
# Combined credits ("Lil Baby & Gunna", "¥$, Kanye West & Ty Dolla $ign") become one row per person.
# A person's vault = distinct songs across their own credit + every combined credit naming them
# (deduped by song, BarHitsCatalog.sqlite read-only); resolved = distinct opened songs across those
# click logs. Label/collective/duo prefixes (SPLIT_DROP) are dropped, true single names kept whole.
# payload["progress"] / roster["rows"] stay per-credit, so tiles, metrics and history are unchanged.
SPLIT_KEEP_WHOLE = {
    "tyler, the creator", "earth, wind & fire", "simon & garfunkel", "riko with da k", "brian x allen",
    "crosby, stills, nash & young", "hall & oates", "daryl hall & john oates", "kool & the gang",
    "mumford & sons", "florence + the machine", "marina and the diamonds", "peter, paul and mary",
    "emerson, lake & palmer", "blood, sweat & tears", "sam & dave", "ashford & simpson", "outkast",
    "eric b. & rakim", "dj jazzy jeff & the fresh prince", "mobb deep", "salt-n-pepa", "kid 'n play",
    "black eyed peas", "silk sonic", "huncho jack", "watch the throne", "big boi and dre",
}
SPLIT_DROP = {"young stoner life", "ysl", "ysl records", "¥$", "internet money", "internet money records",
              "slimelife", "4pf", "only the family", "otf", "quality control", "dreamville"}
_SPLIT_RE = re.compile(r"\s*(?:,|&|\+|\s(?:and|feat\.?|ft\.?|featuring|with|x|vs\.?)\s)\s*", re.I)


def split_artist(name: str) -> list:
    """Person names behind one credit; [name] when it is a single act."""
    name = (name or "").strip()
    if not name or name.casefold() in SPLIT_KEEP_WHOLE:
        return [name]
    parts = [x.strip() for x in _SPLIT_RE.split(" " + name + " ") if x and x.strip()]
    if len(parts) <= 1:
        return [name]
    people, seen = [], set()
    for part in parts:
        k = part.casefold()
        if k in SPLIT_DROP or k in seen:
            continue
        seen.add(k)
        people.append(part)
    return people or [name]


_PEOPLE_SONGS = {"key": None, "sets": None, "loading": False, "error": None}
_PEOPLE_LOCK = threading.Lock()


def _people_songsets_worker(key, names) -> None:
    import sqlite3
    try:
        con = sqlite3.connect("file:" + str(CATALOG_DB) + "?mode=ro", uri=True, timeout=5)
        try:
            sets: dict = {}
            q = "select distinct artist, song from bars where artist in (%s)" % ",".join("?" * len(names))
            for a, song in con.execute(q, list(names)).fetchall():
                sets.setdefault(a, set()).add(song)
        finally:
            con.close()
        with _PEOPLE_LOCK:
            _PEOPLE_SONGS.update(key=key, sets={a: frozenset(v) for a, v in sets.items()}, loading=False, error=None)
    except Exception as exc:
        with _PEOPLE_LOCK:
            _PEOPLE_SONGS.update(loading=False, error=str(exc))


_PEOPLE_CACHE: dict = {"key": None, "people": None}


def catalog_people():
    """[{artist, songs, sources:[catalog credits]}] (person view of catalog_artists), or None while loading."""
    artists = catalog_artists()
    if artists is None:
        return None
    groups: dict = {}
    for item in artists:
        parts = split_artist(item["artist"])
        whole = len(parts) == 1 and parts[0] == item["artist"]
        for part in parts:
            g = groups.get(part.casefold())
            if g is None:
                g = groups[part.casefold()] = {"artist": part, "sources": [], "src_songs": {}, "own": False}
            if whole and not g["own"]:
                g["artist"], g["own"] = item["artist"], True   # the person's own credit names the row
            g["sources"].append(item["artist"])
            g["src_songs"][item["artist"]] = int(item["songs"])
    involved = tuple(sorted({a for g in groups.values() if len(g["sources"]) > 1 for a in g["sources"]}))
    key = (tuple(_catalog_key() or ()), involved)
    with _PEOPLE_LOCK:
        sets = _PEOPLE_SONGS["sets"] if _PEOPLE_SONGS["key"] == key else None
        if sets is None and involved and not _PEOPLE_SONGS["loading"] and _PEOPLE_SONGS["key"] != key:
            _PEOPLE_SONGS["loading"] = True
            threading.Thread(target=_people_songsets_worker, args=(key, involved), daemon=True).start()
    ck = (key, sets is not None)
    if _PEOPLE_CACHE["key"] == ck:
        return _PEOPLE_CACHE["people"]
    out = []
    for g in groups.values():
        if len(g["sources"]) > 1 and sets is not None:
            n = len(frozenset().union(*[sets.get(a, frozenset()) for a in g["sources"]]))
        else:
            n = max(g["src_songs"].values())
        out.append({"artist": g["artist"], "songs": n, "sources": g["sources"]})
    out.sort(key=lambda r: (-r["songs"], r["artist"].lower()))
    _PEOPLE_CACHE.update(key=ck, people=out)
    return out


def _log_keys(path: Path, idx: int) -> frozenset:
    sk = _SONG_KEYS.get(str(path))
    return sk[idx] if sk and len(sk) > idx else frozenset()


def merge_roster_people(rows: list) -> dict:
    """Person rows built from the per-credit roster rows (after apply_window)."""
    people = catalog_people()
    if people is None:
        return {"rows": [], "counts": {}}
    by = {r["artist"]: r for r in rows}
    out = []
    for person in people:
        src = [by[a] for a in person["sources"] if a in by]
        if not src:
            continue
        vault = int(person["songs"])
        if len(src) == 1:
            opened = int(src[0].get("opened") or 0)
        else:
            keys = frozenset().union(*[_log_keys(NOTES_DIR / (r["artist"].lower() + ".jsonl"), 4) for r in src])
            opened = len(keys) if keys else sum(int(r.get("opened") or 0) for r in src)
        opened = min(opened, vault) if vault else opened
        states = [r.get("state") for r in src]
        lane = next((r.get("lane") for r in src if r["artist"] == person["artist"] and r.get("lane")), None) or \
            next((r.get("lane") for r in src if r.get("lane")), None)
        if all(st == "completed" for st in states):
            state = "completed"
        elif lane or opened > 0 or "in_progress" in states:
            state = "in_progress"
        else:
            state = "not_started"
        new_songs = min(sum(int(r.get("new_songs") or 0) for r in src), opened)
        row = {"artist": person["artist"], "vault_songs": vault, "exists": any(r.get("exists") for r in src),
               "opened": opened, "points": sum(int(r.get("points") or 0) for r in src), "lane": lane,
               "state": state, "new_points": sum(int(r.get("new_points") or 0) for r in src), "new_songs": new_songs,
               "pct": round(opened / vault * 100, 1) if vault else 0,
               "new_pct": round(min(new_songs, vault) / vault * 100, 2) if vault else 0,
               "base_pct": round(max(0, min(opened, vault) - new_songs) / vault * 100, 2) if vault else 0}
        if len(person["sources"]) > 1 or person["sources"][0] != person["artist"]:
            row["sources"] = person["sources"]
        out.append(row)
    order = {"in_progress": 0, "not_started": 1, "completed": 2}
    out.sort(key=lambda r: (order[r["state"]], -r["vault_songs"], r["artist"].lower()))
    return {"rows": out, "counts": {k: sum(1 for r in out if r["state"] == k) for k in ("in_progress", "not_started", "completed")}}


def merge_watch_people(progress: list) -> list:
    """Project Watcher rows, one per person (combined-credit click logs count toward each member)."""
    people = catalog_people() or []
    pmap = {p["artist"].casefold(): p for p in people}
    credit = {}
    for p in people:
        for a in p["sources"]:
            credit.setdefault(a.casefold(), a)
    groups: dict = {}
    order = []
    for r in progress:
        stem = Path(r.get("path") or "").stem
        name = credit.get(stem.casefold()) or credit.get(str(r["artist"]).casefold()) or r["artist"]
        for person in split_artist(name):
            k = person.casefold()
            if k not in groups:
                groups[k] = []
                order.append(k)
            groups[k].append(r)
    out = []
    for k in order:
        src = groups[k]
        p = pmap.get(k)
        disp = p["artist"] if p else src[0]["artist"]
        vault = int(p["songs"]) if p else None
        if len(src) == 1:
            row = dict(src[0], artist=disp)
        else:
            paths = [ROOT / r["path"] for r in src if r.get("path")]
            all_keys = frozenset().union(*[_log_keys(x, 3) for x in paths])
            op_keys = frozenset().union(*[_log_keys(x, 4) for x in paths])
            songs = len(all_keys) or sum(int(r.get("songs") or 0) for r in src)
            opened = min(len(op_keys) if all_keys else sum(int(r.get("opened") or 0) for r in src), songs)
            fresh = min(src, key=lambda r: r["age"] if r.get("age") is not None else 1e18)
            row = dict(fresh)
            for f in ("rows", "valid", "invalid", "done", "missing", "saved_notes", "second_sense", "not_new",
                      "points", "new_points", "partial_tail"):
                row[f] = sum(int(r.get(f) or 0) for r in src)
            new_songs = min(sum(int(r.get("new_songs") or 0) for r in src), opened)
            row.update(artist=disp, path=" + ".join(r["path"] for r in src if r.get("path")),
                       exists=any(r.get("exists") for r in src), songs=songs, song_total=songs, opened=opened,
                       opened_songs=opened, unopened_songs=max(songs - opened, 0),
                       pct=round(opened / songs * 100) if songs else 0,
                       status="open" if any(r.get("status") != "done" for r in src) else "done",
                       new_songs=new_songs,
                       new_pct=round(new_songs / songs * 100, 2) if songs else 0,
                       base_pct=round(max(0, opened - new_songs) / songs * 100, 2) if songs else 0)
        row["vault_songs"] = vault
        if len(src) > 1 or Path(src[0].get("path") or "").stem.casefold() != k:
            row["sources"] = [Path(r.get("path") or "").stem for r in src]
        out.append(row)
    return out


def load_roster() -> dict:
    artists = catalog_artists()
    if artists is None:
        return {"ready": False, "error": _CATALOG.get("error"), "rows": []}
    claims = _lane_claims()
    now = time.time()
    rows = []
    for item in artists:
        artist = item["artist"]
        vault = item["songs"]
        path = NOTES_DIR / (artist.lower() + ".jsonl")
        row = {"artist": artist, "vault_songs": vault, "exists": False, "opened": 0, "points": 0,
               "lane": None, "mtime": None, "log_born": None}
        try:
            st = path.stat()
            row["exists"] = True
            row["mtime"] = st.st_mtime
            row["log_born"] = getattr(st, "st_birthtime", None)
        except OSError:
            pass
        if row["exists"]:
            stats = scan_artist_log(artist, path)
            row["opened"] = min(int(stats.get("opened") or 0), vault) if vault else int(stats.get("opened") or 0)
            row["points"] = int(stats.get("points") or 0)
        claim = claims.get(artist.lower())
        if claim and claim[0] == ".claim":
            who = (claim[1] or "lane2").strip()
            who_norm = who.lower().replace(" ", "").replace("-", "").replace("_", "")
            # Numbered to match Anti-Gravity chat / Jobs cards (#2 Uzi, #3 lane 2, #5 Wayne, #6 YoungBoy).
            if artist == "Lil Uzi Vert" or who_norm == "chat2":
                row["lane"] = "#2"
            elif artist == "Lil Wayne" or who_norm == "chat5":
                row["lane"] = "#5"
            elif artist == "YoungBoy Never Broke Again" or who_norm == "chat6":
                row["lane"] = "#6"
            elif who_norm in ("lane2", "lane"):
                row["lane"] = "#3 lane 2"
            else:
                row["lane"] = who
        row["pct"] = round(row["opened"] / vault * 100, 1) if vault else 0
        if artist_finished(vault, row["opened"], _artist_unresolved_left(artist, path) if vault else 0,
                           bool(claim and claim[0] == ".done") and _done_claim_complete(artist)):
            row["state"] = "completed"
        elif row["exists"] or row["lane"]:
            row["state"] = "in_progress"
        else:
            row["state"] = "not_started"
        rows.append(row)
    # The main run's current artist: freshest log not claimed by another lane, written recently.
    live = [r for r in rows if r["exists"] and not r["lane"] and r["mtime"] and now - r["mtime"] < MAIN_RUN_ACTIVE_SECONDS]
    if live:
        main = max(live, key=lambda r: r["mtime"])
        main["lane"] = "main run"
        if main["state"] == "not_started":
            main["state"] = "in_progress"
    order = {"in_progress": 0, "not_started": 1, "completed": 2}
    rows.sort(key=lambda r: (order[r["state"]], -r["vault_songs"], r["artist"].lower()))
    for r in rows:
        r.pop("mtime", None)
    return {"ready": True, "rows": rows}
WINDOW_HOURS = 24
WINDOW_FILE = Path(__file__).resolve().parent / "window-baseline.json"
try:
    from zoneinfo import ZoneInfo
    BOARD_TZ = ZoneInfo("America/New_York")
except Exception:  # pragma: no cover - fall back to the Mac's local zone (ET)
    BOARD_TZ = None


def _clock_label(dt) -> str:
    return dt.strftime("%I:%M %p").lstrip("0") + " ET"


def current_window():
    """Start/end of the clock-aligned 24-hour window (midnight to midnight, America/New_York)."""
    from datetime import datetime, timedelta
    now = datetime.now(BOARD_TZ) if BOARD_TZ else datetime.now().astimezone()
    start = now.replace(hour=now.hour - now.hour % WINDOW_HOURS, minute=0, second=0, microsecond=0)
    end = start + timedelta(hours=WINDOW_HOURS)
    if BOARD_TZ:  # normalise across DST changes
        end = end.astimezone(BOARD_TZ)
    return start, end


def apply_window(progress: list[dict], roster: list[dict] | None = None) -> dict:
    """Attach new_points / new_songs since the window start. Baseline persists in WINDOW_FILE."""
    start, end = current_window()
    key = start.isoformat()
    try:
        saved = json.loads(WINDOW_FILE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        saved = {}
    changed = False
    if saved.get("window_start") != key or not isinstance(saved.get("artists"), dict):
        saved = {"window_start": key, "window_end": end.isoformat(), "artists": {}}
        changed = True
    base = saved["artists"]
    fresh_window = changed
    start_ts = start.timestamp()
    for row, total_key in [(r, "songs") for r in progress] + [(r, "vault_songs") for r in (roster or [])]:
        if not row.get("exists"):
            continue
        b = base.get(row["artist"])
        if b is None:
            # A log first seen mid-window that was created after the window began is all new work.
            born = row.get("log_born")
            if not fresh_window and born is not None and born >= start_ts:
                b = {"points": 0, "opened": 0}
            else:
                b = {"points": row.get("points", 0), "opened": row.get("opened", 0)}
            base[row["artist"]] = b
            changed = True
        row["new_points"] = max(0, row.get("points", 0) - b.get("points", 0))
        row["new_songs"] = max(0, min(row.get("opened", 0) - b.get("opened", 0), row.get("opened", 0)))
        songs = row.get(total_key) or 0
        row["new_pct"] = round(min(row["new_songs"], songs) / songs * 100, 2) if songs else 0
        row["base_pct"] = round(max(0, min(row.get("opened", 0), songs) - row["new_songs"]) / songs * 100, 2) if songs else 0
    if changed:
        try:
            tmp = WINDOW_FILE.with_suffix(".json.tmp")
            tmp.write_text(json.dumps(saved, indent=2), encoding="utf-8")
            tmp.replace(WINDOW_FILE)
        except OSError:
            pass
    return {
        "start": key,
        "end": end.isoformat(),
        "start_label": _clock_label(start),
        "end_label": _clock_label(end),
    }
