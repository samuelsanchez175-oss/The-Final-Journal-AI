def harness_snapshot() -> dict:
    sentence = "The other terminal has not posted a status line yet."
    batch: list[dict] = []
    age = None
    if HARNESS_CHAT.exists():
        age = time.time() - HARNESS_CHAT.stat().st_mtime
        texts: list[str] = []
        with HARNESS_CHAT.open(encoding="utf-8", errors="replace") as handle:
            for line in handle:
                try:
                    row = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if row.get("type") == "assistant" and isinstance(row.get("content"), str):
                    text = row["content"].strip()
                    if text:
                        texts.append(text)
        if texts:
            sentence = " ".join(texts[-1].split())
            if len(sentence) > 420:
                sentence = sentence[:417] + "..."
            for text in reversed(texts):
                if "| Chip |" in text or "| chip |" in text.lower():
                    batch = parse_table(text)
                    break
    return {"sentence": sentence, "age": age, "batch": batch}


def takeover_snapshot() -> dict:
    if not TAKEOVER_STATUS.exists():
        return {
            "agent": "Codex takeover",
            "lane": "No active takeover lane",
            "state": "standby",
            "detail": "No local takeover status file is present.",
            "done": 0,
            "total": 0,
            "age": None,
        }
    try:
        payload = json.loads(TAKEOVER_STATUS.read_text(encoding="utf-8", errors="replace"))
    except (OSError, json.JSONDecodeError) as exc:
        return {
            "agent": "Codex takeover",
            "lane": "Status parse error",
            "state": "blocked",
            "detail": str(exc),
            "done": 0,
            "total": 0,
            "age": None,
        }
    payload["age"] = time.time() - TAKEOVER_STATUS.stat().st_mtime
    payload.setdefault("done", 0)
    payload.setdefault("total", 0)
    payload.setdefault("subagents", [])
    return payload


def load_highlights() -> dict:
    """Read docs/play-on-words/wordplay-highlights.jsonl at request time."""
    out = {"ok": True, "path": str(HIGHLIGHTS), "mtime": None, "rows": [], "bad_lines": 0}
    try:
        stat = HIGHLIGHTS.stat()
        out["mtime"] = stat.st_mtime
        with HIGHLIGHTS.open(encoding="utf-8") as fh:
            for raw in fh:
                raw = raw.strip()
                if not raw:
                    continue
                try:
                    row = json.loads(raw)
                except json.JSONDecodeError:
                    out["bad_lines"] += 1
                    continue
                if isinstance(row, dict) and row.get("bar"):
                    out["rows"].append(row)
    except FileNotFoundError:
        out["ok"] = False
        out["error"] = "wordplay-highlights.jsonl not found"
    except OSError as err:
        out["ok"] = False
        out["error"] = str(err)
    # Confirmed lines from all sources, deduped by artist+song+bar, numbered permanently.
    # Recheck overrides (confirmed-recheck/recheck.jsonl): REJECT drops a line (its number stays
    # reserved in confirmed-seq.json, leaving a gap), FIX swaps in corrected spans/heard_as, KEEP/FIX
    # is the only way a mined sound-flip candidate becomes confirmed.
    try:
        confirmed, seen, overrides = _confirmed_lines(out["rows"])
    except Exception as exc:  # never break the section because of a side source
        out["side_error"] = str(exc)
        confirmed, seen, overrides = [], set(), {}
    confirmed, top = number_confirmed(confirmed)
    possible = [r for r in out["rows"] if _is_possible(r) and confirmed_key(r.get("artist"), r.get("song"), r.get("bar")) not in seen]
    shown = {confirmed_key(r.get("artist"), r.get("song"), r.get("bar")) for r in possible} | seen
    try:
        for r in _candidate_unconfirmed(overrides):
            k = confirmed_key(r.get("artist"), r.get("song"), r.get("bar"))
            if k not in shown:
                shown.add(k)
                possible.append(r)
    except Exception as exc:
        out["side_error"] = str(exc)
    shortlist_n = 0
    try:
        for r in _shortlist_unconfirmed(overrides):
            k = confirmed_key(r.get("artist"), r.get("song"), r.get("bar"))
            if k not in shown:
                shown.add(k)
                possible.append(r)
                shortlist_n += 1
    except Exception as exc:
        out["side_error"] = str(exc)
    out["shortlist_unconfirmed"] = shortlist_n
    out["rows"] = confirmed + possible
    out["recheck"] = {v.lower(): sum(1 for o in overrides.values() if o["verdict"] == v) for v in ("KEEP", "FIX", "REJECT")}
    out["max_seq"] = top
    out["count"] = len(out["rows"])
    out["confirmed"] = len(confirmed)
    out["possible"] = len(possible)
    out["new"] = sum(1 for r in confirmed if r.get("is_new"))
    # Header counts mirror the /api/catches tiles (same cached computation).
    try:
        cc = catch_counts()
        out["tiles"] = dict(cc.get("counts") or {}, re_reviewed=(cc.get("re_reviewed") or {}).get("count", 0)) if cc.get("ok") else None
    except Exception:
        out["tiles"] = None
    out["sig"] = hashlib.md5(json.dumps([out["rows"], out["tiles"]], sort_keys=True, default=str).encode("utf-8")).hexdigest()
    return out


VERIFIED_FILE = ROOT / "docs/play-on-words/possible-wordplay-verify/verified.jsonl"
CONFIRMED_SEQ_FILE = Path(__file__).resolve().parent / "confirmed-seq.json"
_SEQ_LOCK = threading.Lock()
_JSONL_CACHE: dict = {}


def _read_jsonl_cached(path: Path) -> list:
    """Tolerant jsonl read, re-parsed only when mtime/size change; a half-written tail is skipped."""
    key = _progress_file_key(path)
    if key is None:
        return []
    hit = _JSONL_CACHE.get(str(path))
    if hit and hit[0] == key:
        return hit[1]
    rows = []
    try:
        with path.open(encoding="utf-8", errors="replace") as fh:
            for raw in fh:
                raw = raw.strip()
                if not raw:
                    continue
                try:
                    row = json.loads(raw)
                except json.JSONDecodeError:
                    continue
                if isinstance(row, dict):
                    rows.append(row)
    except OSError:
        return []
    _JSONL_CACHE[str(path)] = (key, rows)
    return rows


def confirmed_key(artist: str, song: str, bar: str) -> str:
    return "|".join([normalize(artist or ""), normalize(song or ""), " ".join((bar or "").lower().split())])


def _is_possible(row: dict) -> bool:
    return str(row.get("list", "")).startswith("possible")


RECHECK_FILE = ROOT / "docs/play-on-words/confirmed-recheck/recheck.jsonl"
RECHECK_VERDICTS = ("KEEP", "FIX", "REJECT")


def _recheck_overrides() -> dict:
    """confirmed_key -> last KEEP/FIX/REJECT row from confirmed-recheck/recheck.jsonl (tolerant, cached)."""
    out = {}
    for r in _read_jsonl_cached(RECHECK_FILE):
        v = str(r.get("verdict") or "").strip().upper()
        if v not in RECHECK_VERDICTS or not r.get("key_bar"):
            continue
        out[confirmed_key(r.get("key_artist"), r.get("key_song"), r.get("key_bar"))] = dict(r, verdict=v)
    return out


def _apply_recheck(row: dict, ov: dict) -> dict:
    row = dict(row)
    row["recheck"] = {"verdict": ov["verdict"], "reason": ov.get("reason"), "by": ov.get("by"),
                      "ts": ov.get("ts"), "needs_recheck": bool(ov.get("needs_recheck"))}
    if ov["verdict"] == "FIX":
        if isinstance(ov.get("setup_spans"), list):
            row["setup_spans"] = ov["setup_spans"]
        if isinstance(ov.get("play_spans"), list):
            row["play_spans"] = ov["play_spans"]
        if ov.get("heard_as"):
            row["heard_as"] = ov["heard_as"]
    return row


def _confirmed_lines(hl_rows: list) -> tuple:
    """The one confirmed set (load_highlights numbers it, /api/catches counts it), deduped by key:
    highlights non-possible rows + verified CONFIRMED + any line with a KEEP/FIX override; REJECT removes."""
    ov = _recheck_overrides()
    keepfix = {k for k, o in ov.items() if o["verdict"] in ("KEEP", "FIX")}
    rows = [dict(r, source="highlights") for r in hl_rows if not _is_possible(r)]
    rows += [dict(r, source="highlights", list="confirmed (rechecked)") for r in hl_rows
             if _is_possible(r) and confirmed_key(r.get("artist"), r.get("song"), r.get("bar")) in keepfix]
    rows += _verified_confirmed(ov) + _candidate_confirmed(ov)
    try:
        rows += _shortlist_confirmed(ov)
    except Exception:
        pass
    out, seen = [], set()
    for row in rows:
        k = confirmed_key(row.get("artist"), row.get("song"), row.get("bar"))
        if k in seen:
            continue
        seen.add(k)
        o = ov.get(k)
        if o and o["verdict"] == "REJECT":
            continue
        out.append(_apply_recheck(row, o) if o else row)
    return out, seen, ov


def _verified_confirmed(overrides=None) -> list:
    ov = _recheck_overrides() if overrides is None else overrides
    out = []
    for r in _read_jsonl_cached(VERIFIED_FILE):
        if not r.get("bar"):
            continue
        o = ov.get(confirmed_key(r.get("artist"), r.get("song"), r.get("bar")))
        if str(r.get("verdict", "")).strip().upper() != "CONFIRMED" and not (o and o["verdict"] in ("KEEP", "FIX")):
            continue
        sources = r.get("sources") or []
        url = r.get("url") or r.get("genius_annotation_url") or (sources[0].get("url") if sources and isinstance(sources[0], dict) else None)
        out.append({
            "artist": r.get("artist"), "list": "confirmed (verified)", "rank": None, "song": r.get("song"),
            "bar": r.get("bar"), "setup_spans": r.get("setup_spans") or [], "play_spans": r.get("play_spans") or [],
            "heard_as": r.get("heard_as"), "note_excerpt": r.get("sound_note") or "", "why_unconfirmed": None,
            "url": url, "votes": r.get("votes"), "source": "verified", "source_id": r.get("id"),
        })
    return out


def _candidate_rows() -> list:
    """Every mined sound_flip candidate row (with a bar), normalised; 'state' is kept/rejected/pending."""
    out = []
    paths = sorted(set(NOTES_DIR.parent.glob("*-candidates.jsonl")) | set(NOTES_DIR.glob("*-candidates.jsonl")))
    for path in paths:
        artist_guess = path.name[: -len("-candidates.jsonl")]
        for r in _read_jsonl_cached(path):
            if r.get("signal_type") != "sound_flip":
                continue
            bar = r.get("vault_line") or r.get("bar") or ""
            if not bar:
                continue
            aid = r.get("annotation_id")
            out.append({
                "artist": r.get("artist") or artist_guess.title(), "list": "confirmed (candidate)", "rank": None,
                "song": r.get("song"), "bar": bar, "setup_spans": r.get("setup_spans") or [],
                "play_spans": r.get("play_spans") or [],
                "heard_as": r.get("heard_as") or r.get("heard"), "note_excerpt": r.get("note_excerpt") or "",
                "why_unconfirmed": None, "url": r.get("url") or (f"https://genius.com/{aid}" if aid else None),
                "votes": r.get("votes"), "source": "candidates:" + path.name, "source_id": aid,
                "state": _candidate_state(r),
            })
    return out


def _candidate_confirmed(overrides=None) -> list:
    """Mined sound-flips are NEVER auto-confirmed: only a second-pass KEEP/FIX in recheck.jsonl promotes one."""
    ov = _recheck_overrides() if overrides is None else overrides
    out = []
    for r in _candidate_rows():
        o = ov.get(confirmed_key(r.get("artist"), r.get("song"), r.get("bar")))
        if o and o["verdict"] in ("KEEP", "FIX"):
            out.append({k: v for k, v in r.items() if k != "state"})
    return out


def _candidate_unconfirmed(overrides=None) -> list:
    """Kept mined sound-flips with spans and no recheck verdict: shown in the collapsed possible section."""
    ov = _recheck_overrides() if overrides is None else overrides
    out = []
    for r in _candidate_rows():
        if r["state"] != "kept" or not r["play_spans"] or not r["setup_spans"]:
            continue
        if confirmed_key(r.get("artist"), r.get("song"), r.get("bar")) in ov:
            continue
        row = {k: v for k, v in r.items() if k != "state"}
        row["list"] = "possible (mined sound-flip)"
        row["why_unconfirmed"] = "mined sound-flip, awaiting second-pass KEEP/FIX in confirmed-recheck/recheck.jsonl"
        out.append(row)
    return out


# Artist review shortlists (docs/play-on-words/*-review/*-shortlist.jsonl). Every row is UNCONFIRMED:
# never numbered, never written to confirmed-seq.json. A second-pass KEEP/FIX in recheck.jsonl promotes a
# line to confirmed (numbered as usual); REJECT hides it. Spans arrive as [start, end] lists.
SHORTLIST_GLOB = "*-review/*-shortlist.jsonl"


def _shortlist_spans(spans, bar: str, heard=None, play=False) -> list:
    out = []
    for sp in spans or []:
        try:
            if isinstance(sp, dict):
                a, b = int(sp.get("start")), int(sp.get("end"))
            else:
                a, b = int(sp[0]), int(sp[1])
        except (TypeError, ValueError, IndexError, KeyError):
            continue
        if not (0 <= a < b <= len(bar)):
            continue
        d = {"text": bar[a:b], "start": a, "end": b}
        if play:
            d["heard"] = heard
        out.append(d)
    return out


def _shortlist_rows() -> list:
    out = []
    for path in sorted((ROOT / "docs/play-on-words").glob(SHORTLIST_GLOB)):
        for r in _read_jsonl_cached(path):
            bar = r.get("bar") or ""
            if not bar:
                continue
            aid = r.get("annotation_id")
            flag = str(r.get("filter_flag") or "").strip()
            why = "review shortlist (" + path.name + (", " + str(r.get("strength")) if r.get("strength") else "") + \
                  "), awaiting second-pass KEEP/FIX in confirmed-recheck/recheck.jsonl"
            if flag:
                why += " · flag: " + flag
            out.append({
                "artist": r.get("artist") or path.name.split("-")[0].title(), "list": "possible (shortlist)",
                "rank": None, "song": r.get("song"), "bar": bar,
                "setup_spans": _shortlist_spans(r.get("setup_spans"), bar),
                "play_spans": _shortlist_spans(r.get("play_spans"), bar, None, True),
                "heard_as": r.get("heard_as"), "note_excerpt": r.get("note_excerpt") or "",
                "why_unconfirmed": why, "url": r.get("url") or (f"https://genius.com/{aid}" if aid else None),
                "votes": r.get("votes"), "source": "shortlist:" + path.name, "source_id": aid,
                "unconfirmed_tag": True,
            })
    return out


def _shortlist_confirmed(overrides=None) -> list:
    ov = _recheck_overrides() if overrides is None else overrides
    out = []
    for r in _shortlist_rows():
        o = ov.get(confirmed_key(r.get("artist"), r.get("song"), r.get("bar")))
        if o and o["verdict"] in ("KEEP", "FIX"):
            out.append({k: v for k, v in dict(r, list="confirmed (shortlist)", why_unconfirmed=None).items() if k != "unconfirmed_tag"})
    return out


def _shortlist_unconfirmed(overrides=None) -> list:
    ov = _recheck_overrides() if overrides is None else overrides
    return [r for r in _shortlist_rows() if confirmed_key(r.get("artist"), r.get("song"), r.get("bar")) not in ov]


def number_confirmed(confirmed: list) -> tuple:
    """Give every confirmed line a permanent sequence number (confirmed-seq.json).
    First run seeds the existing highlights rows 1..N in file order; anything later gets max+1."""
    from datetime import datetime
    window_start = current_window()[0].timestamp()
    now = time.time()
    with _SEQ_LOCK:
        try:
            saved = json.loads(CONFIRMED_SEQ_FILE.read_text(encoding="utf-8"))
            items = saved.get("items") or {}
        except (OSError, ValueError):
            saved, items = None, {}
        seeding = saved is None
        changed = seeding
        top = max([v.get("n", 0) for v in items.values()] or [0])
        for row in confirmed:
            key = confirmed_key(row.get("artist"), row.get("song"), row.get("bar"))
            row["key"] = key
            hit = items.get(key)
            if hit is None:
                top += 1
                old = seeding and row.get("source") == "highlights"
                hit = items[key] = {
                    "n": top, "first_seen": 0 if old else now,
                    "first_seen_at": "seed" if old else datetime.now().astimezone().isoformat(timespec="seconds"),
                    "source": row.get("source"), "artist": row.get("artist"), "song": row.get("song"),
                    "annotation": row.get("url"),
                }
                changed = True
            row["seq"] = hit["n"]
            row["first_seen"] = hit.get("first_seen", 0)
            row["is_new"] = bool(hit.get("first_seen")) and hit["first_seen"] >= window_start
        if changed:
            tmp = CONFIRMED_SEQ_FILE.with_suffix(".json.tmp")
            try:
                tmp.write_text(json.dumps({"note": "Permanent confirmed-line numbers. Never renumber.",
                                           "max": top, "items": items}, indent=1), encoding="utf-8")
                tmp.replace(CONFIRMED_SEQ_FILE)
            except OSError:
                pass
    confirmed.sort(key=lambda r: -r["seq"])
    return confirmed, top


def parse_table(text: str) -> list[dict]:
    rows = []
    for line in text.splitlines():
        if not line.startswith("|"):
            continue
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        if len(cells) < 4:
            continue
        if cells[0].lower() == "chip" or set(cells[0]) <= {"-", ":"}:
            continue
        rows.append(
            {
                "chip": cells[0],
                "partner": cells[1],
                "song": cells[2],
                "line": cells[3],
            }
        )
    return rows[-40:]


REFRESH_LOCK = threading.Lock()
CATALOG_DB = ROOT / "tools/bar-hits-catalog/BarHitsCatalog.sqlite"
CATALOG_CACHE_FILE = Path(__file__).resolve().parent / "catalog-artists.json"
LANE_CLAIMS = ROOT / "docs/play-on-words/lane-claims"
ALL_ARTISTS_PROGRESS = ROOT / "docs/play-on-words/all-artists-progress.md"
MAIN_RUN_ACTIVE_SECONDS = 30 * 60
_CATALOG = {"key": None, "artists": None, "loading": False, "error": None}
_CATALOG_LOCK = threading.Lock()
_PASS_DONE_CACHE: dict = {"key": None, "artists": set()}


def _catalog_key():
    try:
        st = CATALOG_DB.stat()
        return [st.st_mtime_ns, st.st_size]
    except OSError:
        return None


def _load_catalog_worker(key) -> None:
    import sqlite3
    try:
        uri = "file:" + str(CATALOG_DB) + "?mode=ro"
        con = sqlite3.connect(uri, uri=True, timeout=5)
        try:
            rows = con.execute(
                "select artist, count(distinct song) from bars "
                "where artist is not null and artist != '' group by artist order by 2 desc, artist"
            ).fetchall()
        finally:
            con.close()
        artists = [{"artist": a, "songs": int(n)} for a, n in rows]
        try:
            tmp = CATALOG_CACHE_FILE.with_suffix(".json.tmp")
            tmp.write_text(json.dumps({"key": key, "artists": artists}), encoding="utf-8")
            tmp.replace(CATALOG_CACHE_FILE)
        except OSError:
            pass
        with _CATALOG_LOCK:
            _CATALOG.update(key=key, artists=artists, loading=False, error=None)
    except Exception as exc:  # keep the board up even if the catalog can't be read
        with _CATALOG_LOCK:
            _CATALOG.update(loading=False, error=str(exc))


def catalog_artists():
    """Distinct artists + distinct song counts from BarHitsCatalog.sqlite (read-only).
    Cached in memory and in catalog-artists.json; the query runs once, in the background."""
    key = _catalog_key()
    with _CATALOG_LOCK:
        if _CATALOG["artists"] is not None and _CATALOG["key"] == key:
            return _CATALOG["artists"]
        if _CATALOG["artists"] is None:
            try:
                cached = json.loads(CATALOG_CACHE_FILE.read_text(encoding="utf-8"))
                if cached.get("key") == key and isinstance(cached.get("artists"), list):
                    _CATALOG.update(key=key, artists=cached["artists"])
                    return _CATALOG["artists"]
            except (OSError, ValueError):
                pass
        if key is not None and not _CATALOG["loading"] and _CATALOG["error"] is None:
            _CATALOG["loading"] = True
            threading.Thread(target=_load_catalog_worker, args=(key,), daemon=True).start()
        return _CATALOG["artists"]  # previous list (or None) while loading


def _pass_done_artists() -> set:
    """Artists with a line in all-artists-progress.md (their pass finished)."""
    key = _progress_file_key(ALL_ARTISTS_PROGRESS)
    if key == _PASS_DONE_CACHE["key"]:
        return _PASS_DONE_CACHE["artists"]
    names = set()
    try:
        for line in ALL_ARTISTS_PROGRESS.read_text(encoding="utf-8", errors="replace").splitlines():
            if not line.startswith("|"):
                continue
            cell = line.strip().strip("|").split("|")[0].strip()
            if not cell or cell.lower() == "artist" or set(cell) <= {"-", ":", " "}:
                continue
            names.add(re.sub(r"\s*\[lane\d*\]\s*", "", cell, flags=re.I).strip().lower())
    except OSError:
        pass
    _PASS_DONE_CACHE.update(key=key, artists=names)
    return names


