def _job_wiring() -> dict:
    rows = _read_jsonl_cached(WIRING_LOG)
    latest: dict = {}
    row_of: dict = {}
    test = None
    for r in rows:
        decision = str(r.get("decision") or "").strip().lower()
        if any("test" in k.lower() for k in r) or decision in ("batch_result", "batch-result", "test", "tests"):
            if test is None or str(r.get("ts") or "") >= str(test.get("ts") or ""):
                test = r                               # the latest test row decides pass / fail
        if not r.get("noun") or not decision or decision in ("batch_result", "batch-result", "test", "tests"):
            continue
        line = r.get("source_line")
        rowkey = (str(r.get("source") or ""), line) if line is not None else ("chip", normalize(str(r.get("noun"))))
        chip = (rowkey, normalize(str(r.get("noun"))))
        latest[chip] = decision
        row_of[chip] = rowkey
    wired_rows = {row_of[c] for c, d in latest.items() if d in ("reused", "created")}
    wired_chips = sum(1 for d in latest.values() if d in ("reused", "created"))
    queued_chips = sum(1 for d in latest.values() if d == "queued")
    queued_rows = {row_of[c] for c, d in latest.items() if d == "queued"} - wired_rows
    skipped = sum(1 for d in latest.values() if d == "skipped")
    reverted = sum(1 for d in latest.values() if d == "reverted")
    handled_rows = {row_of[c] for c in latest}
    queue_text = _read_text_cached(WIRING_QUEUE)
    if not latest and queue_text:
        queued_chips = sum(1 for ln in queue_text.splitlines()
                           if (ln.startswith("|") and not set(ln.replace("|", "").strip()) <= set("-: ")) or ln.startswith("- "))
        queued_chips = max(0, queued_chips - (1 if any(ln.startswith("|") for ln in queue_text.splitlines()) else 0))
    try:
        backups = sorted(p.name for p in WIRING_BACKUPS.iterdir() if p.is_dir())
    except OSError:
        backups = []
    stamps = [_mtime(WIRING_LOG), _mtime(WIRING_QUEUE)] + ([_mtime(WIRING_BACKUPS / backups[-1])] if backups else [])
    last = max([t for t in stamps if t] or [0]) or None
    has_output = WIRING_LOG.exists() or WIRING_QUEUE.exists() or bool(backups)
    q_wait, q_done = _queue_counts()
    cs4 = _chat_status(4)
    # DONE only when the image queue is empty AND chat-status/chat-4.md says done.
    done = q_wait == 0 and cs4.get("state_key") == "done"
    brief_m = _mtime(WIRING_BRIEF) or 0
    swift_changed = [p.name for p in WIRING_SWIFT if (_mtime(p) or 0) > brief_m]
    alerts = []
    if swift_changed and not backups and (has_output or wired_chips):
        alerts.append("Swift changed (" + ", ".join(swift_changed) + ") with no wiring-backups/ yet")
    if reverted:
        alerts.append(str(reverted) + " chip(s) reverted after a failed batch")
    test_text = "Last batch test: none logged yet"
    if test:
        res = str(test.get("result") or test.get("test_result") or test.get("status") or test.get("outcome") or "").strip().upper()
        fails = None
        for k in ("failures", "failed"):
            try:
                if test.get(k) is not None:
                    fails = int(test.get(k))
                    break
            except (TypeError, ValueError):
                pass
        if res.startswith("PASS") and not fails:
            ok = True
        elif res.startswith("FAIL") or (fails or 0) > 0:
            ok = False
        else:
            ok = None
        run = test.get("tests_run")
        passed = test.get("passed")
        test_text = ("Last batch test: " + ("batch " + str(test.get("batch")) + " " if test.get("batch") is not None else "") +
                     ("PASS" if ok else "FAIL" if ok is False else (res or "result unknown")) +
                     (" (" + str(passed) + "/" + str(run) + ")" if passed is not None and run is not None else "") +
                     (" · " + _et_label(_iso_ts(test.get("ts"))) if _iso_ts(test.get("ts")) else ""))
        if ok is False:
            alerts.append("Last batch test (batch " + str(test.get("batch", "?")) + ") failed" + (": " + str(fails) + " failure(s)" if fails else ""))
    try:
        born = getattr(WIRING_LOG.stat(), "st_birthtime", None)
    except OSError:
        born = None
    if cs4.get("mtime"):
        last = max(last or 0, cs4["mtime"])
    if done:
        status = "done"
    elif cs4.get("fresh") and cs4.get("state_key") in ("running", "idle", "waiting", "stopped"):
        status = cs4["state_key"]
    else:
        status = _job_status(has_output, last, False)
    if q_wait is not None:
        qline = "Image queue: " + str(q_wait) + " waiting · " + str(q_done) + " completed (wordplay-image-queue.md)"
    else:
        qline = str(queued_chips) + " image" + ("" if queued_chips == 1 else "s") + " still queued"
    lines = [qline, str(skipped) + " skipped · " + str(queued_chips) + " chips logged as queued", test_text,
             ("Backups: " + str(len(backups)) + " (latest " + backups[-1] + ")") if backups else "Backups: none yet"]
    _chat_extras(cs4, lines, alerts)
    if q_wait == 0 and not done:
        lines.append("Queue empty; DONE once chat-status/chat-4.md says state: done")
    return {
        "id": "wiring", "num": 4, "title": "4 · Wire Noun Bank", "pid": None, "alive": None,
        "status": status, "last_ts": last, "chat": _chat_line(4, cs4, "Wire Noun Bank"),
        "headline": str(len(wired_rows)) + " of " + str(WIRING_TO_WIRE) + " rows wired (" + str(wired_chips) + " chips)",
        "lines": lines,
        "alerts": alerts, "unit": "row", "value": len(wired_rows), "total": WIRING_TO_WIRE,
        "bar_key": "wiring", "born": born, "seed": None,
    }


# --- dynamic job cards (chat claims + chat-status files) ------------------------------------------
# Each chat's card follows its CURRENT job: the newest lane-claims file whose first token is "chatN"
# (by mtime) plus docs/play-on-words/chat-status/chat-N.md (README format). Finished / handed-off jobs
# (.done, .chatN-stopped, verify 31/31) leave the grid for the collapsed Done strip. Grok box runs
# (claims whose first line says "box (Grok)") get their own cards. Read-only: never writes job files.
CHAT_STATUS_DIR = PLAY_DIR / "chat-status"
CHAT_STATUS_FRESH_SECONDS = 45 * 60
RECHECK_BY = "antigravity-recheck"
_CHAT_STATE_MAP = {"running": "running", "idle": "idle", "waiting on samuel": "waiting", "waiting": "waiting",
                   "stopped": "stopped", "done": "done"}


def _chat_status(n: int) -> dict:
    p = CHAT_STATUS_DIR / ("chat-%d.md" % n)
    text = _read_text_cached(p)
    if not text:
        return {"exists": False}
    out = {"exists": True, "mtime": _mtime(p)}
    for ln in text.splitlines():
        s = ln.strip()
        if s.startswith("#") and "name" not in out:
            m = re.match(r"#+\s*Chat\s*\d+\s*[·:\-–]\s*(.+)", s, re.I)
            out["name"] = m.group(1).strip() if m else s.lstrip("# ").strip()
            continue
        m = re.match(r"([A-Za-z][A-Za-z ]{1,24}):\s*(.*)$", s)
        if m:
            out.setdefault(m.group(1).strip().lower(), m.group(2).strip())
    st = (out.get("state") or "").strip().lower()
    out["state_key"] = _CHAT_STATE_MAP.get(st) or next((v for k, v in _CHAT_STATE_MAP.items() if st.startswith(k)), None)
    out["fresh"] = bool(out["mtime"] and time.time() - out["mtime"] <= CHAT_STATUS_FRESH_SECONDS)
    return out


def _chat_line(n: int, cs: dict, label: str) -> str:
    base = "Anti-Gravity chat: " + str(n) + (" · " + label if label else "")
    if not cs.get("exists"):
        return base + " · no chat-status/chat-%d.md yet" % n
    upd = re.sub(r"^\d{4}-\d\d-\d\d[ T]", "", cs.get("updated") or "") or _et_label(cs.get("mtime")) or "?"
    return base + " · status: " + (cs.get("state") or "?") + " (updated " + upd + ("" if cs["fresh"] else ", stale") + ")"


def _chat_extras(cs: dict, lines: list, alerts: list) -> None:
    if not cs.get("exists"):
        return
    if cs.get("doing"):
        lines.insert(0, "Doing: " + cs["doing"][:200])
    if cs.get("progress"):
        lines.append("Status progress: " + cs["progress"][:160])
    prob = (cs.get("problems") or "").strip()
    if prob and prob.lower() not in ("none", "no", "-"):
        lines.append("Problems: " + prob[:160])
    need = (cs.get("needs samuel") or "").strip()
    if need and need.lower() not in ("no", "none", "-", "no."):
        alerts.insert(0, "Needs Samuel: " + need[:240])


def _all_claims() -> list:
    """Every lane-claims file with who/box classification (text cached by mtime)."""
    out = []
    try:
        entries = list(LANE_CLAIMS.iterdir())
    except OSError:
        return out
    for p in entries:
        name = p.name
        if name.startswith(".") and name.count(".") < 2:
            continue
        if "." not in name:
            continue
        stem, suffix = name.rsplit(".", 1)
        if suffix not in ("claim", "done") and not suffix.endswith("-stopped"):
            continue
        if stem.lower().startswith("tmp-"):
            continue  # box sync writes tmp-<artist>.claim then renames it; not a separate run
        text = _read_text_cached(p) or ""
        first = (text.splitlines() or [""])[0]
        toks = first.split()
        who = toks[0].strip(",;:").lower() if toks else ""
        out.append({"path": p, "stem": stem.lower(), "suffix": suffix, "text": text, "first": first,
                    "who": who, "box": "box (grok)" in first.lower(), "mtime": _mtime(p) or 0})
    return out


def _proper_artist(stem: str, q) -> str:
    low = stem.lower()
    for name in ((q or {}).get("vault") or {}):
        if name.lower() == low:
            return name
    for name in ((q or {}).get("list") or []):
        if (name or "").lower() == low:
            return name
    return " ".join(w[:1].upper() + w[1:] for w in stem.split(" "))


def _slug(s: str) -> str:
    return re.sub(r"[^a-z0-9$]+", "-", s.lower()).strip("-")


def _tagged_progress_rows(prog_text: str) -> list:
    """all-artists-progress.md rows carrying a [chatN-x] / [box-x] tag: artist, tag, before, after, unresolved, ts."""
    from datetime import datetime
    rows = []
    for line in (prog_text or "").splitlines():
        if not line.startswith("|") or "[" not in line:
            continue
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        m = re.match(r"(.+?)\s*\[([^\]]+)\]\s*$", cells[0])
        if not m or len(cells) < 4:
            continue
        ba = re.match(r"\s*(\d+)\s*->\s*(\d+)", cells[2])
        ts = None
        try:
            dt = datetime.strptime(cells[-1].strip(), "%Y-%m-%d %H:%M:%S")
            ts = (dt.replace(tzinfo=BOARD_TZ) if BOARD_TZ else dt).timestamp()
        except ValueError:
            pass
        rows.append({"artist": m.group(1).strip(), "tag": m.group(2).strip().lower(),
                     "before": int(ba.group(1)) if ba else None, "after": int(ba.group(2)) if ba else None,
                     "unres": int(cells[3]) if cells[3].isdigit() else None, "ts": ts})
    return rows


def _chat_summary(n: int, artist: str) -> dict:
    """*-chatN-summary.md for this artist: done before/after and its timestamp."""
    from datetime import datetime
    for p in sorted(PLAY_DIR.glob("*-chat%d-summary.md" % n)):
        text = _read_text_cached(p) or ""
        if artist.lower() not in "\n".join(text.splitlines()[:3]).lower():
            continue
        out = {"path": p}
        b = re.search(r"Done before[^:\n]*:\**\s*(\d+)", text, re.I)
        a = re.search(r"Done after[^:\n]*:\**\s*(\d+)", text, re.I)
        t = re.search(r"Timestamp:\**\s*(\d{4}-\d\d-\d\d[ T]\d\d:\d\d:\d\d)", text)
        out["before"] = int(b.group(1)) if b else None
        out["after"] = int(a.group(1)) if a else None
        if t:
            try:
                dt = datetime.strptime(t.group(1).replace("T", " "), "%Y-%m-%d %H:%M:%S")
                out["ts"] = (dt.replace(tzinfo=BOARD_TZ) if BOARD_TZ else dt).timestamp()
            except ValueError:
                pass
        return out
    return {}


def _claim_pid(text: str):
    m = re.search(r"PID:\s*(\d+)", text)
    return int(m.group(1)) if m else None


def _box_status(text: str) -> dict:
    line = next((ln for ln in text.splitlines() if ln.strip().lower().startswith("status:")), "")
    out = {"line": line}
    m = re.match(r"\s*status:\s*([a-z_]+)", line, re.I)
    out["state"] = m.group(1).lower() if m else None
    for k, v in re.findall(r"([A-Za-z0-9_]+)=('[^']*'|\S+)", line):
        out[k.lower()] = v.strip("'")
    m = re.search(r"(?:done|processed)[ =](\d+)/(\d+)", line)
    if m:
        out["done_n"], out["done_total"] = int(m.group(1)), int(m.group(2))
    return out


def _iso_ts(s):
    from datetime import datetime
    if not s:
        return None
    try:
        dt = datetime.fromisoformat(s)
    except ValueError:
        return None
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=BOARD_TZ) if BOARD_TZ else dt.astimezone()
    return dt.timestamp()


def _artist_card(num: int, cid: str, title: str, artist: str, q, base_status: str, lines: list, alerts: list,
                 chat: str, last, pid=None, alive=None) -> dict:
    cur = _artist_songs(artist, q)
    seed = _roster_window_seed(artist)
    start_ts = current_window()[0].timestamp()
    base = 0 if (cur["born"] is not None and cur["born"] >= start_ts) else seed
    return {
        "id": cid, "num": num, "title": title, "pid": pid, "alive": alive, "status": base_status,
        "last_ts": max([t for t in (last, cur["mtime"]) if t] or [0]) or None, "chat": chat,
        "headline": artist + " · " + str(cur["opened"]) + " / " + str(cur["vault"]) + " songs",
        "lines": lines, "alerts": alerts, "unit": "song", "value": cur["opened"], "total": cur["vault"],
        "bar_key": None, "base": base, "trend_metric": "artist:" + artist, "artist": artist,
    }


def _job_chat_lane(n: int, claims: list, q, prog_rows: list, done_out: list):
    """Generic single-artist chat lane (chat 2, 5, 6, ...): newest chatN claim + chat-N.md."""
    mine = [c for c in claims if c["who"] == "chat%d" % n and not c["box"]]
    cs = _chat_status(n)
    # finished / handed-off jobs -> Done strip
    for c in mine:
        if c["suffix"] == "claim":
            continue
        artist = _proper_artist(c["stem"], q)
        summ = _chat_summary(n, artist)
        tagged = [r for r in prog_rows if r["artist"].lower() == artist.lower() and r["tag"].startswith("chat%d" % n) and r["after"] is not None]
        last_row = max(tagged, key=lambda r: r["ts"] or 0) if tagged else None
        before = summ.get("before") if summ.get("before") is not None else (last_row["before"] if last_row else None)
        after = summ.get("after") if summ.get("after") is not None else (last_row["after"] if last_row else None)
        fin = summ.get("ts") or (last_row["ts"] if last_row else None) or c["mtime"]
        handed = c["suffix"].endswith("-stopped")
        nums = (str(before) + " → " + str(after) + " songs") if before is not None and after is not None else (
            str(_artist_songs(artist, q)["opened"]) + " songs")
        unres = last_row["unres"] if last_row and last_row["unres"] is not None else None
        done_out.append({"id": "chat%d:%s" % (n, _slug(artist)), "title": str(n) + " · " + artist + " lane",
                         "summary": nums + (" · " + str(unres) + " unresolved" if unres is not None else "") +
                                    (" · handed to the main run" if handed else " · done"),
                         "finished_ts": fin, "kind": "handed_off" if handed else "done"})
    active = sorted([c for c in mine if c["suffix"] == "claim"], key=lambda c: c["mtime"])
    finished_stems = {c["stem"] for c in mine if c["suffix"] != "claim"}
    lines, alerts = [], []
    if active:
        c = active[-1]
        artist = _proper_artist(c["stem"], q)
        pid = _claim_pid(c["text"])
        alive = _pid_alive(pid) if pid else None
        cur_m = _mtime(NOTES_DIR / (c["stem"] + ".jsonl"))
        if cur_m and time.time() - cur_m <= JOB_IDLE_SECONDS:
            status = "running"
        elif alive:
            status = "running" if not cur_m else "idle"
        else:
            status = "idle" if cur_m else "not_started"
        if cs.get("fresh") and cs.get("state_key") in ("waiting", "stopped"):
            status = cs["state_key"]
        lines.append(("PID " + str(pid) + (" alive" if alive else (" not running" if alive is False else " unknown"))) if pid else "PID: none recorded")
        cand = PLAY_DIR / (_slug(artist).replace("$", "s") + "-candidates.jsonl")
        if not cand.exists():
            cand = PLAY_DIR / (c["stem"].replace(" ", "-") + "-candidates.jsonl")
        if cand.exists():
            sf = sum(1 for r in _read_jsonl_cached(cand) if r.get("signal_type") == "sound_flip")
            lines.append(str(sf) + " sound_flip candidate" + ("" if sf == 1 else "s") + " in " + cand.name)
        if len(active) > 1:
            lines.append("Also claimed: " + ", ".join(_proper_artist(o["stem"], q) for o in active[:-1]))
        _chat_extras(cs, lines, alerts)
        card = _artist_card(n, "chat%d:%s" % (n, _slug(artist)), str(n) + " · " + artist, artist, q, status, lines, alerts,
                            _chat_line(n, cs, ""), max(c["mtime"], cs.get("mtime") or 0), pid, alive)
        return card
    # No active claim: the status file may already name the next artist (not claimed yet).
    name = (cs.get("name") or "").strip()
    if name and name.lower() not in finished_stems:
        vault = (q or {}).get("vault") or {}
        hit = next((a for a in vault if a.lower() == name.lower()), None)
        if hit:
            lines.append("Waiting for lane-claims/" + hit.lower() + ".claim")
            _chat_extras(cs, lines, alerts)
            st = cs.get("state_key") if cs.get("fresh") and cs.get("state_key") in ("waiting", "stopped") else "not_started"
            return _artist_card(n, "chat%d:%s" % (n, _slug(hit)), str(n) + " · " + hit, hit, q, st, lines, alerts,
                                _chat_line(n, cs, ""), cs.get("mtime"))
    if cs.get("exists") and cs.get("state_key") != "done":
        _chat_extras(cs, lines, alerts)
        return {"id": "chat%d" % n, "num": n, "title": str(n) + " · " + (name or "Chat " + str(n)), "pid": None, "alive": None,
                "status": cs.get("state_key") or "unknown", "last_ts": cs.get("mtime"), "chat": _chat_line(n, cs, ""),
                "headline": cs.get("doing") or "No active claim", "lines": lines[1:] if lines and lines[0].startswith("Doing:") else lines,
                "alerts": alerts, "unit": "item", "value": 0, "total": 0, "bar_key": None, "base": 0}
    return None


def _verify_done_entry(done_out: list) -> None:
    """Chat 2's first job: verify the 31 possibles (done when every input row has a verdict)."""
    inp = _read_jsonl_cached(VERIFY_INPUT)
    vtotal = len({r.get("id") for r in inp if r.get("id")}) or len(inp)
    verdicts: dict = {}
    for r in _read_jsonl_cached(VERIFIED_FILE):
        rid = r.get("id") or r.get("bar")
        if rid and r.get("verdict"):
            verdicts[rid] = str(r.get("verdict")).strip().upper()
    vn = len(verdicts)
    if not vtotal or vn < vtotal:
        return
    vc = sum(1 for v in verdicts.values() if v == "CONFIRMED")
    vr = sum(1 for v in verdicts.values() if v == "REJECTED")
    done_out.append({"id": "chat2:verify", "title": "2 · Verify Possibles",
                     "summary": "%d/%d · %d confirmed, %d rejected, %d unsure" % (vn, vtotal, vc, vr, max(0, vn - vc - vr)),
                     "finished_ts": _mtime(VERIFIED_FILE), "kind": "done"})


def _job_box(c: dict, q) -> dict:
    artist = _proper_artist(c["stem"], q)
    bs = _box_status(c["text"])
    synced = _iso_ts(bs.get("synced"))
    upd = _iso_ts(bs.get("runner_updated") or bs.get("updated"))
    lines, alerts = [], []
    if bs.get("state") in ("running",):
        status = "running" if synced and time.time() - synced <= JOB_IDLE_SECONDS else "idle"
    elif bs.get("state") in ("finished", "done"):
        status = "done"
    elif bs.get("state") in ("stopped", "crashed", "error"):
        status = "stopped"
    else:
        status = "idle" if bs.get("state") else "unknown"
    lines.append("Last sync: " + (_et_label(synced) or "never") + (" · runner updated " + _et_label(upd) if upd else ""))
    bits = []
    if bs.get("delay"):
        bits.append("delay " + bs["delay"])
    if bs.get("429s") is not None:
        bits.append("429s " + bs["429s"])
    if bs.get("unresolved") is not None:
        bits.append(bs["unresolved"] + " unresolved")
    if bs.get("requests"):
        bits.append(bs["requests"] + " requests")
    if bits:
        lines.append("Box runner: " + " · ".join(bits))
    if bs.get("done_n") is not None:
        lines.append("Runner count: " + str(bs["done_n"]) + "/" + str(bs["done_total"]) + " processed" +
                     (" · last song: " + bs["last_song"][:60] if bs.get("last_song") else ""))
    if synced and status == "idle":
        alerts.append("No sync from the box for " + str(int((time.time() - synced) // 60)) + " min")
    try:
        if int(bs.get("429s") or 0) > 0:
            alerts.append(bs["429s"] + " rate-limit (429) responses on the box")
    except ValueError:
        pass
    tag = re.search(r"\[(box-[^\]]+)\]", c["first"])
    card = _artist_card(90, "box:" + _slug(artist), "G · " + artist + " (Grok box)", artist, q, status, lines, alerts,
                        "Grok box run" + (" [" + tag.group(1) + "]" if tag else "") + " · lane-claims/" + c["path"].name,
                        max([t for t in (synced, c["mtime"]) if t] or [0]) or None)
    return card


def _box_done_entry(c: dict, q) -> dict:
    artist = _proper_artist(c["stem"], q)
    bs = _box_status(c["text"])
    n, tot = bs.get("done_n"), bs.get("done_total")
    try:
        unres = int(bs.get("unresolved")) if bs.get("unresolved") is not None else None
    except ValueError:
        unres = None
    if n is not None and unres is not None:
        summary = "%d/%d resolved · %d unresolved" % (n - unres, tot, unres)
    elif n is not None:
        summary = "%d/%d processed" % (n, tot)
    else:
        cur = _artist_songs(artist, q)
        summary = "%d/%d songs" % (cur["opened"], cur["vault"])
    fin = _iso_ts(bs.get("updated") or bs.get("runner_updated")) or _iso_ts(bs.get("synced")) or c["mtime"]
    return {"id": "box:" + _slug(artist), "title": artist + " (Grok box)", "summary": summary, "finished_ts": fin, "kind": "done"}


def _job_recheck() -> dict:
    """Chat 7: re-review verdicts by antigravity-recheck against the backlog (unconfirmed + unsure)."""
    cs = _chat_status(7)
    rows = _read_jsonl_cached(RECHECK_FILE)
    latest: dict = {}
    for r in rows:
        if str(r.get("by") or "").strip().lower() != RECHECK_BY:
            continue
        v = str(r.get("verdict") or "").strip().upper()
        if v not in RECHECK_VERDICTS:
            continue
        latest[(str(r.get("key_artist")), str(r.get("key_song")), str(r.get("key_bar")))] = (v, _iso_ts(r.get("ts")))
    counts = {k: sum(1 for v, _ in latest.values() if v == k) for k in RECHECK_VERDICTS}
    n = len(latest)
    start_ts = current_window()[0].timestamp()
    new = sum(1 for _, t in latest.values() if t and t >= start_ts)
    backlog = None
    try:
        cc = catch_counts()
        if cc.get("ok"):
            c = cc.get("counts") or {}
            backlog = (int(c.get("unconfirmed") or 0), int(c.get("unsure") or 0))
    except Exception:
        backlog = None
    last = max([t for t in (_mtime(RECHECK_FILE), cs.get("mtime")) if t] or [0]) or None
    if cs.get("fresh") and cs.get("state_key"):
        status = cs["state_key"]
    elif last and time.time() - last <= 20 * 60:
        status = "running"
    else:
        status = "idle" if rows else "not_started"
    lines, alerts = [], []
    if backlog is not None:
        lines.append("Backlog: " + str(sum(backlog)) + " line" + ("" if sum(backlog) == 1 else "s") + " with no verdict yet (" +
                     str(backlog[0]) + " unconfirmed + " + str(backlog[1]) + " unsure)")
    else:
        lines.append("Backlog: unknown (catch counts unavailable)")
    lines.append("Verdicts by " + RECHECK_BY + " in recheck.jsonl (latest per line)")
    _chat_extras(cs, lines, alerts)
    total = n + (sum(backlog) if backlog else 0)
    return {
        "id": "recheck", "num": 7, "title": "7 · Re-review", "pid": None, "alive": None, "status": status,
        "last_ts": last, "chat": _chat_line(7, cs, ""),
        "headline": str(n) + " verdicts · " + str(counts["KEEP"]) + " KEEP · " + str(counts["FIX"]) + " FIX · " + str(counts["REJECT"]) + " REJECT",
        "lines": lines, "alerts": alerts, "unit": "verdict", "value": n, "total": total,
        "bar_key": None, "base": max(0, n - new),
    }


def _queue_counts():
    """wordplay-image-queue.md: (waiting rows before '## Completed', completed rows after)."""
    text = _read_text_cached(WIRING_QUEUE)
    if text is None:
        return None, None
    waiting = completed = 0
    in_done = False
    for ln in text.splitlines():
        if ln.startswith("#") and "complet" in ln.lower():
            in_done = True
            continue
        if not ln.startswith("|"):
            continue
        cells = [c.strip() for c in ln.strip().strip("|").split("|")]
        if not cells or set("".join(cells)) <= set("-: ") or cells[0].lower() == "noun":
            continue
        if in_done:
            completed += 1
        else:
            waiting += 1
    return waiting, completed


def _job_error(num: int, jid: str, title: str, exc: Exception) -> dict:
    return {"id": jid, "num": num, "title": title, "pid": None, "alive": None, "status": "unknown",
            "last_ts": None, "headline": "Reader error", "lines": [], "alerts": [str(exc)[:200]],
            "unit": "item", "value": 0, "total": 0, "bar_key": None, "born": None, "seed": None}


AI_ANTIGRAVITY = "Anti-Gravity"
AI_GROK_BOX = "Grok box"


def _job_ai(j: dict):
    """Which AI is running a Jobs card / Done entry, from its source (not its title).
    Box claims ("box (Grok)" -> ids box:*) -> Grok box. Chat-status / claim cards owned by chatN or an
    Anti-Gravity chat (numbered cards 1-89 = Anti-Gravity chat N, chat line "Anti-Gravity chat: N") -> Anti-Gravity."""
    if j.get("ai"):
        return j["ai"]
    jid, chat = str(j.get("id") or ""), str(j.get("chat") or "")
    if jid.startswith("box:") or chat.startswith("Grok box"):
        return AI_GROK_BOX
    if re.match(r"chat\d+(:|$)", jid) or chat.startswith("Anti-Gravity"):
        return AI_ANTIGRAVITY
    num = j.get("num")
    if isinstance(num, int) and 1 <= num < 90:
        return AI_ANTIGRAVITY
    return None


def _title_with_ai(j: dict) -> None:
    ai = _job_ai(j)
    if not ai:
        return
    j["ai"] = ai
    t = str(j.get("title") or "")
    if not t.lower().endswith("(" + ai.lower() + ")"):
        j["title"] = (t + " (" + ai + ")").strip()


def _build_jobs() -> dict:
    q = _main_queue()
    prog_rows, prog_text = _progress_md_rows()
    try:
        main = _job_main(q, prog_rows, prog_text)
    except Exception as exc:
        main = _job_error(1, "main", "1 · Main Run", exc)
    try:
        cs1 = _chat_status(1)
        if cs1.get("exists") and main.get("headline") != "Reader error":
            main["chat"] = _chat_line(1, cs1, "Main Run")
            _chat_extras(cs1, main.setdefault("lines", []), main.setdefault("alerts", []))
    except Exception:
        pass
    jobs = [main]
    done_strip: list = []
    claims = _all_claims()
    tagged = _tagged_progress_rows(prog_text)

    def lane2():
        j = _job_lane2(q, main.get("main_idx"), main.get("main_artist"))
        cs3 = _chat_status(3)
        if cs3.get("exists"):
            j["chat"] = _chat_line(3, cs3, "Lane 2")
            _chat_extras(cs3, j["lines"], j["alerts"])
        return j
    builders = [(3, "lane2", "3 · Lane 2", lane2), (4, "wiring", "4 · Wire Noun Bank", _job_wiring),
                (7, "recheck", "7 · Re-review", _job_recheck)]
    special = {1, 3, 4, 7}
    chat_nums = set()
    for c in claims:
        m = re.fullmatch(r"chat(\d+)", c["who"])
        if m and not c["box"]:
            chat_nums.add(int(m.group(1)))
    try:
        for p in CHAT_STATUS_DIR.glob("chat-*.md"):
            m = re.fullmatch(r"chat-(\d+)\.md", p.name)
            if m:
                chat_nums.add(int(m.group(1)))
    except OSError:
        pass
    for n in sorted(chat_nums - special):
        builders.append((n, "chat%d" % n, str(n) + " · Chat " + str(n), (lambda n=n: _job_chat_lane(n, claims, q, tagged, done_strip))))
    for c in sorted((c for c in claims if c["box"]), key=lambda c: c["stem"]):
        if c["suffix"] == "claim" and _box_status(c["text"]).get("state") not in ("finished", "done"):
            builders.append((90, "box:" + _slug(c["stem"]), "G · " + c["stem"], (lambda c=c: _job_box(c, q))))
        else:
            try:
                done_strip.append(_box_done_entry(c, q))
            except Exception:
                pass
    try:
        _verify_done_entry(done_strip)
    except Exception:
        pass
    for num, jid, title, fn in builders:
        try:
            j = fn()
        except Exception as exc:
            j = _job_error(num, jid, title, exc)
        if j is None:
            continue
        _title_with_ai(j)
        if j.get("status") == "done" and j.get("id") not in ("main", "lane2", "wiring", "recheck"):
            done_strip.append({"id": j["id"], "title": j["title"], "summary": str(j.get("headline") or ""),
                               "finished_ts": j.get("last_ts"), "kind": "done", "ai": j.get("ai")})
            continue
        jobs.append(j)
    for j in jobs:
        _title_with_ai(j)  # main card is added outside the builders loop
    jobs.sort(key=lambda j: (j["num"], j["title"]))
    items = {j["bar_key"]: (j["value"], j.get("born"), j.get("seed")) for j in jobs if j.get("bar_key") and j.get("base") is None}
    bases, window = _jobs_window(items)
    for j in jobs:
        total = int(j.get("total") or 0)
        value = min(int(j.get("value") or 0), total) if total else 0
        base = j["base"] if j.get("base") is not None else bases.get(j.get("bar_key"), value)
        new = max(0, min(value - int(base or 0), value))
        j["value"] = value
        j["new"] = new
        j["pct"] = round(value / total * 100, 2) if total else 0
        j["new_pct"] = round(new / total * 100, 2) if total else 0
        j["base_pct"] = round((value - new) / total * 100, 2) if total else 0
        j["last_label"] = _et_label(j.get("last_ts"))
        for k in ("born", "seed", "main_idx", "main_artist", "base"):
            j.pop(k, None)
    seen_done = set()
    done_list = []
    for d in sorted(done_strip, key=lambda d: -(d.get("finished_ts") or 0)):
        if d["id"] in seen_done:
            continue
        seen_done.add(d["id"])
        _title_with_ai(d)
        d["finished_label"] = _et_label(d.get("finished_ts"))
        done_list.append(d)
    now = time.time()
    active = sum(1 for j in jobs if j.get("status") not in ("done",))
    return {"jobs": jobs, "done": done_list, "active": active, "window": window, "generated": now,
            "generated_label": _et_label(now), "queue_exact": bool(q and q.get("exact"))}


def jobs_snapshot() -> dict:
    now = time.time()
    cached = _JOBS_CACHE["payload"]
    if cached and now - _JOBS_CACHE["at"] < JOBS_CACHE_SECONDS:
        return cached
    if not _JOBS_LOCK.acquire(blocking=cached is None):
        return cached
    try:
        payload = _build_jobs()
        _JOBS_CACHE.update(at=time.time(), payload=payload)
        return payload
    finally:
        _JOBS_LOCK.release()


NOTE_RELOAD_SECONDS = 30


class Board:
    def __init__(self) -> None:
        self.gen = 0
        self.payload: dict = {}
        self.baseline: set[str] | None = None
        self.landed: dict[str, float] = {}
        self.note_cache_key = None
        self.notes: list[dict] = []
        self.index: dict[str, list[int]] = {}
        self.chat_key = None
        self.chat_info: dict = {"sentence": "", "age": None, "batch": []}
        self.takeover_info: dict = takeover_snapshot()
        self.swift_key = None
        self.notes_loaded_at = 0.0

    def refresh(self) -> dict:
        if not REFRESH_LOCK.acquire(blocking=not self.payload):
            return self.payload
        try:
            return self._refresh()
        finally:
            REFRESH_LOCK.release()

    def _refresh(self) -> dict:
        progress = [dict(row) for row in load_artist_progress()]
        roster = load_roster()
        window = apply_window(progress, roster["rows"])
        for r in roster["rows"]:
            r.pop("log_born", None)
        try:
            ppl = merge_roster_people(roster["rows"]) if roster.get("ready") else {"rows": [], "counts": {}}
            roster["people"], roster["people_counts"] = ppl["rows"], ppl["counts"]
        except Exception as exc:  # never break the board over the person view
            roster["people"], roster["people_counts"], roster["people_error"] = [], {}, str(exc)
        try:
            watch = merge_watch_people(progress)
        except Exception:
            watch = progress
        self.watch = watch
        roster["sig"] = hashlib.md5(json.dumps([roster["rows"], roster["people"]], sort_keys=True, default=str).encode("utf-8")).hexdigest()
        roster["counts"] = {k: sum(1 for r in roster["rows"] if r["state"] == k) for k in ("in_progress", "not_started", "completed")}
        self.roster = roster
        self.takeover_info = takeover_snapshot()
        note_key = tuple(
            (path.name, path.stat().st_mtime if path.exists() else 0)
            for path in CLICK_LOGS.values()
        )
        # Re-index Genius notes at most every NOTE_RELOAD_SECONDS while a log is being
        # appended to (progress/points above are still read live, from a per-file cache).
        if note_key != self.note_cache_key and (
            self.note_cache_key is None or time.time() - self.notes_loaded_at >= NOTE_RELOAD_SECONDS
        ):
            self.notes_loaded_at = time.time()
            self.notes = load_notes(list(CLICK_LOGS.values()))
            self.index = build_index(self.notes)
            self.note_cache_key = note_key
            self.swift_key = None

        chat_key = HARNESS_CHAT.stat().st_mtime if HARNESS_CHAT.exists() else 0
        if chat_key != self.chat_key:
            self.chat_info = harness_snapshot()
            self.chat_key = chat_key
            self.swift_key = None

        swift_key = tuple(
            path.stat().st_mtime if path.exists() else 0
            for path in (SECTIONS, STORE, BRIEFS, CATALOG)
        )
        if swift_key == self.swift_key and self.payload:
            self.payload["harness"]["age"] = self.chat_info.get("age")
            self.payload["progress"] = progress
            self.payload["watch"] = watch
            self.payload["window"] = window
            self.payload["roster"] = roster
            self.payload["takeover"] = self.takeover_info
            self.payload["live"] = self._live()
            return self.payload

        try:
            sections = parse_sections(SECTIONS.read_text(encoding="utf-8", errors="replace"))
            store_words = parse_store(STORE.read_text(encoding="utf-8", errors="replace"))
            briefs = parse_pairs(collection_body(BRIEFS.read_text(encoding="utf-8", errors="replace"), "private static let wordplay"))
            partners = parse_pairs(
                collection_body(CATALOG.read_text(encoding="utf-8", errors="replace"), "private static let mentionPartnerTable")
            )
        except (OSError, ValueError) as exc:
            if self.payload:
                self.payload["parse_error"] = str(exc)
                self.payload["live"] = self._live()
                return self.payload
            raise

        store_set = {normalize(w) for w in store_words}
        section_order: list[tuple[str, str]] = []
        seen = set()
        for title, words in sections:
            for word in words:
                key = normalize(word)
                if key in seen:
                    continue
                seen.add(key)
                section_order.append((title, word))
        for word in store_words:
            key = normalize(word)
            if key in seen:
                continue
            seen.add(key)
            section_order.append(("In the store only", word))

        if self.baseline is None:
            self.baseline = set(seen)

        now = time.time()
        chips = []
        counts = {
            "Both on the line": 0,
            "Partner filed": 0,
            "Other half missing": 0,
            "Needs a look": 0,
        }
        for title, word in section_order:
            key = normalize(word)
            brief = (briefs.get(key) or [""])[0]
            partner = partners.get(key) or []
            note = best_note(key, brief, partner, self.notes, self.index)
            kind = classify(word, brief, note)
            labels = check_labels(key, brief, partner, note, key in store_set, title != "In the store only")
            needs = any(label in NEEDS for label in labels)
            if not partner:
                pair = "missing"
                counts["Other half missing"] += 1
            elif both_halves_on_line(partner, note):
                pair = "both"
                counts["Both on the line"] += 1
            else:
                pair = "filed"
                counts["Partner filed"] += 1
            if needs:
                counts["Needs a look"] += 1
            if key not in self.baseline and key not in self.landed:
                self.landed[key] = now
            chips.append(
                {
                    "chip": word,
                    "key": key,
                    "section": title,
                    "kind": kind,
                    "pair": pair,
                    "flip": hidden_flip(brief),
                    "labels": labels,
                    "needs": needs,
                    "brief": brief,
                    "partner": ", ".join(partner),
                    "new": key in self.landed,
                    "landed": self.landed.get(key, 0),
                    "note": None
                    if note is None
                    else {
                        "artist": note["artist"],
                        "song": note["song"],
                        "line": note["line"],
                        "meaning": note["meaning"][:900],
                        "votes": note["votes"],
                        "state": note["state"],
                        "strength": note["strength"],
                        "url": note["url"],
                    },
                }
            )

        batch = []
        by_key = {chip["key"]: chip for chip in chips}
        for row in self.chat_info.get("batch") or []:
            key = normalize(row["chip"])
            filed = by_key.get(key)
            batch.append({**row, "in_bank": filed is not None, "kind": filed["kind"] if filed else "", "needs": bool(filed and filed["needs"])})

        swift_age = now - max(swift_key)
        chips_sig = hashlib.md5(json.dumps(chips, sort_keys=True, default=str).encode("utf-8")).hexdigest()
        self.gen += 1
        self.payload = {
            "gen": self.gen,
            "chips": chips,
            "chips_sig": chips_sig,
            "counts": counts,
            "total": len(chips),
            "store": len(store_set),
            "section": sum(len(words) for _, words in sections),
            "notes": len(self.notes),
            "just_landed": sum(1 for chip in chips if chip["new"]),
            "batch": batch,
            "progress": progress,
            "watch": watch,
            "window": window,
            "roster": roster,
            "takeover": self.takeover_info,
            "harness": {
                "name": "Penwork Play on Words Genius Harness",
                "sentence": self.chat_info.get("sentence") or "",
                "age": self.chat_info.get("age"),
                "swift_age": swift_age,
            },
            "live": self._live(swift_age),
            "parse_error": "",
        }
        self.swift_key = swift_key
        return self.payload

    def _live(self, swift_age: float | None = None) -> bool:
        ages = []
        if swift_age is not None:
            ages.append(swift_age)
        elif self.payload.get("harness", {}).get("swift_age") is not None:
            ages.append(self.payload["harness"]["swift_age"])
        chat_age = self.chat_info.get("age")
        if chat_age is not None:
            ages.append(chat_age)
        return any(age < 120 for age in ages)


