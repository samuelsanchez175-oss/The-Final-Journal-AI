def _job_status(has_output: bool, last_ts, done: bool, alive=None) -> str:
    if done:
        return "done"
    if alive is False and has_output:
        return "stopped"
    if not has_output:
        return "running" if alive else "not_started"
    if last_ts and time.time() - last_ts > JOB_IDLE_SECONDS:
        return "idle"
    return "running"


