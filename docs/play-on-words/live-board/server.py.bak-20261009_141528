def normalize(word: str) -> str:
    text = unicodedata.normalize("NFKD", word)
    text = "".join(ch for ch in text if not unicodedata.combining(ch))
    text = text.lower().replace("\u2019", "").replace("'", "")
    text = re.sub(r"[^a-z0-9\s]", " ", text)
    return " ".join(text.split())


def content_tokens(text: str) -> list[str]:
    return [t for t in normalize(text).split() if t not in STOP and len(t) > 2]


def soundex(word: str) -> str:
    cleaned = re.sub(r"[^a-z]", "", normalize(word))
    if not cleaned:
        return ""
    coded = cleaned[0] + cleaned[1:].translate(SOUNDEX_MAP)
    squashed = coded[0]
    for ch in coded[1:]:
        if ch != squashed[-1] and ch != "0":
            squashed += ch
    return (squashed + "000")[:4]


def skeleton(word: str) -> str:
    cleaned = re.sub(r"[^a-z]", "", normalize(word))
    return re.sub(r"[aeiouy]", "", cleaned)


def edit_distance(left: str, right: str) -> int:
    if abs(len(left) - len(right)) > 2:
        return 9
    prev = list(range(len(right) + 1))
    for i, ca in enumerate(left, 1):
        cur = [i]
        for j, cb in enumerate(right, 1):
            cur.append(min(prev[j] + 1, cur[-1] + 1, prev[j - 1] + (ca != cb)))
        prev = cur
    return prev[-1]


def sounds_alike(left: str, right: str) -> bool:
    a = [t for t in content_tokens(left) if len(t) > 2]
    b = [t for t in content_tokens(right) if len(t) > 2]
    if not a or not b:
        return False
    for x in a:
        for y in b:
            if x == y:
                continue
            if soundex(x) == soundex(y) and soundex(x):
                return True
            if edit_distance(x, y) <= 2:
                return True
            sx, sy = skeleton(x), skeleton(y)
            if len(sx) >= 3 and len(sy) >= 3 and (sx[:3] == sy[:3] or sx in sy or sy in sx):
                return True
    return False


def swift_strings(block: str) -> list[str]:
    out: list[str] = []
    i = 0
    n = len(block)
    while i < n:
        if block[i] != '"':
            i += 1
            continue
        j = i + 1
        chars: list[str] = []
        closed = False
        while j < n:
            c = block[j]
            if c == "\\":
                if j + 1 < n:
                    chars.append(block[j + 1])
                    j += 2
                    continue
            if c == '"':
                out.append("".join(chars))
                i = j + 1
                closed = True
                break
            chars.append(c)
            j += 1
        if not closed:
            break
    return out


def case_block(text: str, name: str) -> str | None:
    key = f"case .{name}:"
    i = text.find(key)
    if i < 0:
        return None
    rest = text[i + len(key) :]
    m = re.search(r"\n        case \.", rest)
    return rest[: m.start()] if m else rest


def parse_sections(text: str) -> list[tuple[str, list[str]]]:
    block = case_block(text, "wordplay")
    if block is None:
        raise ValueError("wordplay case missing in sections")
    found = []
    for match in re.finditer(
        r'NounChipSection\(title:\s*"((?:\\.|[^"\\])*)",\s*words:\s*\[(.*?)\]\s*\)',
        block,
        re.S,
    ):
        title = match.group(1).replace('\\"', '"')
        words = swift_strings(match.group(2))
        if words:
            found.append((title, words))
    if not found:
        raise ValueError("no wordplay sections")
    return found


def parse_store(text: str) -> list[str]:
    key = "case .wordplay:"
    start = 0
    while True:
        i = text.find(key, start)
        if i < 0:
            raise ValueError("wordplay store list missing")
        rest = text[i + len(key) :]
        match = re.search(r"\n        case \.", rest)
        block = rest[: match.start()] if match else rest
        open_at = block.find("[")
        close_at = block.rfind("]")
        if open_at >= 0 and close_at > open_at:
            words = swift_strings(block[open_at : close_at + 1])
            if words:
                return words
        start = i + len(key)


def collection_body(text: str, marker: str) -> str:
    """Body of a Swift array or dictionary written with square brackets."""
    i = text.find(marker)
    if i < 0:
        raise ValueError(f"missing {marker}")
    match = re.search(r"=\s*\[", text[i:])
    if not match:
        raise ValueError(f"missing collection after {marker}")
    a = i + match.end() - 1
    depth = 0
    in_string = False
    j = a
    while j < len(text):
        char = text[j]
        if in_string:
            if char == "\\":
                j += 2
                continue
            if char == '"':
                in_string = False
            j += 1
            continue
        if char == '"':
            in_string = True
            j += 1
            continue
        if char == "[":
            depth += 1
        elif char == "]":
            depth -= 1
            if depth == 0:
                return text[a + 1 : j]
        j += 1
    raise ValueError(f"unclosed collection after {marker}")


def parse_pairs(body: str) -> dict[str, list[str]]:
    """Swift dictionary of string -> string or string -> [string]."""
    pairs: dict[str, list[str]] = {}
    i = 0
    n = len(body)
    while i < n:
        if body[i] != '"':
            i += 1
            continue
        key, i = read_swift_string(body, i)
        while i < n and body[i] in " \t\r\n":
            i += 1
        if i >= n or body[i] != ":":
            continue
        i += 1
        while i < n and body[i] in " \t\r\n":
            i += 1
        if i < n and body[i] == "[":
            end = body.find("]", i)
            if end < 0:
                break
            pairs[normalize(key)] = swift_strings(body[i : end + 1])
            i = end + 1
        elif i < n and body[i] == '"':
            value, i = read_swift_string(body, i)
            pairs[normalize(key)] = [value]
        else:
            i += 1
    return pairs


def read_swift_string(text: str, i: int) -> tuple[str, int]:
    if text[i] != '"':
        raise ValueError("expected string")
    j = i + 1
    chars: list[str] = []
    while j < len(text):
        c = text[j]
        if c == "\\":
            if j + 1 < len(text):
                chars.append(text[j + 1])
                j += 2
                continue
        if c == '"':
            return "".join(chars), j + 1
        chars.append(c)
        j += 1
    raise ValueError("unclosed string")


def clean_song(song: str, artist: str) -> str:
    text = TAG_RE.sub("", song or "")
    text = text.replace("\u2019", "'")
    if artist and artist in text:
        text = text.replace(artist, " ", 1)
    text = VIEW_RE.sub("", text)
    text = " ".join(text.split())
    return text or "Untitled song"


def load_notes(paths: list[Path]) -> list[dict]:
    notes = []
    for path in paths:
        if not path.exists():
            continue
        with path.open(encoding="utf-8", errors="replace") as handle:
            for line in handle:
                line = line.strip()
                if not line:
                    continue
                try:
                    row = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if row.get("type") not in (None, "line"):
                    continue
                lyric = row.get("line") or ""
                meaning = row.get("meaning") or ""
                artist = row.get("artist") or ""
                notes.append(
                    {
                        "id": str(row.get("annotation_id") or ""),
                        "artist": artist,
                        "song": clean_song(row.get("song") or "", artist),
                        "line": lyric,
                        "line_norm": normalize(lyric),
                        "meaning": meaning,
                        "votes": int(row.get("votes") or 0),
                        "state": row.get("state") or "",
                        "strength": row.get("strength") or "",
                        "url": row.get("url") or "",
                    }
                )
    return notes


