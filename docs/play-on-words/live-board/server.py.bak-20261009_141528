def _roster_window_seed(artist: str):
    """The roster's own window baseline for an artist (read-only), so job bars agree with the roster."""
    try:
        saved = json.loads(_read_text_cached(WINDOW_FILE) or "{}")
    except ValueError:
        return None
    if saved.get("window_start") != current_window()[0].isoformat():
        return None
    hit = (saved.get("artists") or {}).get(artist)
    return int(hit.get("opened", 0)) if isinstance(hit, dict) else None


def _job_main(q, prog_rows, prog_text) -> dict:
    alive = _pid_alive(MAIN_RUN_PID, MAIN_RUN_NEEDLE)
    queue = q["list"] if q else []
    main_done = {r["artist"].lower() for r in prog_rows if not r["lane"]}
    finished = sum(1 for a in queue if (a or "").lower() in main_done)
    idx = next((i for i, a in enumerate(queue) if (a or "").lower() not in main_done), None)
    current = queue[idx] if idx is not None else None
    cur = _artist_songs(current, q) if current else None
    stamps = [_mtime(ALL_ARTISTS_PROGRESS)]
    if cur:
        stamps += [cur["mtime"], _mtime(NOTES_DIR / (current.lower() + ".md"))]
    last = max([t for t in stamps if t] or [0]) or None
    done = bool(queue) and idx is None
    status = _job_status(bool(finished) or bool(cur and cur["exists"]), last, done, alive)
    signs = []
    n = len(RATE_RE.findall(prog_text or ""))
    if n:
        signs.append(str(n) + " rate-limit mention(s) in all-artists-progress.md")
    if current:
        unres = PLAY_DIR / (current.lower().replace(" ", "-") + "-unresolved.jsonl")
        rl = sum(1 for r in _read_jsonl_cached(unres) if "rate" in str(r.get("reason", "")).lower())
        if rl:
            signs.append(str(rl) + " song(s) unresolved as rate_limited")
    if alive and last and time.time() - last > JOB_429_HINT_SECONDS:
        signs.append("no write for " + str(int((time.time() - last) // 60)) + " min (a 429 sleep is 15 min; its log goes to a terminal, not a file)")
    alerts = list(signs)
    if alive is False and not done:
        alerts.insert(0, "PID " + str(MAIN_RUN_PID) + " is not running")
    lines = [
        ("Artist " + str(idx + 1) + " of " + str(len(queue)) if idx is not None else "Queue finished") +
        " · " + str(finished) + " of " + str(len(queue)) + " artists finished",
        "PID " + str(MAIN_RUN_PID) + (" alive" if alive else (" not running" if alive is False else " unknown")),
        "429 / rate limit: " + ("none seen" if not signs else "see warning"),
    ]
    return {
        "id": "main", "num": 1, "title": "1 · Main Run", "pid": MAIN_RUN_PID, "alive": alive,
        "status": status, "last_ts": last,
        "headline": (current + " · " + str(cur["opened"]) + " / " + str(cur["vault"]) + " songs") if cur else "All queued artists finished",
        "lines": lines, "alerts": alerts, "unit": "song",
        "value": cur["opened"] if cur else 0, "total": cur["vault"] if cur else 0,
        "bar_key": "main:" + (current or "-"), "born": cur["born"] if cur else None,
        "seed": _roster_window_seed(current) if current else None,
        "main_idx": idx, "main_artist": current,
    }


def _lane2_claims(q) -> list:
    out = []
    try:
        entries = list(LANE_CLAIMS.iterdir())
    except OSError:
        entries = []
    for p in entries:
        if p.suffix not in (".claim", ".done"):
            continue
        text = _read_text_cached(p) or ""
        toks = text.split()
        who = toks[0].strip(",;:").lower() if toks else "lane2"
        m = re.search(r"PID:\s*(\d+)", text)
        stem = p.stem.lower()
        pos = q["last"].get(stem) if q else None
        idx = re.search(r"Index:\s*(\d+)", text)
        if idx:  # the lane's own queue index wins (same query as the main run)
            pos = int(idx.group(1))
        artist = p.stem
        if q and pos is not None and pos < len(q["list"]) and (q["list"][pos] or "").lower() == stem:
            artist = q["list"][pos]
        elif q and q["last"].get(stem) is not None:
            artist = q["list"][q["last"][stem]]
        out.append({"artist": artist, "stem": stem, "kind": p.suffix, "who": who,
                    "pid": int(m.group(1)) if m else None, "mtime": _mtime(p) or 0, "pos": pos})
    return out


def _job_lane2(q, main_idx, main_artist) -> dict:
    claims = [c for c in _lane2_claims(q) if c["who"] not in ("main", "box") and not c["who"].startswith("chat")]
    active = sorted([c for c in claims if c["kind"] == ".claim"], key=lambda c: c["mtime"])
    active_stems = {c["stem"] for c in active}
    finished = sorted([c for c in claims if c["kind"] == ".done" and c["stem"] not in active_stems], key=lambda c: c["mtime"])
    newest = max(claims, key=lambda c: c["mtime"]) if claims else None
    pid = newest["pid"] if newest else None
    alive = _pid_alive(pid) if pid else None
    claimed = active[-1] if active else None
    cur = _artist_songs(claimed["artist"], q) if claimed else None
    summary = _read_text_cached(LANE2_SUMMARY) or ""
    sum_m = _mtime(LANE2_SUMMARY)
    stamps = [newest["mtime"] if newest else None, sum_m, cur["mtime"] if cur else None]
    last = max([t for t in stamps if t] or [0]) or None
    done = bool(claims) and not active and not alive and bool(summary) and sum_m is not None and sum_m >= newest["mtime"] - 5
    status = _job_status(bool(claims), last, done, alive)
    alerts = []
    lines = [str(len(finished)) + " artist" + ("" if len(finished) == 1 else "s") + " finished" +
             (" (" + ", ".join(c["artist"] for c in finished[-3:]) + ")" if finished else "")]
    positions = [c["pos"] for c in claims if c["pos"] is not None]
    if positions and main_idx is not None:
        front = min(positions)
        sep = front - main_idx - 1
        lines.append("Gap to main run: " + str(sep) + " artists (needs ≥ " + str(LANE_BUFFER) + ") · lane 2 at #" +
                     str(front + 1) + ", main at #" + str(main_idx + 1))
        if sep < LANE_BUFFER:
            alerts.append("Main run is " + ("past lane-2 artists, stop the main run" if sep < 0 else "only " + str(sep) + " artists from lane 2"))
    else:
        lines.append("Gap to main run: lane 2 has not claimed an artist yet")
    lines.append(("PID " + str(pid) + (" alive" if alive else " not running")) if pid else "PID: none recorded yet")
    # The summary is written when the lane stops; an older one (from a run that was restarted) is ignored.
    if summary and newest and sum_m is not None and sum_m >= newest["mtime"] - 5:
        reason = re.search(r"\*\*Reason:\*\*\s*(.+)", summary)
        if reason:
            lines.append("Stop reason: " + reason.group(1).strip()[:160])
        claimed_m = re.search(r"\bM\s*=\s*(\d+)", summary)
        if claimed_m and main_idx is not None and done:
            m_val = int(claimed_m.group(1))
            if min(abs(m_val - main_idx), abs(m_val - (main_idx + 1))) > LANE_BUFFER:
                alerts.append("Lane 2 stopped saying the main run was at position " + str(m_val) +
                              ", but the main run is at #" + str(main_idx + 1) + " (" + (main_artist or "?") + "). False stop.")
        if re.search(r"Main Run Stop Required:\*\*\s*\**\s*YES", summary, re.I):
            lines.append("Lane 2's summary asks for the main run to be stopped")
    if claimed:
        headline = claimed["artist"] + " · " + str(cur["opened"]) + " / " + str(cur["vault"]) + " songs"
        value, total, key, born = cur["opened"], cur["vault"], "lane2:" + claimed["artist"], cur["born"]
    else:
        headline = "No artist claimed" + (" · lane stopped" if done else "")
        value = total = len(finished)
        key, born = "lane2:artists", None
    return {
        "id": "lane2", "num": 3, "title": "3 · Lane 2", "pid": pid, "alive": alive, "status": status,
        "last_ts": last, "headline": headline, "lines": lines, "alerts": alerts,
        "unit": "song" if claimed else "artist", "value": value, "total": total,
        "bar_key": key, "born": born, "seed": None,
    }


