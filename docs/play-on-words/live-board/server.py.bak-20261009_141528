const trendHist = new Map();      // metric -> {sig, pts: [[t_ms, value, rebuilt], ...]}
let trendModes = new Set();
try { trendModes = new Set(JSON.parse(localStorage.getItem(TREND_STORE) || "[]")); } catch (e) { trendModes = new Set(); }
