    minus songs already resolved (opened) in the log."""
    upath = ROOT / "docs/play-on-words" / (artist.lower().replace(" ", "-") + "-unresolved.jsonl")
    key = (_progress_file_key(path), _progress_file_key(upath))
    hit = _UNRES_LEFT_CACHE.get(artist)
