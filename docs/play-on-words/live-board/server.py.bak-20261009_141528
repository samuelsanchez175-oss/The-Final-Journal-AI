def _candidate_state(r: dict) -> str:
    """kept / rejected / pending for one sound_flip candidate row. 'kept' matches _candidate_confirmed."""
    kept = r.get("kept") is True or str(r.get("status", "")).lower() == "kept" or (
        "kept" not in r and "reject_reason" in r and not r.get("reject_reason"))
    if kept:
        return "kept"
    if r.get("reject_reason") or r.get("kept") is False or str(r.get("status", "")).lower() == "rejected":
        return "rejected"
    return "pending"


