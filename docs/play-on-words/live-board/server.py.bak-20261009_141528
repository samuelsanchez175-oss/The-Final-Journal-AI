    if _QUEUE["key"] != key and not _QUEUE["loading"] and key is not None:
        _QUEUE["loading"] = True
        threading.Thread(target=_load_main_queue_worker, args=(key,), daemon=True).start()
    queue = _QUEUE["list"]
    exact = queue is not None
    if queue is None:
        if artists is None:
            return None
        queue = list(MAIN_RUN_PRIORITY)
        seen = set(queue)
        for item in artists:
            if item["artist"] in MAIN_RUN_HANDLED or item["artist"] in seen:
                continue
            queue.append(item["artist"])
            seen.add(item["artist"])
    built = _QUEUE.get("built")
    if built and built["src"] is queue and built["artists"] is artists:
        return built
    vault = {}
    for item in artists or []:
        vault.setdefault(item["artist"], item["songs"])
    first: dict = {}
    last: dict = {}
    for i, name in enumerate(queue):
        low = (name or "").lower()
        first.setdefault(low, i)
        last[low] = i
    built = {"src": queue, "artists": artists, "list": queue, "vault": vault, "first": first, "last": last, "exact": exact}
    if exact:
        _QUEUE["built"] = built
    return built


