        try:
            payload = _build_catches()
        except Exception as exc:  # never break the board; client keeps the last numbers
            payload = {"ok": False, "error": str(exc)}
        _CATCHES_CACHE.update(at=now, payload=payload)
        return payload


# --- Stat-tile progress bars (additive, read-only except new keys in stats-window-baseline.json) ---
# Yellow = total so far, blue = what was added since the current 2-clock-hour ET window began.
# NOTE INDEX / LINE POINTS reuse apply_window's per-artist new_songs (window-baseline.json, read via
# the payload only). PAIRS FILED / OPEN LANES / CATALOG AVG baselines are extra keys in
# stats-window-baseline.json. The catch tiles' bars are computed client-side from /api/catches.
TILE_BARS_CACHE_SECONDS = 4
_TILE_BARS_CACHE: dict = {"at": 0.0, "payload": None}
_TILE_BARS_LOCK = threading.Lock()


def _tile_bar(value, total, new, caption: str) -> dict:
    total = max(0, int(total or 0))
    value = max(0, int(value or 0))
    shown = min(value, total) if total else 0
    new = max(0, min(int(new or 0), shown))          # never negative, never past the fill
    return {
        "value": value, "total": total, "new": new, "caption": caption,
        "pct": round(shown / total * 100, 2) if total else 0,
        "new_pct": round(new / total * 100, 2) if total else 0,
        "base_pct": round((shown - new) / total * 100, 2) if total else 0,
    }


_CATALOG_DONE_CACHE: dict = {"key": None, "times": []}


def _catalog_done_pct(done: int, total: int):
    """CATALOG DONE: finished artists / all catalog artists, floored; one decimal when under 10%."""
    if not total:
        return 0
    if done * 100 < 10 * total:
        return (done * 1000 // total) / 10
    return done * 100 // total


def _catalog_done_times(roster_rows: list) -> list:
    """[(artist, finished_ts)] for every roster row in the "completed" state (artist_finished).
    finished_ts = earliest of: an all-artists-progress.md row whose done + unresolved already covers the vault,
    a complete lane-claims/<artist>.done (mtime), and the later of the click log / unresolved list mtimes;
    0.0 when none exists."""
    done = [r for r in roster_rows if r.get("state") == "completed"]
    key = (tuple(r["artist"] for r in done), _progress_file_key(ALL_ARTISTS_PROGRESS))
    if key == _CATALOG_DONE_CACHE["key"]:
        return _CATALOG_DONE_CACHE["times"]
    vaults = {r["artist"].lower(): int(r.get("vault_songs") or 0) for r in done}
    md: dict = {}
    for r in _rb_md_rows():
        a = r["artist"].lower()
        if a in vaults and vaults[a] and r["after"] + (r["unres"] or 0) >= vaults[a]:
            md[a] = min(md.get(a, r["t"]), r["t"])
    out = []
    for r in done:
        a = r["artist"].lower()
        cands = [md[a]] if a in md else []
        if _done_claim_complete(r["artist"]) and _mtime(LANE_CLAIMS / (a + ".done")):
            cands.append(_mtime(LANE_CLAIMS / (a + ".done")))
        last = [m for m in (_mtime(NOTES_DIR / (a + ".jsonl")),
                            _mtime(ROOT / "docs/play-on-words" / (a.replace(" ", "-") + "-unresolved.jsonl"))) if m]
        if last:
            cands.append(max(last))
        out.append((r["artist"], min(cands) if cands else 0.0))
    _CATALOG_DONE_CACHE.update(key=key, times=out)
    return out


def _build_tile_bars(prev: dict) -> dict:
    state = BOARD.payload or {}
    bars: dict = {}
    counts = state.get("counts") or {}
    progress = state.get("progress") or []
    roster_rows = (state.get("roster") or {}).get("rows") or []
    jobs = ((_JOBS_CACHE.get("payload") or {}).get("jobs")) or []
    values = {}
    if state.get("total"):
        values["pairs_both"] = int(counts.get("Both on the line") or 0)
    running = None
    if jobs:
        running = sum(1 for j in jobs if j.get("status") == "running")
        values["lanes_running"] = running
    new, window = _stats_window(values) if values else ({}, None)
    if "pairs_both" in values:
        both, total = values["pairs_both"], int(state.get("total") or 0)
        bars["pairs"] = _tile_bar(both, total, new.get("pairs_both"), f"{both} of {total} both halves")
    if roster_rows:
        vault = sum(int(r.get("vault_songs") or 0) for r in roster_rows)
        opened = sum(int(r.get("opened") or 0) for r in roster_rows)
        fresh = sum(int(r.get("new_songs") or 0) for r in roster_rows)
        bars["notes"] = _tile_bar(opened, vault, fresh, f"{opened} of {vault} catalog songs resolved")
        # CATALOG DONE: finished artists / all catalog artists; blue = artists finished since 12:00 AM ET.
        cat = _catalog_done_times(roster_rows)
        cat_start = current_window()[0].timestamp()
        cat_new = sum(1 for _a, ft in cat if ft >= cat_start)
        bars["catalog-avg"] = _tile_bar(len(cat), len(roster_rows), cat_new,
                                        f"{len(cat)} of {len(roster_rows)} catalog artists finished")
        bars["catalog-avg"]["display"] = _catalog_done_pct(len(cat), len(roster_rows))
    if progress:
        songs = sum(int(r.get("songs") or 0) for r in progress)
        opened = sum(min(int(r.get("opened") or 0), int(r.get("songs") or 0)) for r in progress)
        fresh = sum(int(r.get("new_songs") or 0) for r in progress)
        bars["points"] = _tile_bar(opened, songs, fresh, f"{opened} of {songs} logged songs resolved")
    if running is not None:
        bars["open-lanes"] = _tile_bar(running, len(jobs), new.get("lanes_running"), f"{running} of {len(jobs)} jobs running")
    out = dict(prev or {})
    out.update(bars)                                  # tolerant: keep the last good bar for a missing source
    if window:
        out["_window"] = window
    return out


def tile_bars() -> dict:
    now = time.time()
    cached = _TILE_BARS_CACHE["payload"]
    if cached is not None and now - _TILE_BARS_CACHE["at"] < TILE_BARS_CACHE_SECONDS:
        return cached
    if not _TILE_BARS_LOCK.acquire(blocking=cached is None):
        return cached or {}
    try:
        try:
            payload = _build_tile_bars(cached)
        except Exception:                             # never break /api/state over a bar
            payload = cached or {}
        _TILE_BARS_CACHE.update(at=time.time(), payload=payload)
        return payload
    finally:
        _TILE_BARS_LOCK.release()


# --- Trend history (additive): 15-minute ET snapshots -> metrics-history.jsonl, served by /api/history ---
# A background thread appends one whole, flushed JSON line per :00/:15/:30/:45 (America/New_York) plus one
# at startup. Values come from the same cached computations the endpoints use (/api/state via BOARD.refresh,
# /api/catches via catch_counts, /api/jobs via jobs_snapshot); nothing is re-scanned. One-time backfill rows
# ("backfilled": true) only for metrics with honest timestamps: confirmed-recheck/recheck.jsonl (ts),
# confirmed-seq.json (first_seen) and wordplay-wiring-log.jsonl (ts). Never writes any baseline/seq file.
HISTORY_FILE = Path(__file__).resolve().parent / "metrics-history.jsonl"
HISTORY_STEP = 15 * 60
HISTORY_DAYS_DEFAULT = 7
HISTORY_VIEW_DAYS = None    # default view = since 12:00 AM ET today (current midnight-ET window); ?days= for a rolling span
HISTORY_TILES = ("pairs", "notes", "points", "open-lanes", "catalog-avg", "catch-confirmed",
                 "catch-unconfirmed", "catch-unsure", "catch-rejected", "catch-rereviewed")
_HISTORY_WRITE_LOCK = threading.Lock()
_HISTORY_READ_LOCK = threading.Lock()
_HISTORY_CACHE: dict = {"key": None, "rows": [], "resp": {}}


def _history_iso(ts: float) -> str:
    from datetime import datetime
    dt = datetime.fromtimestamp(ts, BOARD_TZ) if BOARD_TZ else datetime.fromtimestamp(ts).astimezone()
    return dt.isoformat(timespec="seconds")


def _history_parse_ts(value):
    from datetime import datetime
    if isinstance(value, (int, float)) and not isinstance(value, bool):
        return float(value)
    try:
        dt = datetime.fromisoformat(str(value).strip().replace("Z", "+00:00"))
    except (TypeError, ValueError):
        return None
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=BOARD_TZ) if BOARD_TZ else dt.astimezone()
    return dt.timestamp()


def _history_snapshot(ts=None) -> dict:
    """One row of current values, taken from the endpoints' own cached computations."""
    import math
    ts = time.time() if ts is None else ts
    tiles, artists, jobs, lanes, logs = {}, {}, {}, {}, {}
    try:
        state = BOARD.refresh()
    except Exception:
        state = BOARD.payload or {}
    if state:
        if state.get("total") is not None:
            tiles["pairs"] = int(state.get("total") or 0)
        if state.get("notes") is not None:
            tiles["notes"] = int(state.get("notes") or 0)
        if "progress" in state:
            progress = state.get("progress") or []
            tiles["points"] = sum(int(r.get("points") or 0) for r in progress)
            tiles["open-lanes"] = sum(1 for r in progress if r.get("status") != "done")
        roster = state.get("roster") or {}
        if roster.get("ready") and roster.get("rows"):
            rr = roster["rows"]
            tiles["catalog-avg"] = _catalog_done_pct(sum(1 for r in rr if r.get("state") == "completed"), len(rr))
        if roster.get("ready"):
            for r in roster.get("rows") or []:
                if r.get("artist"):
                    artists[r["artist"]] = int(r.get("opened") or 0)
        try:
            lanes.update(_history_lane_values(state))
            for r in state.get("progress") or []:
                if r.get("artist") and r.get("status") != "done":     # the open logs the top LOG cards can show
                    logs[r["artist"] + ":opened"] = int(r.get("opened") or 0)
                    logs[r["artist"] + ":pts"] = int(r.get("points") or 0)
        except Exception:
            pass
    try:
        cc = catch_counts()
        if cc.get("ok"):
            c = cc.get("counts") or {}
            for k in ("confirmed", "unconfirmed", "unsure", "rejected"):
                tiles["catch-" + k] = int(c.get(k) or 0)
            tiles["catch-rereviewed"] = int((cc.get("re_reviewed") or {}).get("count") or 0)
    except Exception:
        pass
    try:
        for j in (jobs_snapshot() or {}).get("jobs") or []:
            if j.get("id") and j.get("headline") != "Reader error":
                jobs[j["id"]] = int(j.get("value") or 0)
    except Exception:
        pass
    return {"ts": _history_iso(ts), "t": round(ts, 3), "tiles": tiles, "artists": artists, "jobs": jobs, "lanes": lanes, "logs": logs,
            "catalog_def": "done"}


def _history_lane_values(state: dict) -> dict:
    """The % the CURRENT WORK cards show, computed exactly like paintTop (JS Math.round = floor(x + .5))."""
    import math
    def jround(x):
        return int(math.floor(x + 0.5))
    def clamp(p):
        return jround(max(0.0, min(100.0, float(p or 0))))
    out = {}
    tk = state.get("takeover") or {}
    total = tk.get("total") or 0
    out["takeover"] = clamp(jround((tk.get("done") or 0) / total * 100) if total else 0)
    for i, a in enumerate((tk.get("subagents") or [])[:3]):
        out["sub:" + str(a.get("name") or i)] = clamp(a.get("pct") or 45)
    out["watcher"] = 100 if state.get("live") else 30
    h = state.get("harness") or {}
    out["harness"] = 100 if (h.get("age") is not None and h.get("age") < 120) else 35
    return out


def _history_append(rows: list) -> None:
    """Append-only, whole lines, flushed + fsynced."""
    if not rows:
        return
    with _HISTORY_WRITE_LOCK:
        lead = ""
        try:
            if HISTORY_FILE.stat().st_size > 0:
                with HISTORY_FILE.open("rb") as fh:
                    fh.seek(-1, os.SEEK_END)
                    if fh.read(1) != b"\n":
                        lead = "\n"            # never glue onto a torn tail
        except OSError:
            pass
        text = lead + "".join(json.dumps(r, separators=(",", ":"), ensure_ascii=False) + "\n" for r in rows)
        with HISTORY_FILE.open("a", encoding="utf-8") as fh:
            fh.write(text)
            fh.flush()
            os.fsync(fh.fileno())


def _history_rows(path: Path = None, cache: dict = None) -> list:
    """Parsed history rows sorted by time; re-read only when the file's mtime/size change."""
    path = HISTORY_FILE if path is None else path
    cache = _HISTORY_CACHE if cache is None else cache
    key = _progress_file_key(path)
    with _HISTORY_READ_LOCK:
        if key == cache["key"]:
            return cache["rows"]
        rows = []
        if key is not None:
            try:
                with path.open(encoding="utf-8", errors="replace") as fh:
                    for raw in fh:
                        raw = raw.strip()
                        if not raw:
                            continue
                        try:
                            row = json.loads(raw)
                        except json.JSONDecodeError:
                            continue
                        if isinstance(row, dict):
                            t = row.get("t")
                            if not isinstance(t, (int, float)):
                                t = _history_parse_ts(row.get("ts"))
                            if t is not None:
                                row["t"] = float(t)
                                rows.append(row)
            except OSError:
                rows = []
        rows.sort(key=lambda r: r["t"])
        cache.update(key=key, rows=rows, resp={})
        return rows


_REBUILT_CACHE: dict = {"key": None, "rows": [], "resp": {}}
_SERIES_CACHE: dict = {}


def history_series(metric: str, days=None) -> list:
    """[[ts, value], ...] (oldest first) for one metric, cached per file mtime. days=None (default): since 12:00 AM
    ET today; a value known before midnight is carried forward and re-stamped at exactly 00:00 (nothing older is
    returned). days=<n>: rolling last n days (stored history is never trimmed).
    Live snapshots are authoritative; backfilled / rebuilt points (marked with a third element 1) only fill
    the time before the metric's first live snapshot (a backfilled point wins over a rebuilt one)."""
    live_rows = _history_rows(HISTORY_FILE, _HISTORY_CACHE)
    rb_rows = _history_rows(REBUILT_FILE, _REBUILT_CACHE)
    if days is None:
        cutoff = current_window()[0].timestamp()
    else:
        cutoff = time.time() - days * 86400
    ck = (metric, days, cutoff if days is None else None)
    sig = (id(live_rows), id(rb_rows))
    with _HISTORY_READ_LOCK:
        hit = _SERIES_CACHE.get(ck)
        if hit is not None and hit[0] == sig:
            return hit[1]
    if metric.startswith("artist:"):
        section, name = "artists", metric[len("artist:"):]
    elif metric.startswith("lane:"):
        section, name = "lanes", metric[len("lane:"):]
    elif metric.startswith("log:"):
        section, name = "logs", metric[len("log:"):]
    elif metric.startswith("job:"):
        section, name = "jobs", metric[len("job:"):]
    else:
        section, name = "tiles", metric

    def val(r):
        v = (r.get(section) or {}).get(name)
        return v if isinstance(v, (int, float)) and not isinstance(v, bool) else None
    live, recon = [], {}
    for r in rb_rows:
        v = val(r)
        if v is not None:
            recon[r["t"]] = (r.get("ts") or _history_iso(r["t"]), v)
    for r in live_rows:
        v = val(r)
        if v is None:
            continue
        if metric == "catalog-avg" and not r.get("catalog_def") and not (r.get("backfilled") or r.get("reconstructed")):
            continue                                  # written under the old average-of-logs rule; rebuilt fills it
        if r.get("backfilled") or r.get("reconstructed"):
            recon[r["t"]] = (r.get("ts") or _history_iso(r["t"]), v)
        else:
            live.append((r["t"], r.get("ts") or _history_iso(r["t"]), v))
    first_live = live[0][0] if live else float("inf")
    pts = [(t, ts, v, True) for t, (ts, v) in recon.items() if t < first_live] + [(t, ts, v, False) for t, ts, v in live]
    pts.sort(key=lambda p: p[0])
    out = [[ts, v, 1] if rec else [ts, v] for t, ts, v, rec in pts if t >= cutoff]
    if days is None:
        before = [p for p in pts if p[0] < cutoff]
        if before and not (pts and any(abs(p[0] - cutoff) < 1 for p in pts)):
            _t, _ts, v, rec = before[-1]
            out.insert(0, [_history_iso(cutoff), v, 1] if rec else [_history_iso(cutoff), v])
    with _HISTORY_READ_LOCK:
        if len(_SERIES_CACHE) > 4000:
            _SERIES_CACHE.clear()
        _SERIES_CACHE[ck] = (sig, out)
    return out


def _history_catch_replay(ov: dict, hl_rows: list, cand_rows: list, verified: list, verify_input: list) -> tuple:
    """_build_catches' bucket rules re-run with a given recheck-override map (read-only, in-memory rows).
    Returns (confirmed key set, rejected count, re-reviewed count)."""
    def key_of(r):
        return confirmed_key(r.get("artist"), r.get("song"), r.get("bar"))
    keepfix = {k for k, o in ov.items() if o["verdict"] in ("KEEP", "FIX")}
    rows = [r for r in hl_rows if not _is_possible(r)]
    rows += [r for r in hl_rows if _is_possible(r) and key_of(r) in keepfix]
    rows += _verified_confirmed(ov)
    rows += [r for r in cand_rows if key_of(r) in keepfix]
    confirmed_rows, seen = [], set()
    for row in rows:
        k = key_of(row)
        if k in seen:
            continue
        seen.add(k)
        o = ov.get(k)
        if o and o["verdict"] == "REJECT":
            continue
        confirmed_rows.append(row)
    confirmed = {key_of(r) for r in confirmed_rows}
    overridden = set(ov)
    rejected_override = {k for k, o in ov.items() if o["verdict"] == "REJECT"}
    verdict, verdict_ids = {}, set()
    for r in verified:
        v = str(r.get("verdict") or "").strip().upper()
        if not v or not r.get("bar"):
            continue
        verdict[key_of(r)] = v
        if r.get("id"):
            verdict_ids.add(str(r.get("id")))
    rejected_verify = {k for k, v in verdict.items() if v == "REJECTED"} - confirmed - overridden
    taken = confirmed | set(verdict) | overridden
    annotated = {key_of(r) for r in confirmed_rows if r.get("url") or r.get("source_id")}
    annotated |= {key_of(r) for r in hl_rows if r.get("url") or r.get("annotation_id")}
    cand_rejected = set()
    for r in cand_rows:
        k = key_of(r)
        if r.get("url") or r.get("source_id"):
            annotated.add(k)
        if k in taken:
            continue
        if r["state"] == "rejected":
            cand_rejected.add(k)
    checked_keys = {key_of(r) for r in verify_input if r.get("bar") and r.get("id") and str(r.get("id")) in verdict_ids}
    possible_pending = set()
    for r in [r for r in hl_rows if _is_possible(r)] + verify_input:
        if not r.get("bar"):
            continue
        k = key_of(r)
        if k in taken or k in checked_keys:
            continue
        possible_pending.add(k)
    rejected = rejected_verify | rejected_override | (cand_rejected - possible_pending)
    annotated |= {k for k, o in ov.items() if o.get("url") or o.get("annotation_id")}
    rr = [k for k, o in ov.items() if str(o.get("by") or "").strip().lower() == "samuel" or k in annotated]
    return confirmed, len(rejected), len(rr)


def _history_wired_at(rows: list) -> int:
    """_job_wiring's wired-row count for a prefix of wordplay-wiring-log.jsonl."""
    latest, row_of = {}, {}
    for r in rows:
        decision = str(r.get("decision") or "").strip().lower()
        if not r.get("noun") or not decision or decision in ("batch_result", "batch-result", "test", "tests"):
            continue
        line = r.get("source_line")
        rowkey = (str(r.get("source") or ""), line) if line is not None else ("chip", normalize(str(r.get("noun"))))
        chip = (rowkey, normalize(str(r.get("noun"))))
        latest[chip] = decision
        row_of[chip] = rowkey
    return len({row_of[c] for c, d in latest.items() if d in ("reused", "created")})


def _history_backfill(now: float) -> tuple:
    """Backfilled 15-minute rows from honestly timestamped sources. Each metric is only backfilled if the
    replay reproduces today's live value exactly. Returns (rows, notes)."""
    floor = lambda t: (t // HISTORY_STEP) * HISTORY_STEP
    oldest = now - HISTORY_DAYS_DEFAULT * 86400
    series: dict = {}          # bucket t -> {"tiles": {}, "jobs": {}}
    notes = []

    def put(t, section, name, value):
        series.setdefault(t, {"tiles": {}, "jobs": {}})[section][name] = value

    # Catch tiles: confirmed-recheck/recheck.jsonl ts (+ confirmed-seq.json first_seen for CONFIRMED).
    try:
        cc = catch_counts()
        rech = []
        for r in _read_jsonl_cached(RECHECK_FILE):
            v = str(r.get("verdict") or "").strip().upper()
            t = _history_parse_ts(r.get("ts"))
            if v in RECHECK_VERDICTS and r.get("key_bar") and t is not None:
                rech.append((t, confirmed_key(r.get("key_artist"), r.get("key_song"), r.get("key_bar")), dict(r, verdict=v)))
        all_ov = {}
        for r in _read_jsonl_cached(RECHECK_FILE):
            v = str(r.get("verdict") or "").strip().upper()
            if v in RECHECK_VERDICTS and r.get("key_bar"):
                all_ov[confirmed_key(r.get("key_artist"), r.get("key_song"), r.get("key_bar"))] = dict(r, verdict=v)
        seq_first = {}
        try:
            items = (json.loads(_read_text_cached(CONFIRMED_SEQ_FILE) or "{}").get("items")) or {}
            for k, it in items.items():
                fs = it.get("first_seen") or 0
                seq_first[k] = float(fs) if isinstance(fs, (int, float)) else (_history_parse_ts(it.get("first_seen_at")) or 0.0)
        except (ValueError, AttributeError, TypeError):
            seq_first = {}
        if cc.get("ok") and rech and len(all_ov) == len({k for _, k, _ in rech}):
            hl_rows = [r for r in _read_jsonl_cached(HIGHLIGHTS) if r.get("bar")]
            cand_rows = _candidate_rows()
            verified = _read_jsonl_cached(VERIFIED_FILE)
            verify_input = _read_jsonl_cached(VERIFY_INPUT)
            args = (hl_rows, cand_rows, verified, verify_input)
            conf_now, rej_now, rr_now = _history_catch_replay(all_ov, *args)
            live = cc.get("counts") or {}
            ok_conf = len(conf_now) == int(live.get("confirmed") or 0)
            ok_rej = rej_now == int(live.get("rejected") or 0)
            ok_rr = rr_now == int((cc.get("re_reviewed") or {}).get("count") or 0)
            first_rech = min(t for t, _, _ in rech)
            seq_times = [t for t in seq_first.values() if t]
            start_conf = max(oldest, floor(min([first_rech] + seq_times)))
            start_rech = max(oldest, floor(first_rech))
            t = min(start_conf, start_rech)
            while t < now:
                ov = {}
                for rt, k, o in rech:                  # file order, last row per key wins
                    if rt <= t:
                        ov[k] = o
                conf, rej, rr = _history_catch_replay(ov, *args)
                if ok_conf and t >= start_conf:
                    put(t, "tiles", "catch-confirmed", sum(1 for k in conf if seq_first.get(k, 0.0) <= t))
                if ok_rej and t >= start_rech:
                    put(t, "tiles", "catch-rejected", rej)
                if ok_rr and t >= start_rech:
                    put(t, "tiles", "catch-rereviewed", rr)
                t += HISTORY_STEP
            notes.append("catch replay ok: confirmed=%s rejected=%s re_reviewed=%s" % (ok_conf, ok_rej, ok_rr))
        else:
            notes.append("catch backfill skipped (no timestamped recheck rows or catches unavailable)")
    except Exception as exc:
        notes.append("catch backfill error: %s" % exc)

    # Job 4 (wiring): wordplay-wiring-log.jsonl ts.
    try:
        wrows = _read_jsonl_cached(WIRING_LOG)
        stamped = [(_history_parse_ts(r.get("ts")), r) for r in wrows]
        if wrows and all(t is not None for t, _ in stamped):
            live_job = next((j for j in (jobs_snapshot() or {}).get("jobs") or [] if j.get("id") == "wiring"), None)
            now_val = min(_history_wired_at(wrows), WIRING_TO_WIRE)
            if live_job is not None and int(live_job.get("value") or 0) == now_val:
                t = max(oldest, floor(min(t for t, _ in stamped)))
                while t < now:
                    put(t, "jobs", "wiring", min(_history_wired_at([r for rt, r in stamped if rt <= t]), WIRING_TO_WIRE))
                    t += HISTORY_STEP
                notes.append("wiring replay ok")
            else:
                notes.append("wiring backfill skipped (replay %s != live %s)" % (now_val, live_job and live_job.get("value")))
        else:
            notes.append("wiring backfill skipped (no rows or rows without ts)")
    except Exception as exc:
        notes.append("wiring backfill error: %s" % exc)

    out = []
    for t in sorted(series):
        s = series[t]
        out.append({"ts": _history_iso(t), "t": float(t), "backfilled": True, "tiles": s["tiles"], "artists": {}, "jobs": s["jobs"]})
    return out, notes


def _history_startup() -> None:
    # Let the roster catalog load so the first row carries every artist (bounded wait, cheap polls).
    deadline = time.time() + 60
    while time.time() < deadline:
        try:
            if ((BOARD.refresh() or {}).get("roster") or {}).get("ready"):
                break
        except Exception:
            pass
        time.sleep(3)
    now = time.time()
    if not any(r.get("backfilled") for r in _history_rows()):
        rows, notes = _history_backfill(now)
        _history_append(rows)
        print("TREND_HISTORY backfill: %d rows; %s" % (len(rows), "; ".join(notes)), flush=True)
    _history_append([_history_snapshot(now)])
    print("TREND_HISTORY startup snapshot written", flush=True)
    if not _rebuilt_current():
        try:
            rep = rebuild_history(BOARD.payload or {}, jobs_snapshot() or {})
            print("TREND_HISTORY rebuilt 24h history: " + json.dumps(rep)[:4000], flush=True)
        except Exception as exc:
            print("TREND_HISTORY rebuild error: %s" % exc, flush=True)


def _history_loop() -> None:
    try:
        _history_startup()
    except Exception as exc:
        print("TREND_HISTORY startup error: %s" % exc, flush=True)
    last_bucket = (time.time() // HISTORY_STEP) * HISTORY_STEP
    while True:
        now = time.time()
        nxt = last_bucket + HISTORY_STEP
        if now < nxt:
            time.sleep(min(60.0, max(0.5, nxt - now + 0.2)))
            continue
        bucket = (now // HISTORY_STEP) * HISTORY_STEP
        last_bucket = bucket
        try:
            row = _history_snapshot(now)
            if now - bucket <= 120:            # stamp on the :00/:15/:30/:45 boundary it belongs to
                row["ts"], row["t"] = _history_iso(bucket), float(bucket)
            _history_append([row])
        except Exception as exc:
            print("TREND_HISTORY snapshot error: %s" % exc, flush=True)


def start_history_thread() -> None:
    threading.Thread(target=_history_loop, name="trend-history", daemon=True).start()


# --- Rebuilt 24-hour history (additive, read-only on every source) -------------------------------------
# One-time reconstruction of the last 24 h on the 15-minute grid from files that carry honest timestamps,
# written to metrics-history-rebuilt.jsonl (never into the live metrics-history.jsonl) and merged at read
# time: rebuilt/backfilled points only fill the time before a metric's first live snapshot. Step series:
# the last known value is carried forward, nothing is interpolated, nothing before the first known point.
# Every metric's reconstruction is checked against the live value and dropped if it disagrees.
REBUILT_FILE = Path(__file__).resolve().parent / "metrics-history-rebuilt.jsonl"
REBUILD_VERSION = 6   # 5: catalog-avg = finished catalog artists / all catalog artists; 6: stricter finished rule
_RB_ABSENT = "absent"
_RB_UNKNOWN = "unknown"
_RB_STAMP_RE = re.compile(r"(\d{8})_?(\d{4,6})\.bak$|(\d{12})\.bak$")


def _rb_local_ts(text: str):
    from datetime import datetime
    try:
        dt = datetime.strptime(text.strip(), "%Y-%m-%d %H:%M:%S")
    except ValueError:
        return None
    return dt.replace(tzinfo=BOARD_TZ).timestamp() if BOARD_TZ else dt.timestamp()


def _rb_stamp(name: str):
    from datetime import datetime
    m = _RB_STAMP_RE.search(name)
    if not m:
        return None
    if m.group(3):
        d, hm = m.group(3)[:8], m.group(3)[8:]
    else:
        d, hm = m.group(1), m.group(2)
    try:
        dt = datetime.strptime(d + hm.ljust(6, "0"), "%Y%m%d%H%M%S")
    except ValueError:
        return None
    return dt.replace(tzinfo=BOARD_TZ).timestamp() if BOARD_TZ else dt.timestamp()


def _rb_progress_name(path: Path) -> str:
    for name, p in CLICK_LOGS.items():
        if p == path:
            return name
    artist = path.stem.replace("-", " ").title()
    return {"juice wrld": "Juice WRLD", "lil uzi vert": "Lil Uzi Vert", "nocap": "NoCap"}.get(path.stem, artist)


def _rb_scan(path: Path, artist: str, want: set) -> tuple:
    """scan_artist_log's counting, row by row. want = {(kind, n)} with kind in done/proc/opened; the state is
    captured just before that counter would pass n (and at EOF). State = (songs, opened, missing, invalid,
    points, lines, done, proc)."""
    songs, opened, keys = set(), set(), set()
    missing = invalid = pending_bad = lines = done = proc = miss2 = 0
    caps = {}

    def snap():
        return (len(songs), len(opened), missing, invalid, len(keys), lines, done, proc, miss2)
    try:
        fh = path.open(encoding="utf-8", errors="replace")
    except OSError:
        return None, caps
    with fh:
        for raw in fh:
            raw = raw.strip()
            if not raw:
                continue
            try:
                row = json.loads(raw)
            except json.JSONDecodeError:
                pending_bad += 1
                continue
            if pending_bad:
                invalid += pending_bad
                pending_bad = 0
            if not isinstance(row, dict):
                invalid += 1
                continue
            kind = row.get("type") or "line"
            status = (row.get("click_status") or "").lower()
            st2 = (row.get("click_status") or row.get("status") or "").lower()   # md counters (song rows use "status")
            ra = row.get("artist") or artist
            song = clean_song(row.get("song") or "", ra)
            opens = bool(row.get("clicked") or (kind == "song" and (row.get("status") or "").lower() == "done"))
            if want:
                if kind == "song" and st2 in ("done", "missing"):
                    if ("proc", proc) in want and ("proc", proc) not in caps:
                        caps[("proc", proc)] = snap()
                    if st2 == "done" and ("done", done) in want and ("done", done) not in caps:
                        caps[("done", done)] = snap()
                if opens and song not in opened and ("opened", len(opened)) in want and ("opened", len(opened)) not in caps:
                    caps[("opened", len(opened))] = snap()
            if kind == "line" and (row.get("line") or "").strip():
                keys.add((normalize(ra), normalize(clean_song(row.get("song") or "", ra)), " ".join((row.get("line") or "").lower().split())))
            if row.get("type") in (None, "line"):
                lines += 1
            if song:
                songs.add(song)
            if opens:
                opened.add(song)
            if kind == "song":
                if status == "missing":
                    missing += 1                      # scan_artist_log's own rule (click_status)
                if st2 == "done":
                    done += 1
                    proc += 1
                elif st2 == "missing":
                    miss2 += 1
                    proc += 1
    final = snap()
    for k, n in want:
        if (k, n) not in caps and {"done": final[6], "proc": final[7], "opened": final[1]}[k] == n:
            caps[(k, n)] = final
    return final, caps


def _rb_view(state) -> dict:
    songs, opened, missing, invalid, points, lines = state[:6]
    return {"opened": opened, "points": points, "lines": lines,
            "pct": round(opened / songs * 100) if songs else 0,
            "open": bool(max(songs - opened, missing) or invalid)}


def _rb_md_rows() -> list:
    out = []
    for line in (_read_text_cached(ALL_ARTISTS_PROGRESS) or "").splitlines():
        if not line.startswith("|"):
            continue
        c = [x.strip() for x in line.strip().strip("|").split("|")]
        if len(c) < 6 or c[0].lower() == "artist" or set(c[0]) <= set("-: "):
            continue
        m = re.match(r"(\d+)\s*->\s*(\d+)", c[2])
        t = _rb_local_ts(c[5])
        if not m or t is None:
            continue
        tag = re.search(r"\[([^\]]+)\]", c[0])
        try:
            unres = int(c[3])
        except ValueError:
            unres = None
        out.append({"t": t, "artist": re.sub(r"\s*\[[^\]]+\]\s*", "", c[0]).strip(), "tag": tag.group(1).lower() if tag else "",
                    "before": int(m.group(1)), "after": int(m.group(2)), "unres": unres})
    prev = {}
    for r in out:                                     # lane order: the previous row written by the same lane
        r["prev_t"] = prev.get(r["tag"])
        prev[r["tag"]] = r["t"]
    return out


def _rb_pairs_total(sections_text: str, store_text: str) -> int:
    seen = set()
    for _title, words in parse_sections(sections_text):
        seen.update(normalize(w) for w in words)
    seen.update(normalize(w) for w in parse_store(store_text))
    return len(seen)


def _rb_window_baseline_time():
    """window-baseline.json was first written by the first server build that had apply_window; that build was
    live until the stamp of the earliest server.py.before-*.bak containing it, so the baseline existed by then."""
    best = None
    for p in Path(__file__).resolve().parent.glob("server.py.before-*.bak"):
        st = _rb_stamp(p.name)
        if st is None:
            continue
        try:
            if "def apply_window" in p.read_text(encoding="utf-8", errors="replace"):
                best = st if best is None else min(best, st)
        except OSError:
            pass
    return best


def _rb_lane_starts(stem: str) -> list:
    """Start times a lane recorded for an artist: 'claimed:' / 'Started:' lines and the timestamp on a .done
    line, from lane-claims/<stem>.* (claim, done, *-stopped)."""
    out = []
    try:
        files = [p for p in LANE_CLAIMS.iterdir() if p.name.lower().startswith(stem + ".")]
    except OSError:
        files = []
    for p in files:
        text = _read_text_cached(p) or ""
        for m in re.finditer(r"(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)(?:\.\d+)?([+-]\d\d:\d\d)?", text):
            t = _history_parse_ts(m.group(1) + (m.group(2) or ""))
            if t is not None:
                out.append(t)
    return out


def rebuild_history(live_state: dict, live_jobs: dict, write: bool = True) -> dict:
    import bisect
    import subprocess
    now = time.time()
    step = HISTORY_STEP
    start = ((now - 86400) // step + 1) * step
    grid = []
    t = start
    while t <= now:
        grid.append(t)
        t += step
    report = {}
    series = {}                                       # metric -> {grid_t: value}

    progress = live_state.get("progress") or []
    prog_by_path = {str(ROOT / r["path"]): r for r in progress if r.get("path")}
    roster_rows = (live_state.get("roster") or {}).get("rows") or []
    md = _rb_md_rows()
    md_by_artist: dict = {}
    for r in md:
        md_by_artist.setdefault(r["artist"].lower(), []).append(r)
    try:
        wb = json.loads(_read_text_cached(WINDOW_FILE) or "{}")
    except ValueError:
        wb = {}
    wb_t = _rb_window_baseline_time() if str(wb.get("window_start", "")) == current_window()[0].isoformat() else None
    wb_art = {k.lower(): v for k, v in (wb.get("artists") or {}).items() if isinstance(v, dict)} if wb_t else {}
    baks: dict = {}
    for p in NOTES_DIR.glob("*.jsonl.*.bak"):
        base = p.name.split(".jsonl.")[0] + ".jsonl"
        baks.setdefault(base, []).append(p)

    # ---- per-log timelines: [(t, state | ABSENT | UNKNOWN)] -------------------------------------------
    timelines: dict = {}
    finals: dict = {}
    stats = {"scanned": 0, "md_points": 0, "md_dropped": 0, "bak_points": 0, "wb_points": 0, "wb_dropped": 0}
    for path in sorted(NOTES_DIR.glob("*.jsonl")):
        try:
            st = path.stat()
        except OSError:
            continue
        name = _rb_progress_name(path)
        live_row = prog_by_path.get(str(path))
        stem = path.stem.lower()
        pts = []
        if st.st_mtime < start and path not in CLICK_LOGS.values():
            if live_row is None:
                continue
            v = {"opened": int(live_row.get("opened") or 0), "points": int(live_row.get("points") or 0), "lines": 0,
                 "pct": live_row.get("pct") or 0, "open": live_row.get("status") != "done"}
            timelines[str(path)] = [(start - 1, v)]
            finals[str(path)] = v
            continue
        rows = md_by_artist.get(stem, [])
        want = set()
        for r in rows:
            kind = "proc" if r["tag"].startswith(("chat", "box")) else "done"
            want.add((kind, r["after"]))
            want.add(("proc" if kind == "done" else "done", r["after"]))
            if r["tag"].startswith("lane") and r["prev_t"]:
                want.add((kind, r["before"]))
        wbe = wb_art.get(name.lower()) or wb_art.get(stem)
        if wbe:
            want.add(("opened", int(wbe.get("opened") or 0)))
        final, caps = _rb_scan(path, name, want)
        stats["scanned"] += 1
        if final is None:
            continue
        fv = _rb_view(final)
        finals[str(path)] = fv
        if st.st_mtime < start:
            timelines[str(path)] = [(start - 1, fv)]
            continue
        evidence_before_birth = False
        born = getattr(st, "st_birthtime", None)
        for r in rows:
            kinds = ["proc", "done"] if r["tag"].startswith(("chat", "box")) else ["done", "proc"]
            got = None
            for k in kinds:
                s = caps.get((k, r["after"]))
                if s is not None and (r["unres"] is None or abs(s[8] - r["unres"]) <= max(2, r["unres"] * 0.05)):
                    got = (k, s)
                    break
            if got is None:
                stats["md_dropped"] += 1
                continue
            pts.append((r["t"], _rb_view(got[1])))
            stats["md_points"] += 1
            if born is not None and r["t"] < born - 60:
                evidence_before_birth = True
            if r["tag"].startswith("lane") and r["prev_t"] and r["prev_t"] < r["t"]:
                if r["before"] == 0 and born is not None and r["prev_t"] < born:
                    pts.append((r["prev_t"], _RB_ABSENT))
                else:
                    s = caps.get((got[0], r["before"]))
                    if s is not None:
                        pts.append((r["prev_t"], _rb_view(s)))
        for bp in baks.get(path.name, []):
            try:
                bst = bp.stat()
            except OSError:
                continue
            bfinal, _ = _rb_scan(bp, name, set())
            if bfinal is None:
                continue
            bv = _rb_view(bfinal)
            pts.append((bst.st_mtime, bv))
            stats["bak_points"] += 1
            stamp = _rb_stamp(bp.name)
            if stamp and bst.st_mtime < stamp <= st.st_mtime:
                pts.append((stamp, bv))             # cp -p kept the mtime: unchanged until the copy
            if born is not None and bst.st_mtime < born - 60:
                evidence_before_birth = True
        if wbe and wb_t and (born is None or born < wb_t):
            s = caps.get(("opened", int(wbe.get("opened") or 0)))
            if s is not None and abs(s[4] - int(wbe.get("points") or 0)) <= max(2, int(wbe.get("points") or 0) * 0.01):
                pts.append((wb_t, _rb_view(s)))
                stats["wb_points"] += 1
                if born is not None and wb_t < born - 60:
                    evidence_before_birth = True
            else:
                stats["wb_dropped"] += 1
        # A chat/box lane that began this artist at 0 done songs: no log before the lane recorded its start.
        lane_rows = sorted((r for r in rows if r["tag"] and not r["tag"].startswith("lane")), key=lambda r: r["t"])
        if lane_rows and lane_rows[0]["before"] == 0:
            first_t = lane_rows[0]["t"]
            brief = {"lil wayne": WAYNE_BRIEF, "youngboy never broke again": YOUNGBOY_BRIEF}.get(stem)
            cands = [c for c in _rb_lane_starts(stem) + ([_mtime(brief)] if brief and _mtime(brief) else []) if c < first_t]
            if cands:
                t0 = max(cands)
                if not any(p[0] < t0 for p in pts if p[1] not in (_RB_ABSENT, _RB_UNKNOWN)):
                    pts.append((start - 1, _RB_ABSENT))
                    pts.append((t0, _RB_UNKNOWN))
                    stats["lane_start_points"] = stats.get("lane_start_points", 0) + 1
                    evidence_before_birth = True
        if born is not None and born > start and not evidence_before_birth:
            pts.append((start - 1, _RB_ABSENT))
            pts.append((born, _RB_UNKNOWN))
        pts.append((st.st_mtime, fv))
        pts.sort(key=lambda p: p[0])
        timelines[str(path)] = pts

    def at(path_key, t):
        pts = timelines.get(path_key)
        if not pts:
            return _RB_UNKNOWN
        i = bisect.bisect_right([p[0] for p in pts], t) - 1
        return pts[i][1] if i >= 0 else _RB_UNKNOWN

    # ---- artists (roster) and the artist-bound job cards -------------------------------------------
    roster_live = {r["artist"]: r for r in roster_rows}
    art_ok = art_drop = 0
    for r in roster_rows:
        path = NOTES_DIR / (r["artist"].lower() + ".jsonl")
        key = str(path)
        if key not in timelines:
            continue
        vault = int(r.get("vault_songs") or 0)
        cap = (lambda v: min(v, vault)) if vault else (lambda v: v)
        fin = finals.get(key)
        if fin is None or abs(cap(fin["opened"]) - int(r.get("opened") or 0)) > max(3, int(r.get("opened") or 0) * 0.01):
            art_drop += 1
            continue
        vals = {}
        for t in grid:
            s = at(key, t)
            if s == _RB_UNKNOWN:
                continue
            vals[t] = 0 if s == _RB_ABSENT else cap(s["opened"])
        if vals:
            series["artist:" + r["artist"]] = vals
            art_ok += 1
    report["artists"] = "%d rebuilt, %d dropped (live mismatch)" % (art_ok, art_drop)

    for j in (live_jobs or {}).get("jobs") or []:
        jid = j.get("id")
        artist = str(j.get("headline") or "").split(" · ")[0].strip()
        if jid not in ("main", "uzi", "wayne", "youngboy") or artist not in roster_live:
            if jid not in ("wiring",):
                report["job:" + str(jid)] = "not rebuilt: value follows whichever artist is claimed at the moment; no per-moment record"
            continue
        src = series.get("artist:" + artist)
        if not src:
            report["job:" + jid] = "not rebuilt: no artist history for " + artist
            continue
        if int(j.get("value") or 0) != int(roster_live[artist].get("opened") or 0):
            report["job:" + jid] = "dropped: card value differs from the roster value"
            continue
        if jid == "main":
            # The main card shows the run's current artist. The run writes one untagged progress row when it
            # finishes an artist, so at time t it was on the artist of the first untagged row after t.
            done_rows = sorted((r for r in md if not r["tag"]), key=lambda r: r["t"])
            vals, used = {}, []
            for t in grid:
                nxt = next((r for r in done_rows if r["t"] > t), None)
                who = nxt["artist"] if nxt else artist
                src_w = series.get("artist:" + who) or series.get("artist:" + next((a for a in roster_live if a.lower() == who.lower()), who))
                if src_w and t in src_w:
                    vals[t] = src_w[t]
                    if who not in used:
                        used.append(who)
            if vals:
                series["job:main"] = vals
                report["job:main"] = "rebuilt from the main run's artist at each time (" + " -> ".join(used) + "; switch = untagged all-artists-progress.md rows)"
            continue
        vals = dict(src)
        if vals:
            series["job:" + jid] = vals
            report["job:" + jid] = "rebuilt from %s's log history" % artist

    # ---- aggregate tiles: every log must be known (or known absent) at t --------------------------
    keys_all = list(timelines)
    click_keys = [str(p) for p in CLICK_LOGS.values()]
    agg = {"points": {}, "open-lanes": {}, "catalog-avg": {}, "notes": {}}
    import math
    cat_times = _catalog_done_times(roster_rows) if roster_rows else []
    for t in grid:
        if roster_rows:                               # finished catalog artists at t (by finish time) / all catalog artists
            agg["catalog-avg"][t] = _catalog_done_pct(sum(1 for _a, ft in cat_times if ft <= t), len(roster_rows))
        states = [at(k, t) for k in keys_all]
        if all(s != _RB_UNKNOWN for s in states):
            live = [s for s in states if s != _RB_ABSENT]
            agg["points"][t] = sum(s["points"] for s in live)
            agg["open-lanes"][t] = sum(1 for s in live if s["open"])
        cs = [at(k, t) for k in click_keys]
        if all(s not in (_RB_UNKNOWN,) for s in cs):
            agg["notes"][t] = sum(0 if s == _RB_ABSENT else s["lines"] for s in cs)
    fin_all = [finals[k] for k in keys_all if k in finals]
    checks = {
        "points": (sum(s["points"] for s in fin_all), sum(int(r.get("points") or 0) for r in progress), lambda a, b: abs(a - b) <= max(10, b * 0.003)),
        "open-lanes": (sum(1 for s in fin_all if s["open"]), sum(1 for r in progress if r.get("status") != "done"), lambda a, b: abs(a - b) <= 2),
        "catalog-avg": (_catalog_done_pct(len(cat_times), len(roster_rows)),
                        _catalog_done_pct(sum(1 for r in roster_rows if r.get("state") == "completed"), len(roster_rows)), lambda a, b: a == b),
        "notes": (sum(finals[k]["lines"] for k in click_keys if k in finals), int(live_state.get("notes") or 0), lambda a, b: abs(a - b) <= max(10, b * 0.003)),
    }
    for m, (mine, live, ok) in checks.items():
        known = sorted(agg[m])
        if not ok(mine, live):
            report[m] = "dropped: rebuilt now-value %s vs live %s" % (mine, live)
        elif not known:
            report[m] = "not rebuilt: some log has no known value at any grid point"
        else:
            series[m] = agg[m]
            report[m] = "rebuilt from %s (now-value %s vs live %s)" % (_history_iso(known[0])[11:16], mine, live)
    unknown_at_start = [k for k in keys_all if at(k, grid[0]) == _RB_UNKNOWN] if grid else []
    gaps = [t for t in grid if t not in agg["points"]]
    if gaps:
        lt = max(gaps)
        report["_last_aggregate_gap"] = [_history_iso(lt), [Path(k).name for k in keys_all if at(k, lt) == _RB_UNKNOWN][:8]]
    report["_unknown_logs_at_grid_start"] = [Path(k).name for k in unknown_at_start][:12] + (["..."] if len(unknown_at_start) > 12 else [])

    # ---- PAIRS FILED: Swift wiring backups + git commits + the live files' mtime ---------------------
    try:
        cur_total = _rb_pairs_total(SECTIONS.read_text(encoding="utf-8", errors="replace"), STORE.read_text(encoding="utf-8", errors="replace"))
        live_total = int(live_state.get("total") or 0)
        if cur_total != live_total:
            report["pairs"] = "dropped: parsed %s vs live %s" % (cur_total, live_total)
        else:
            ppts = [(max(_mtime(SECTIONS) or 0, _mtime(STORE) or 0), cur_total)]
            for d in WIRING_BACKUPS.glob("*"):
                s_p, st_p = d / "NounBankSections.swift", d / "NounBankStore.swift"
                if s_p.exists() and st_p.exists():
                    ppts.append((max(_mtime(s_p), _mtime(st_p)), _rb_pairs_total(
                        s_p.read_text(encoding="utf-8", errors="replace"), st_p.read_text(encoding="utf-8", errors="replace"))))
            try:
                rel_s, rel_st = str(SECTIONS.relative_to(ROOT)), str(STORE.relative_to(ROOT))
                log = subprocess.run(["git", "-C", str(ROOT), "log", "--since=" + _history_iso(start), "--format=%H %ct", "--", rel_s, rel_st],
                                     capture_output=True, text=True, timeout=20).stdout.split("\n")
                for ln in log:
                    if not ln.strip():
                        continue
                    sha, ct = ln.split()
                    a = subprocess.run(["git", "-C", str(ROOT), "show", sha + ":" + rel_s], capture_output=True, text=True, timeout=20)
                    b = subprocess.run(["git", "-C", str(ROOT), "show", sha + ":" + rel_st], capture_output=True, text=True, timeout=20)
                    if a.returncode == 0 and b.returncode == 0:
                        ppts.append((float(ct), _rb_pairs_total(a.stdout, b.stdout)))
            except Exception:
                pass
            ppts.sort()
            times = [p[0] for p in ppts]
            vals = {}
            for t in grid:
                i = bisect.bisect_right(times, t) - 1
                if i >= 0:
                    vals[t] = ppts[i][1]
            if vals:
                series["pairs"] = vals
                report["pairs"] = "rebuilt from %s (%d snapshots: wiring backups, git, live mtime)" % (_history_iso(min(vals))[11:16], len(ppts))
            else:
                report["pairs"] = "not rebuilt: no snapshot inside the window"
    except Exception as exc:
        report["pairs"] = "error: %s" % exc

    # ---- top LOG cards (open progress logs): opened + line points straight from the log timelines ----------
    log_ok, log_drop = [], []
    for r in progress:
        if not r.get("artist") or r.get("status") == "done" or not r.get("path"):
            continue
        key = str(ROOT / r["path"])
        fin = finals.get(key)
        if key not in timelines or fin is None:
            continue
        lo, lp = int(r.get("opened") or 0), int(r.get("points") or 0)
        if abs(fin["opened"] - lo) > max(3, lo * 0.01) or abs(fin["points"] - lp) > max(10, lp * 0.01):
            log_drop.append(r["artist"])
            continue
        vo, vp = {}, {}
        for t in grid:
            st_ = at(key, t)
            if st_ == _RB_UNKNOWN:
                continue
            vo[t] = 0 if st_ == _RB_ABSENT else st_["opened"]
            vp[t] = 0 if st_ == _RB_ABSENT else st_["points"]
        if vo:
            series["log:" + r["artist"] + ":opened"] = vo
            series["log:" + r["artist"] + ":pts"] = vp
            log_ok.append(r["artist"] + " from " + _history_iso(min(vo))[11:16])
    report["log cards (opened, pts)"] = "rebuilt: " + ", ".join(log_ok) + ("; dropped (live mismatch): " + ", ".join(log_drop) if log_drop else "")

    # ---- CURRENT WORK % cards: only where the value is fixed by a file that has not changed since its mtime ----
    try:
        lv = _history_lane_values(live_state)
        tm = _mtime(TAKEOVER_STATUS)
        if tm:
            for k, v in lv.items():
                if k == "takeover" or k.startswith("sub:"):
                    vals = {t: v for t in grid if t >= tm}
                    if vals:
                        series["lane:" + k] = vals
                        report["lane:" + k] = "rebuilt: constant %s since takeover-status.json mtime %s" % (v, _history_iso(tm)[5:16])
        hm = _mtime(HARNESS_CHAT)
        if hm:
            vals = {t: (100 if t - hm < 120 else 35) for t in grid if t >= hm}
            if vals and vals[max(vals)] == lv.get("harness"):
                series["lane:harness"] = vals
                report["lane:harness"] = "rebuilt from the harness chat file mtime %s (status age known since then)" % _history_iso(hm)[5:16]
            else:
                report["lane:harness"] = "not rebuilt: chat file changed inside the window or disagrees with live"
        report["lane:watcher"] = "live only: depends on every Swift edit time, and only the latest mtime survives"
    except Exception as exc:
        report["lanes"] = "error: %s" % exc

    for m in ("catch-unconfirmed", "catch-unsure"):
        report[m] = ("not rebuilt: depends on candidate/verify files with no row timestamps; the only older value "
                     "(stats-window-baseline.json, written ~01:21 under pre-recheck rules) is not comparable")
    report["catch-confirmed / catch-rejected / catch-rereviewed / job:wiring"] = "kept from the earlier backfill (recheck.jsonl ts, confirmed-seq first_seen, wiring-log ts)"
    report.update({"_stats": stats, "_grid": [_history_iso(grid[0]), _history_iso(grid[-1])] if grid else []})

    rows = []
    for t in grid:
        row = {"ts": _history_iso(t), "t": float(t), "reconstructed": True, "tiles": {}, "artists": {}, "jobs": {}, "lanes": {}, "logs": {}}
        for m, vals in series.items():
            if t not in vals:
                continue
            if m.startswith("artist:"):
                row["artists"][m[7:]] = vals[t]
            elif m.startswith("lane:"):
                row["lanes"][m[5:]] = vals[t]
            elif m.startswith("log:"):
                row["logs"][m[4:]] = vals[t]
            elif m.startswith("job:"):
                row["jobs"][m[4:]] = vals[t]
            else:
                row["tiles"][m] = vals[t]
        if row["tiles"] or row["artists"] or row["jobs"] or row["lanes"] or row["logs"]:
            rows.append(row)
    if write:
        meta = {"_meta": {"version": REBUILD_VERSION, "built": _history_iso(now), "report": report}}
        tmp = REBUILT_FILE.with_suffix(".jsonl.tmp")
        with tmp.open("w", encoding="utf-8") as fh:
            fh.write(json.dumps(meta, ensure_ascii=False) + "\n")
            for row in rows:
                fh.write(json.dumps(row, separators=(",", ":"), ensure_ascii=False) + "\n")
            fh.flush()
            os.fsync(fh.fileno())
        tmp.replace(REBUILT_FILE)
    return report


def _rebuilt_current() -> bool:
    try:
        with REBUILT_FILE.open(encoding="utf-8") as fh:
            meta = json.loads(fh.readline() or "{}").get("_meta") or {}
        return meta.get("version") == REBUILD_VERSION
    except (OSError, ValueError):
        return False


def rebuild_history_cli(port: int = BOARD_PORT) -> dict:
    """Run the rebuild in a separate process against the running board's own endpoints."""
    from urllib.request import urlopen
    state = json.loads(urlopen("http://127.0.0.1:%d/api/state?gen=0" % port, timeout=120).read())
    jobs = json.loads(urlopen("http://127.0.0.1:%d/api/jobs" % port, timeout=60).read())
    return rebuild_history(state, jobs)


class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt: str, *args) -> None:
        return

    def do_GET(self) -> None:  # noqa: N802
        parsed = urlparse(self.path)
        if parsed.path in ("/", "/index.html"):
            body = PAGE.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)
            return
        if parsed.path == "/api/health":
            payload = {"ok": True}
            raw = json.dumps(payload).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(raw)))
            self.end_headers()
            self.wfile.write(raw)
            return
        if parsed.path == "/api/state":
            state = BOARD.refresh()
            query = parse_qs(parsed.query)
            client_gen = query.get("gen", ["0"])[0]
            client_rsig = query.get("rsig", [""])[0]
            roster_out = state.get("roster") or {}
            if client_rsig and client_rsig == roster_out.get("sig"):
                roster_out = {k: v for k, v in roster_out.items() if k not in ("rows", "people")}
                roster_out["unchanged"] = True
            if client_gen.isdigit() and int(client_gen) == state["gen"] and state["gen"] != 0:
                raw = json.dumps({
                    "unchanged": True,
                    "gen": state["gen"],
                    "live": state["live"],
                    "progress": state.get("progress", []),
                    "watch": state.get("watch", []),
                    "window": state.get("window", {}),
                    "roster": roster_out,
                    "takeover": state.get("takeover", {}),
                    "harness_age": (state.get("harness") or {}).get("age"),
                    "tile_bars": tile_bars(),
                }).encode("utf-8")
            else:
                raw = json.dumps({"unchanged": False, **state, "roster": roster_out, "tile_bars": tile_bars()}).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Content-Length", str(len(raw)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(raw)
            return
        if parsed.path == "/api/jobs":
            raw = json.dumps(jobs_snapshot()).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Content-Length", str(len(raw)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(raw)
            return
        if parsed.path == "/api/catches":
            raw = json.dumps(catch_counts()).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Content-Length", str(len(raw)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(raw)
            return
        if parsed.path == "/api/highlights":
            raw = json.dumps(load_highlights()).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Content-Length", str(len(raw)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(raw)
            return
        if parsed.path == "/api/history":
            query = parse_qs(parsed.query)
            metric = (query.get("metric", [""])[0] or "").strip()
            try:
                days = min(90.0, max(0.01, float(query["days"][0]))) if query.get("days") else HISTORY_VIEW_DAYS
            except ValueError:
                days = HISTORY_VIEW_DAYS
            try:
                series = history_series(metric, days) if metric else []
            except Exception:                         # tolerant: never break the board over history
                series = []
            raw = json.dumps(series).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Content-Length", str(len(raw)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(raw)
            return
        self.send_response(404)
        self.end_headers()


def main() -> None:
    server = ThreadingHTTPServer(("127.0.0.1", BOARD_PORT), Handler)
    print(f"PLAY_ON_WORDS_BOARD http://127.0.0.1:{BOARD_PORT}", flush=True)
    start_history_thread()
    server.serve_forever()


if __name__ == "__main__":
    main()
