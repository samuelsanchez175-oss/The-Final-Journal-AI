def _pid_alive(pid, needle: str = ""):
    """True/False from a single `ps -p PID`, cached; None when unknown."""
    if not pid:
        return None
    now = time.time()
    hit = _PID_CACHE.get(pid)
    if hit and now - hit[0] < PID_CACHE_SECONDS:
        return hit[1]
    import subprocess
    try:
        out = subprocess.run(["/bin/ps", "-p", str(int(pid)), "-o", "command="],
                             capture_output=True, text=True, timeout=5).stdout.strip()
        alive = bool(out) and (not needle or needle in out)
    except Exception:
        alive = hit[1] if hit else None
    _PID_CACHE[pid] = (now, alive)
    return alive


