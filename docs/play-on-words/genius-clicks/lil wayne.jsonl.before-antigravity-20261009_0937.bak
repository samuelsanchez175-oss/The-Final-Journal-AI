{"type": "line", "artist": "Lil Wayne", "song": "The Lost Carter IV Song", "line": "I’m not a HITman, I’m a HIT, maaaaaan", "vault_lines": ["Plus I 'ready told ya'll, I'm not a HITman, I'm a HIT, maaaaaan"], "meaning": "As in “I’m not a businessman, I’m a business, man”", "annotation_id": "358688", "url": "https://genius.com/358688", "state": "accepted", "votes": 3, "second_sense": true, "clicked": false, "click_status": "api", "strength": "accepted"}
{"type": "line", "artist": "Lil Wayne", "song": "The Lost Carter IV Song", "line": "The one ya boy ridin on is a little bit more SPESH-ull", "vault_lines": ["The one ya boy ridin on is a little bit more SPESH-ull"], "meaning": "Sounds like Jay’s syllable emphasis on his more recent, poppier hits, e.g. his verse on Beyonce’s “Deja Vu”:\n\nHova’s flow so unusual\nBaby girl you should already know\nit’s H-O\nlight up the dro\n‘cause you gon need help\ntryna study my\nbounce, flow glow", "annotation_id": "358685", "url": "https://genius.com/358685", "state": "accepted", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
