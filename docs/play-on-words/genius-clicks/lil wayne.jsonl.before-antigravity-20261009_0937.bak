{"type": "line", "artist": "Lil Wayne", "song": "Peanuts 2 N Elephant", "line": "What up, though? All my niggas cutthroat", "vault_lines": ["What up, though? All my niggas cutthroat"], "meaning": "I cannot confirm if this is the original song but Lil Wayne interpolates what I recognise to be Cutthroat by Royce Da 5'9\" and SchoolboyQ from The Book of Ryan project.", "annotation_id": "35817026", "url": "https://genius.com/35817026", "state": "pending", "votes": -16, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
