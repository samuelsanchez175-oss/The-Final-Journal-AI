{"type": "line", "artist": "Lil Wayne", "song": "Yall Aint Fuckin Wit Me", "line": "U.S. lets get Clinton elected back", "vault_lines": ["U.S. lets get Clinton elected back"], "meaning": "Some feel that life in America was better under President Bill Clinton than under George W. Bush and that we should find some way to get Clinton back in office. (Which would be legally impossible as he served two full terms.)", "annotation_id": "10708853", "url": "https://genius.com/10708853", "state": "accepted", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
{"type": "line", "artist": "Lil Wayne", "song": "Yall Aint Fuckin Wit Me", "line": "Ringin in the school classroom like I’m Zach Morris", "vault_lines": ["Young field still young, name ringin in the school classroom like I'm Zach Morris"], "meaning": "Zack Morris was a fictional character played by actor Mark-Paul Gosselar on the late 1989-1993 sitcom Saved by the Bell.", "annotation_id": "10708836", "url": "https://genius.com/10708836", "state": "accepted", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
