{"type": "line", "artist": "Lil Wayne", "song": "Put Some Keys On That", "line": "Have you seen her? Who? Nina, she’s on my hip", "vault_lines": ["Have you seen her? Who? Nina, she's on my hip"], "meaning": "When Wayne says Nina, he’s referring to his 9 mm pistol. He has personified his gun many times throughout his mixtape songs.", "annotation_id": "35687364", "url": "https://genius.com/35687364", "state": "pending", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
