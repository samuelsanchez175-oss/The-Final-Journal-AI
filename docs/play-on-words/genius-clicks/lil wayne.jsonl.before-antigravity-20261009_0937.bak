{"type": "line", "artist": "Lil Wayne", "song": "Set It Off (Remix Radio)", "line": "And somethin’ on my wrist colder than a Coors Light", "vault_lines": ["And somethin' on my wrist colder than a Coors Light"], "meaning": "Wayne’s got watches with lots of diamonds in them, looking like ice, while Coors Light is a cold alcoholic beverage with a recurring theme of snow and ice in their adverts", "annotation_id": "2279250", "url": "https://genius.com/2279250", "state": "pending", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
{"type": "line", "artist": "Lil Wayne", "song": "Set It Off (Remix Radio)", "line": "Respect me or get a shot to where you gather your thoughts", "vault_lines": ["Respect me or get a shot to where you gather your thoughts"], "meaning": "Most people think with their heads, specifically their brains. Wayne presumably knows that you will be wearing a bulletproof vest, so a hit will need to be in a vulnerable area", "annotation_id": "2279245", "url": "https://genius.com/2279245", "state": "pending", "votes": 2, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
