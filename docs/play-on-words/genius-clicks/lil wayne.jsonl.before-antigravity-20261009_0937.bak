{"type": "line", "artist": "Lil Wayne", "song": "We ’Bout That (Eat the Cake)", "line": "I ball out like the ninth inning", "vault_lines": ["I ball out like the ninth inning"], "meaning": "During a baseball game, which is typically nine innings, the last inning is certainly the time for players to go crazy and show off, especially if the score is close.\n\nGo big or go home", "annotation_id": "1416666", "url": "https://genius.com/1416666", "state": "accepted", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
