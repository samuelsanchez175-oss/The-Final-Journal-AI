{"type": "line", "artist": "Lil Wayne", "song": "Swagger From Us", "line": "Ballin’ so hard man, I deserve a Naismith award", "vault_lines": ["Ballin' so hard man, I deserve a Naismith award"], "meaning": "The Naismith Award is the NCAA’s equivalent to the NBA’s MVP. It is given to the most outstanding athlete of the year. There is both a female and a male winner.\n\n\n\n2010-2011 Winners", "annotation_id": "379135", "url": "https://genius.com/379135", "state": "accepted", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
