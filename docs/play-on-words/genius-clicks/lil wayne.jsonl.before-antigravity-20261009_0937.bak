{"type": "line", "artist": "Lil Wayne", "song": "Phone Home", "line": "And if you feel like you’re the best Go ’head and do the Weezy-We", "vault_lines": ["Go 'head and do the Weezy-We"], "meaning": "Most rappers feel that they’re the best rapper in the world, but Lil Wayne takes it a step further and that he believes he’s not the best rapper in the world because his talent for Succeeds the world.", "annotation_id": "29171480", "url": "https://genius.com/29171480", "state": "pending", "votes": 2, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
