{"type": "line", "artist": "Lil Wayne", "song": "Siri", "line": "Siri backwards spell Iris", "vault_lines": ["Ooh, Siri backwards spell Iris"], "meaning": "Iris is a part of the eye. Sticking with the theme of the song 2 Chainz is reiterating that they cannot use smartphones because the feds are watching.", "annotation_id": "24275019", "url": "https://genius.com/24275019", "state": "pending", "votes": 2, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
