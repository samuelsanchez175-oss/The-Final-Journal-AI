{"type": "line", "artist": "Lil Wayne", "song": "Sweat", "line": "When I step on stage, them hoes sweat like I’m Keith", "vault_lines": ["Yeah, YMCMB, when I step on stage, them hoes sweat like I’m Keith"], "meaning": "Referring to Keith Sweat. He’s saying girls get hot and bothered when they see him. So much that they begin to sweat.", "annotation_id": "418452", "url": "https://genius.com/418452", "state": "accepted", "votes": 2, "second_sense": true, "clicked": false, "click_status": "api", "strength": "accepted"}
{"type": "line", "artist": "Lil Wayne", "song": "Sweat", "line": "Shawty wanna be my boo like showtime at the Apollo", "vault_lines": ["Shawty wanna be my boo like showtime at the Apollo"], "meaning": "The audiences at Showtime at the Apollo are known to be hard on performers and to boo them off stage if they are not impressed.\n\nhttps://www.youtube.com/watch?v=E00q3cKwuvM\n\nSometimes the audience is just plain retarded like when they booed at Lauryn Hill!", "annotation_id": "398585", "url": "https://genius.com/398585", "state": "accepted", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "accepted"}
