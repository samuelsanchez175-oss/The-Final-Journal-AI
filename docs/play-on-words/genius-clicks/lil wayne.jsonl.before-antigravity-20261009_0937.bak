{"type": "line", "artist": "Lil Wayne", "song": "Sex In The Lounge", "line": "We didn’t use a rubber, but I came on her body", "vault_lines": ["We didn't use a rubber, but I came on her body"], "meaning": "Instead of using a condom Lil Wayne used the pull-out method.", "annotation_id": "24736044", "url": "https://genius.com/24736044", "state": "pending", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
{"type": "line", "artist": "Lil Wayne", "song": "Sex In The Lounge", "line": "P.R. at the Heat game", "vault_lines": ["P.R. at the Heat game"], "meaning": "Nicki is in this case, using the term Public Relations as a metaphor for Public Displays of Affection or PDA, which they will display at the Miami Heat Basketball Game, like many other celebrity couples do.\n\nBey & Jay say hi.", "annotation_id": "2417896", "url": "https://genius.com/2417896", "state": "accepted", "votes": 7, "second_sense": true, "clicked": false, "click_status": "api", "strength": "accepted"}
