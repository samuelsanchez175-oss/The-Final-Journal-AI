{"type": "line", "artist": "Lil Wayne", "song": "Talk 2 Me", "line": "I love your body girl, There’s no denying that I will not rest, I will not sleep, like an insomniac", "vault_lines": ["I love your body girl, There's no denying that"], "meaning": "Somebody who suffers from Insomnia is somebody who has trouble sleeping and Wayne is so obsessed with this girl that he’s up all night thinking about her and her body instead of sleeping.", "annotation_id": "3487100", "url": "https://genius.com/3487100", "state": "pending", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
