{"type": "line", "artist": "Lil Wayne", "song": "Sweetest Girl (Dollar Bill)", "line": "She take the loss ’cause she don’t wanna see her child lose", "vault_lines": ["She take the loss 'cause she don't wanna see her child lose"], "meaning": "Sex work has a physical and mental toll on her but she takes the loss because she wants to afford a better future for her child", "annotation_id": "38248294", "url": "https://genius.com/38248294", "state": "pending", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
