{"type": "line", "artist": "Lil Wayne", "song": "Tina Turn Up Needs a Tune Up (Freestyle)", "line": "I could sell Sweet’N Low to Sugar Ray Leonard", "vault_lines": ["I could sell Sweet'N Low to Sugar Ray Leonard"], "meaning": "Weezy is so good at what he does, he can sell artificial sweeteners to the retired boxer Sugar Ray Leonard.", "annotation_id": "3230155", "url": "https://genius.com/3230155", "state": "accepted", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
