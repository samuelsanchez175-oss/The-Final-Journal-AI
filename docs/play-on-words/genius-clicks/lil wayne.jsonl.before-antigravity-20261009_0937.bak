{"type": "line", "artist": "Lil Wayne", "song": "Slip", "line": "Y’all niggas like extra skin on my dick Y’all niggas like extra skin on my dick", "vault_lines": ["Y'all niggas like extra skin on my dick"], "meaning": "Lil Wayne uses this song’s hook as an opportunity to confirm his penis status. Thank you, Lil Wayne! Very cool!\n-Penis Police", "annotation_id": "29694974", "url": "https://genius.com/29694974", "state": "pending", "votes": -9, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
