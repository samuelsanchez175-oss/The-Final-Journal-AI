{"type": "line", "artist": "Lil Wayne", "song": "SportsCenter", "line": "Basketball", "vault_lines": ["My favorite TV shows, man, is SportsCenter"], "meaning": "Lil Wayne is a fan of the Los Angeles Lakers. New Orleans originally had the Jazz franchise that left for Utah. In 2002 the city received another franchise, the Hornets, from Charlotte. They have since been rebranded as the Pelicans.", "annotation_id": "33163624", "url": "https://genius.com/33163624", "state": "pending", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
{"type": "line", "artist": "Lil Wayne", "song": "SportsCenter", "line": "Of course", "vault_lines": ["My favorite TV shows, man, is SportsCenter"], "meaning": "Like most Americans, Wayne’s favorite sport is gridiron football.", "annotation_id": "33163612", "url": "https://genius.com/33163612", "state": "pending", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
