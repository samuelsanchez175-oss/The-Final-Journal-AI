{"type": "line", "artist": "Lil Wayne", "song": "RUNAWAY", "line": "[Verse 2: Lil Wayne]", "vault_lines": ["Say I do too much, okay"], "meaning": "Lil Wayne did not collaborate with Kid Rohan. Rather, Kid bought an existing verse off the internet as detailed in his video behind the creation of the song.", "annotation_id": "39523808", "url": "https://genius.com/39523808", "state": "pending", "votes": 3, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
