{"type": "line", "artist": "Lil Wayne", "song": "Words Of Advice", "line": "Got your girl walking ’round my crib in her underclothes", "vault_lines": ["Got your girl walking ’round my crib in her underclothes"], "meaning": "I made your girlfriend walk around my house in her underwear. Crib in hip-hop generally does not mean baby’s crib, but one’s residence. Made famous by MTV Show Cribs", "annotation_id": "197548", "url": "https://genius.com/197548", "state": "accepted", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
