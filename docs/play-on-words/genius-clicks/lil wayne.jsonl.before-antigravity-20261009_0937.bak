{"type": "line", "artist": "Lil Wayne", "song": "Thank You", "line": "When me and Abstract together, see we deliver", "vault_lines": ["Dammit, we sinners, when me and Abstract together, see we deliver"], "meaning": "“Abstract” is, of course, Q-Tip. These two have worked together often, and they always deliver.", "annotation_id": "27850807", "url": "https://genius.com/27850807", "state": "pending", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
