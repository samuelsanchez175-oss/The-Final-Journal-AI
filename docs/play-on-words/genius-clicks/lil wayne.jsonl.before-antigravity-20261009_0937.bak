{"type": "line", "artist": "Lil Wayne", "song": "Runnin’", "line": "Yeah! I’m runnin’ out of time,", "vault_lines": ["Yeah! I'm runnin' out of time,"], "meaning": "Lil Wayne is running out of time. He is getting older. He only has a little bit of time to make things right in his life, and he is close to retirement. He said here that he wants to retire by the age of 35.", "annotation_id": "2430346", "url": "https://genius.com/2430346", "state": "accepted", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
