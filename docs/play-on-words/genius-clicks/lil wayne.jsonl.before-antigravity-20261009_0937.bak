{"type": "line", "artist": "Lil Wayne", "song": "Weezy’s Ambitions", "line": "Fifty thousand for the cross, trying keep the reaper off me", "vault_lines": ["Fifty thousand for the cross, trying keep the reaper off me"], "meaning": "Al Capone donated to churches, believing it would right his wrong.\n\nLil Wayne spending $50,000 on a cross to help blind the darkness from seeing him.", "annotation_id": "34225341", "url": "https://genius.com/34225341", "state": "pending", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
