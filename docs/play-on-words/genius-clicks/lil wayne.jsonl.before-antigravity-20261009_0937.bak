{"type": "line", "artist": "Lil Wayne", "song": "Su Woo", "line": "You better change like it’s Mardi Gras", "vault_lines": ["You better change like it's Mardi Gras"], "meaning": "Correction: We wear them chains like it’s Mardi Gras\n\nReferring to how their necklaces are plenty like beads at Mardi Gras", "annotation_id": "18844464", "url": "https://genius.com/18844464", "state": "pending", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
