{"type": "line", "artist": "Lil Wayne", "song": "Yellow Tape", "line": "Attention please, attention please This feel like the whole entire world collapsed", "vault_lines": ["Attention please, attention please"], "meaning": "A reference to Busta Rhyme’s intro to Funkmaster Flex’s “Ante Up (Remix)” by M.O.P.\n\nhttp://www.youtube.com/watch?v=PLT68mI5Pwc#t=0m20s", "annotation_id": "1194226", "url": "https://genius.com/1194226", "state": "accepted", "votes": 3, "second_sense": true, "clicked": false, "click_status": "api", "strength": "accepted"}
