{"type": "line", "artist": "Lil Wayne", "song": "Upgrade", "line": "Nigga, we in charge, baby, put me in charge", "vault_lines": ["Nigga, we in charge, baby, put me in charge"], "meaning": "Birdman (aka Baby) put Wayne front and center on his Young Money label, and mentored him as a leader of their set.", "annotation_id": "30619175", "url": "https://genius.com/30619175", "state": "pending", "votes": 2, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
{"type": "line", "artist": "Lil Wayne", "song": "Upgrade", "line": "Like a bitch with some lips like Angelin’ ’Na Jolie,", "vault_lines": ["Like a bitch with some lips like Angelin'"], "meaning": "American actress Angelina Jolie was known for her voluptuous lips.", "annotation_id": "30619172", "url": "https://genius.com/30619172", "state": "pending", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
