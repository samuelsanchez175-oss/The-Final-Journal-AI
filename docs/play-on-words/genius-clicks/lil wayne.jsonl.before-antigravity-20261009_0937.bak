{"type": "line", "artist": "Lil Wayne", "song": "Sorry 4 the Wait", "line": "Yeah, $hort bring the drank, I bring the blunts", "vault_lines": ["Yeah, $hort bring the drank, I bring the blunts"], "meaning": "Short Dawg (who now goes by Fre$h) is a former Young Money artist.\n\nHe’s from Houston, Texas, where ‘drank’ originated", "annotation_id": "40792849", "url": "https://genius.com/40792849", "state": "pending", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
