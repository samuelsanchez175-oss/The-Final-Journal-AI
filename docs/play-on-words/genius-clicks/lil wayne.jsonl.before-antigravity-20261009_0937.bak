{"type": "line", "artist": "Lil Wayne", "song": "Rich Niggaz", "line": "Juvenile used to be R-T-A bound", "vault_lines": ["Juvenile used to be R-T-A bound"], "meaning": "Juvenile used to catch the bus. The New Orleans Regional Transit Authority, or RTA for short, is the name of the bus system where Juvie grew up.", "annotation_id": "1322156", "url": "https://genius.com/1322156", "state": "accepted", "votes": 6, "second_sense": true, "clicked": false, "click_status": "api", "strength": "accepted"}
