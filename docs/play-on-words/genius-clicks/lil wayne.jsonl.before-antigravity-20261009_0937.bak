{"type": "line", "artist": "Lil Wayne", "song": "Rari", "line": "Shirt off, guns showin’ like O’Malley, nigga", "vault_lines": ["Shirt off, guns showin' like O'Malley, nigga"], "meaning": "This is a reference to UFC fighter Sean “Suga” O’Malley,. Funny enough, O'Malley fought in a UFC match the day after this song was released at UFC 316.", "annotation_id": "35822217", "url": "https://genius.com/35822217", "state": "accepted", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "accepted"}
