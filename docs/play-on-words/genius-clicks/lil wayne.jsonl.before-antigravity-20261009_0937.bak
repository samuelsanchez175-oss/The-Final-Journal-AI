{"type": "line", "artist": "Lil Wayne", "song": "Space Jam", "line": "I got contact from that Mary", "vault_lines": ["I had a shot of that Henny, I got contact from that Mary"], "meaning": "Smokin' on some strong\n\nHe got a contact high from being in the vicinity of marijuana smoke. For him to catch a contact, it must be very potent weed.", "annotation_id": "1989766", "url": "https://genius.com/1989766", "state": "accepted", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "accepted"}
