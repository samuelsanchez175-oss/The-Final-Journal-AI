{"type": "line", "artist": "Lil Uzi Vert", "song": "spend the money", "line": "PEDs", "vault_lines": ["Didn't take my meds, switched it out with PEDs"], "meaning": "“PEDs” stands for “Performance Enhancing Drugs”.\n\nThese are substances used to improve athletic performance, muscle growth, endurance, or recovery.", "annotation_id": "34422887", "url": "https://genius.com/34422887", "state": "pending", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
