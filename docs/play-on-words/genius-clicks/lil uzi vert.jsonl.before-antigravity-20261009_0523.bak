{"type": "line", "artist": "Lil Uzi Vert", "song": "Thot Back", "line": "I just popped a E, ain’t feelin’ my jaws (Yeah)", "vault_lines": ["I just popped a E, ain't feelin' my jaws (Yeah)"], "meaning": "Taking an Ecstasy tab is referred to as popping a “E.” Ecstasy frequently causes numbness in the face as a side effect.", "annotation_id": "27692215", "url": "https://genius.com/27692215", "state": "pending", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
{"type": "line", "artist": "Lil Uzi Vert", "song": "Thot Back", "line": "She got a fat pussy, ain’t gon’ hit it raw (Thot)", "vault_lines": ["She got a fat pussy, ain't gon' hit it raw (Thot)"], "meaning": "“Fat pussy” means only the outer lips are visible so the labia minora, clitoris, and vaginal opening are not out in the open. Hitting it raw refers to sexual acts without a condom.", "annotation_id": "27692179", "url": "https://genius.com/27692179", "state": "pending", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
