{"type": "line", "artist": "Lil Uzi Vert", "song": "The Rush", "line": "Big Time Rush", "vault_lines": ["[Intro: Big Time Rush"], "meaning": "While credited as the group Big Time Rush, only Kendall Schmidt, James Maslow and Logan Henderson appear in this intro section as Carlos PenaVega declined to be featured.\n\nhttps://www.complex.com/music/a/markelibert/big-time-rush-carlos-penavega-guest-feature-lil-uzi-vert", "annotation_id": "38202564", "url": "https://genius.com/38202564", "state": "pending", "votes": 3, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
{"type": "line", "artist": "Lil Uzi Vert", "song": "The Rush", "line": "Shout out to Baby 16, yeah They always be rockin’ with me, yeah", "vault_lines": ["Shout out to Baby 16, yeah"], "meaning": "“Shout out to Baby 16” refers to Lil Uzi Vert’s hometown block (1600 in Philly), he shouts them out saying “They always be rockin’ with me” stating that they never left his side and stay with him to this day.", "annotation_id": "36806402", "url": "https://genius.com/36806402", "state": "pending", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
