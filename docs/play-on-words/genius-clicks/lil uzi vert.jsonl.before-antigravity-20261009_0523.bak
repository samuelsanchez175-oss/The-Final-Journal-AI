{"type": "line", "artist": "Lil Uzi Vert", "song": "What Is Cómo Se Llama", "line": "She give me medulla, ’til that oblongata, uh", "vault_lines": ["She give me medulla, 'til that oblongata, uh"], "meaning": "The medulla oblongata is a part of the brain that controls breathing, heart rate and blood pressure. It connects the bottom of the brain stem to the spinal cord.", "annotation_id": "34429499", "url": "https://genius.com/34429499", "state": "pending", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
