{"type": "line", "artist": "Lil Uzi Vert", "song": "Too Much Sauce", "line": "Got diamonds on all on my fingers, that’s too much sauce", "vault_lines": ["Got diamonds on all on my fingers, that's too much sauce"], "meaning": "Buying yourself a 22-carat canary yellow diamond ring to celebrate the release of your new album…\n\n\n\nNow that’s too much sauce!", "annotation_id": "10480090", "url": "https://genius.com/10480090", "state": "accepted", "votes": 19, "second_sense": true, "clicked": false, "click_status": "api", "strength": "accepted"}
