{"type": "line", "artist": "Lil Uzi Vert", "song": "Vetements Jeans", "line": "Doing donuts", "vault_lines": ["Uh, went to sleep, huh, yeah, woke up with a bag"], "meaning": "“Doing Donuts” refers to a very common technique done with cars where the driver will press on the gas while turning in one direction at the same time.", "annotation_id": "35529607", "url": "https://genius.com/35529607", "state": "pending", "votes": -1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
