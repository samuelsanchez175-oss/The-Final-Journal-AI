{"type": "line", "artist": "YoungBoy Never Broke Again", "song": "Ms. Gaulden", "line": "She got the eyes of a cat, she had to stole it", "vault_lines": ["She got the eyes of a cat, she had to stole it"], "meaning": "A reference to cartoons where cats are painted as their for stealing things such as jewelry or milk . In this case his wife is the cat and he’s the item or thing she stole.", "annotation_id": "38020014", "url": "https://genius.com/38020014", "state": "pending", "votes": 3, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
