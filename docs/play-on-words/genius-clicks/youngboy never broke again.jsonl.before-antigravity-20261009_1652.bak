{"type": "line", "artist": "YoungBoy Never Broke Again", "song": "RIP", "line": "Dead prezis, I’m on a killin’ spree", "vault_lines": ["Dead prezis, I'm on a killin' spree (Killin')"], "meaning": "Dead prezis, or presidents, is slang for dollar bills. Because Youngboy has accumulated so many “dead presidents,” he compares it to going on a killing spree.", "annotation_id": "20643565", "url": "https://genius.com/20643565", "state": "pending", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
