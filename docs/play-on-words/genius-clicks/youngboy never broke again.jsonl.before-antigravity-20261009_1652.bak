{"type": "line", "artist": "YoungBoy Never Broke Again", "song": "Hold Me Down", "line": "I’m into it with my mama, I’m dealin’ with problems", "vault_lines": ["I'm into it with my mama, I'm dealin' with problems"], "meaning": "Youngboy has had some issues with his mother, Sherhonda Gaulden in the past. He has got kicked out of the house and got into a social media feud as well.", "annotation_id": "24043540", "url": "https://genius.com/24043540", "state": "pending", "votes": 7, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
