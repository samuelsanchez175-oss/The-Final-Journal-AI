{"type": "line", "artist": "YoungBoy Never Broke Again", "song": "Off Season", "line": "Fentanyl", "vault_lines": ["Young nigga walkin' with that fentanyl"], "meaning": "Fentanyl is a synthetic opioid that can be used for pain relief in healthcare. The effect of fentanyl is similar to that of heroin, but some of the different types of fentanyl can be one hundred times stronger than morphine for each unit of weight, depending on the exact composition.", "annotation_id": "22381880", "url": "https://genius.com/22381880", "state": "pending", "votes": 3, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
{"type": "line", "artist": "YoungBoy Never Broke Again", "song": "Off Season", "line": "She ain’t know what to do, she had asked me to pick it", "vault_lines": ["She ain't know what to do, she had asked me to pick it"], "meaning": "This was most likely this girl’s first time having access to this much money and she couldn’t decide what she wanted to buy.", "annotation_id": "21165621", "url": "https://genius.com/21165621", "state": "pending", "votes": 7, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
