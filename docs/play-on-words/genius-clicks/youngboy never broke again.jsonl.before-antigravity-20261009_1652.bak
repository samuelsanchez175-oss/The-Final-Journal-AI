{"type": "line", "artist": "YoungBoy Never Broke Again", "song": "L.O.V.E.H.A.T.E", "line": "Up with your strap, I up right back You playin’ rugby", "vault_lines": ["Up with your strap, I up right back"], "meaning": "Upping your strap (gun) on YB could turn out badly for you. YB considers this raw D (Defense) because it gives YB the opportunity to flip things over, causing you to face the consequences.", "annotation_id": "37806731", "url": "https://genius.com/37806731", "state": "pending", "votes": 3, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
