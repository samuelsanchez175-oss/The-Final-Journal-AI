{"type": "line", "artist": "YoungBoy Never Broke Again", "song": "Not Wrong Now", "line": "Thank God I got my own now, feel that I’m not wrong now", "vault_lines": ["Thank God I got my own now, feel that I'm not wrong now"], "meaning": "YoungBoy feels that he finally made it and that his past of struggles and criminality does not matter because he has done something right by becoming a successful rapper.", "annotation_id": "25790621", "url": "https://genius.com/25790621", "state": "pending", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
