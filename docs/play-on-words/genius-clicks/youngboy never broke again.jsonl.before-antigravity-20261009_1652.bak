{"type": "line", "artist": "YoungBoy Never Broke Again", "song": "Thug Nigga Story", "line": "My uncle Saint Charles taught me the game, he was my Berry Gordy", "vault_lines": ["My uncle Saint Charles taught me the game, he was my Berry Gordy"], "meaning": "E40’s uncle St. Charles was a businessman and soul musician who brought inspiration to his nephew Earl, thus “teaching him the game” like Motown executive Berry Gordy mentored various artists.", "annotation_id": "27835762", "url": "https://genius.com/27835762", "state": "pending", "votes": 2, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
