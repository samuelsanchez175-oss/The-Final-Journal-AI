{"type": "line", "artist": "Drake", "song": "Housekeeping Knows", "line": "Know you see it pokin’ out, I never miss no meals", "vault_lines": ["I know you be with it, with it", "Know you see it pokin' out, I never miss no meals"], "meaning": "Latto is referring to her butt when she is wearing shorts.\n\nEating a quantity of food is commonly associated with having more accumulated fat to the butt among woman.", "annotation_id": "32712286", "url": "https://genius.com/32712286", "state": "pending", "votes": 2, "second_sense": true, "clicked": true, "click_status": "open", "strength": "weak"}
