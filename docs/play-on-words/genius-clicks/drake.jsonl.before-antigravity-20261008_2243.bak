{"type": "line", "artist": "Drake", "song": "Friends", "line": "Lay her down and fold her like that shit you put a file in", "vault_lines": [], "meaning": "Sexual metaphor — comparing intimacy to folding papers into a file folder.", "annotation_id": "36879942", "url": "https://genius.com/36879942", "state": "pending", "votes": 0, "second_sense": true, "clicked": true, "click_status": "open", "strength": "weak"}
