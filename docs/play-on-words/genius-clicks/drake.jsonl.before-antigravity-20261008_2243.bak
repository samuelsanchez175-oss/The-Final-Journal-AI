{"type": "line", "artist": "Drake", "song": "SOMETHING ABOUT YOU", "line": "After that, we should get intimate, baby", "vault_lines": ["After that, we should get intimate, baby"], "meaning": "Once they’ve talked and connected emotionally, he shifts toward physical intimacy.", "annotation_id": "41629949", "url": "https://genius.com/41629949", "state": "pending", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
