{"type": "line", "artist": "Drake", "song": "Light Up", "line": "Promise to always give you me, the real me", "vault_lines": ["Promise to always give you me, the real me"], "meaning": "Even through all his fame and success, Drake promises to not change (a common topic in this album) without changing his ways though the influence of money.", "annotation_id": "36761195", "url": "https://genius.com/36761195", "state": "pending", "votes": 0, "second_sense": true, "clicked": true, "click_status": "open", "strength": "weak"}
