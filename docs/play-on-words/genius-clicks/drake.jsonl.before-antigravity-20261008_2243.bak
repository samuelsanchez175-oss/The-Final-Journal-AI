{"type": "line", "artist": "Drake", "song": "WNBA", "line": "Askin’ what we are ’cause we never laid out no conditions", "vault_lines": ["Askin' what we are 'cause we never laid out no conditions"], "meaning": "This person is asking, “what we are” questioning if they are committed or are they just Friends With benefits. The times they do see one another, they do not spend much time identifying if they are together or not.", "annotation_id": "39959582", "url": "https://genius.com/39959582", "state": "pending", "votes": 0, "second_sense": true, "clicked": true, "click_status": "open", "strength": "weak"}
