{"type": "line", "artist": "Drake", "song": "Video Girl", "line": "Nice guys finish last so I’m winnin every race that I enter and she a", "vault_lines": ["Nice guys finish last so I'm winnin every race that I enter and she a"], "meaning": "Drake is not a nice guy. Therefore, he doesn’t finish last… he finishes first!", "annotation_id": "36146581", "url": "https://genius.com/36146581", "state": "pending", "votes": 0, "second_sense": true, "clicked": true, "click_status": "open", "strength": "weak"}
