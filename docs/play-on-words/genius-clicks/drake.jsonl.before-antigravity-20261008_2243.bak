{"type": "line", "artist": "Drake", "song": "I’m Still", "line": "ATL", "vault_lines": [], "meaning": "Drake shout outs All Things Fresh. His clique + first official website before OVO Blogspot.", "annotation_id": "23722034", "url": "https://genius.com/23722034", "state": "pending", "votes": 0, "second_sense": true, "clicked": true, "click_status": "open", "strength": "weak"}
{"type": "line", "artist": "Drake", "song": "I’m Still", "line": "Hoppin’ on a jet to every single Lil Wayne show", "vault_lines": [], "meaning": "Reference to when Lil Wayne had signed Drake, and brought him on the I Am Music Tour for The Carter III.", "annotation_id": "23508005", "url": "https://genius.com/23508005", "state": "pending", "votes": 0, "second_sense": true, "clicked": true, "click_status": "open", "strength": "weak"}
{"type": "line", "artist": "Drake", "song": "I’m Still", "line": "My brother P-Reign knows", "vault_lines": [], "meaning": "Reference to P-Reign aka Preme, a Toronto rapper from Scarborough.", "annotation_id": "23507999", "url": "https://genius.com/23507999", "state": "pending", "votes": 0, "second_sense": true, "clicked": true, "click_status": "open", "strength": "weak"}
{"type": "line", "artist": "Drake", "song": "I’m Still", "line": "Got these women jockin’ me from Heart Lake Road to Pickerin", "vault_lines": [], "meaning": "This is a reference to all of the Greater Toronto Area (GTA). Heart Lake Road being located in the West of the GTA, and Pickering in the East.", "annotation_id": "23507988", "url": "https://genius.com/23507988", "state": "pending", "votes": 0, "second_sense": true, "clicked": true, "click_status": "open", "strength": "weak"}
