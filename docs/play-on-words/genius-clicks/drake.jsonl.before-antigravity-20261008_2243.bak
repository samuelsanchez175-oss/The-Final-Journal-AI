{"type": "line", "artist": "Drake", "song": "Congratulations", "line": "Aunty Doe, tell ’em I deserve a mazel tov", "vault_lines": ["Aunty Doe, tell 'em I deserve a mazel tov"], "meaning": "“Mazel tov” means “congratulations” in Hebrew.  Drake is espousing his Judaism with this bar.", "annotation_id": "29842456", "url": "https://genius.com/29842456", "state": "pending", "votes": 0, "second_sense": true, "clicked": true, "click_status": "open", "strength": "weak"}
