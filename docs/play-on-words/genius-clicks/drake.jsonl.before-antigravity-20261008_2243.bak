{"type": "line", "artist": "Drake", "song": "No Lie", "line": "Young as an intern (Intern)", "vault_lines": ["Young as an intern (Intern)"], "meaning": "The average intern age is 19 to 21 years old, typically corresponding to college sophomores or juniors. However, there is no maximum age limit for internships, and older adults frequently intern for career changes.", "annotation_id": "41043651", "url": "https://genius.com/41043651", "state": "pending", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
