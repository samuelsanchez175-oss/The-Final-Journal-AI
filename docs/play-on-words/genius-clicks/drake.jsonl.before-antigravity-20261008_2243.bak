{"type": "line", "artist": "Drake", "song": "Headlines", "line": "Then she wanna ask when it got so empty", "vault_lines": ["Then she wanna ask when it got so empty"], "meaning": "Drake is saying that someone notices his life has become emotionally empty despite his success.", "annotation_id": "40550645", "url": "https://genius.com/40550645", "state": "pending", "votes": -1, "second_sense": true, "clicked": true, "click_status": "open", "strength": "weak"}
