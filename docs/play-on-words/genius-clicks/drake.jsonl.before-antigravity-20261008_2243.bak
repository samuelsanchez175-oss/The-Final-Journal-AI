{"type": "line", "artist": "Drake", "song": "Friends With Money", "line": "Pick any place in the world, the dough is comin’ in steady", "vault_lines": ["Pick any place in the world, the dough is comin' in steady"], "meaning": "Flexing financial freedom. He can take a woman (or anyone he wants) anywhere, because money’s flowing consistently.", "annotation_id": "36879935", "url": "https://genius.com/36879935", "state": "pending", "votes": 0, "second_sense": true, "clicked": true, "click_status": "open", "strength": "weak"}
{"type": "line", "artist": "Drake", "song": "Friends With Money", "line": "It’s light work, flow is heavy like a wet sponge", "vault_lines": ["It's light work, flow is heavy like a wet sponge"], "meaning": "He’s saying rapping is easy for him (“light work”), but his delivery still feels heavy and impactful, like a soaked sponge that carries surprising weight.", "annotation_id": "36879932", "url": "https://genius.com/36879932", "state": "pending", "votes": 0, "second_sense": true, "clicked": true, "click_status": "open", "strength": "weak"}
{"type": "line", "artist": "Drake", "song": "Friends With Money", "line": "Celebratin’ Father’s day every day so don’t get sonned", "vault_lines": ["Celebratin' Father's day every day so don't get sonned"], "meaning": "Wordplay on “Father’s Day.” To “son” someone means to disrespect them as inferior or younger.", "annotation_id": "36879925", "url": "https://genius.com/36879925", "state": "pending", "votes": 0, "second_sense": true, "clicked": true, "click_status": "open", "strength": "weak"}
{"type": "line", "artist": "Drake", "song": "Friends With Money", "line": "Havin’ dinner at Chateau’s", "vault_lines": ["Havin' dinner at Chateau's"], "meaning": "Chateau Marmont in Los Angeles, a hotel with a restaurant where celebs (like Lindsay Lohan) are known to hang", "annotation_id": "169209", "url": "https://genius.com/169209", "state": "accepted", "votes": 0, "second_sense": true, "clicked": true, "click_status": "open", "strength": "weak"}
