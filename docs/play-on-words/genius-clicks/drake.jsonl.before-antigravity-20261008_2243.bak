{"type": "line", "artist": "Drake", "song": "Still Fly", "line": "Got these women jockin’ me from Heart Lake Road to Pickerin", "vault_lines": [], "meaning": "This is a reference to all of the Greater Toronto Area (GTA). Heart Lake Road being located in the West of the GTA, and Pickering in the East.", "annotation_id": "23507988", "url": "https://genius.com/23507988", "state": "pending", "votes": 0, "second_sense": true, "clicked": true, "click_status": "open", "strength": "weak"}
