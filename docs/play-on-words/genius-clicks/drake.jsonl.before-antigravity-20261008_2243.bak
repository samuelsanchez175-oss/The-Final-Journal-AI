{"type": "line", "artist": "Drake", "song": "Uuugly", "line": "Please don’t make me, please don’t make me Don’t make me pull out these credit card statements and show you the proof", "vault_lines": ["Please don't make me, please don't make me", "Don’t make me pull out these credit card statements and show you the proof"], "meaning": "sad teary statements to receipts of what they spent together.\n\nit could be moments or items such as clothing, or jewelry, maybe even cars.", "annotation_id": "40737905", "url": "https://genius.com/40737905", "state": "pending", "votes": 0, "second_sense": true, "clicked": true, "click_status": "open", "strength": "weak"}
