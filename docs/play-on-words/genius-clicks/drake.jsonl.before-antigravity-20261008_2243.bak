{"type": "line", "artist": "Drake", "song": "Calling For You", "line": "Yeah, I was in the club, but I was in the cut", "vault_lines": ["I was in the club 'fore she even had it", "Yeah, I was in the club, but I was in the cut"], "meaning": "Drake is in the club but not in the middle of the action (dance floor). He is likely in a tucked away section, on his phone, thinking of his next instagram caption.", "annotation_id": "36860420", "url": "https://genius.com/36860420", "state": "pending", "votes": 0, "second_sense": true, "clicked": true, "click_status": "open", "strength": "weak"}
