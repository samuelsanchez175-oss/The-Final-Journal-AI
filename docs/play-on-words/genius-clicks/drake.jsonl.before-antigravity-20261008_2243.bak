{"type": "line", "artist": "Drake", "song": "NO SECRET", "line": "So whole time on defense", "vault_lines": ["So whole time on defense"], "meaning": "As a result, he stays guarded, never letting his guard down, because he knows betrayal can come from those smiling in his face.", "annotation_id": "36604306", "url": "https://genius.com/36604306", "state": "pending", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
