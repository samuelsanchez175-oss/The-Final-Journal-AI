{"type": "line", "artist": "Drake", "song": "Summer Games", "line": "How you go from that to endin’ up with someone just like", "vault_lines": ["You liking someone just like me", "How you go from that to endin' up with someone just like"], "meaning": "The confusion he’s lost in she didn’t want him but goes for someone almost exactly the same.", "annotation_id": "31123677", "url": "https://genius.com/31123677", "state": "pending", "votes": 6, "second_sense": true, "clicked": true, "click_status": "open", "strength": "weak"}
