{"type": "line", "artist": "Drake", "song": "To The Floor", "line": "(Zone 4!)", "vault_lines": [], "meaning": "Zone 4 is a record label that was founded by Polow da Don in 2007. It operates as a joint venture between him and Interscope Records.\nCurrent artists on the label include Keri Hilson, Veronica Vega and Summerella.", "annotation_id": "22753956", "url": "https://genius.com/22753956", "state": "pending", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
