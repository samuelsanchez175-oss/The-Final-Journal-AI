{"type": "line", "artist": "Drake", "song": "Trance (Demo)", "line": "My trust is in “In God We Trust”", "vault_lines": ["My trust is in \"In God We Trust\""], "meaning": "“In god we trust” is the official moto of the United States, which is printed on the US Dollar. Meaning travis only trusts money.", "annotation_id": "29413879", "url": "https://genius.com/29413879", "state": "pending", "votes": 0, "second_sense": true, "clicked": true, "click_status": "open", "strength": "weak"}
{"type": "line", "artist": "Drake", "song": "Trance (Demo)", "line": "I see the pain, I see the pain in your eyes Somehow I relate tonight", "vault_lines": ["I see the pain, I see the pain in your eyes", "Somehow I relate tonight"], "meaning": "Drake relates to the pain this female is feeling. They may share a night together where they indulge in numbing their pain", "annotation_id": "28095260", "url": "https://genius.com/28095260", "state": "pending", "votes": 0, "second_sense": true, "clicked": true, "click_status": "open", "strength": "weak"}
