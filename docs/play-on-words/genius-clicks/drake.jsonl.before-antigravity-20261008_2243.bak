{"type": "line", "artist": "Drake", "song": "Friends", "line": "It’s light work, flow is heavy like a wet sponge", "vault_lines": [], "meaning": "He’s saying rapping is easy for him (“light work”), but his delivery still feels heavy and impactful, like a soaked sponge that carries surprising weight.", "annotation_id": "36879932", "url": "https://genius.com/36879932", "state": "pending", "votes": 0, "second_sense": true, "clicked": true, "click_status": "open", "strength": "weak"}
{"type": "line", "artist": "Drake", "song": "Friends", "line": "Celebratin’ Father’s day every day so don’t get sonned", "vault_lines": [], "meaning": "Wordplay on “Father’s Day.” To “son” someone means to disrespect them as inferior or younger.", "annotation_id": "36879925", "url": "https://genius.com/36879925", "state": "pending", "votes": 0, "second_sense": true, "clicked": true, "click_status": "open", "strength": "weak"}
