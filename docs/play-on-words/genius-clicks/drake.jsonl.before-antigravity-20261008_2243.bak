{"type": "line", "artist": "Drake", "song": "Still Fly", "line": "Hoppin’ on a jet to every single Lil Wayne show", "vault_lines": [], "meaning": "Reference to when Lil Wayne had signed Drake, and brought him on the I Am Music Tour for The Carter III.", "annotation_id": "23508005", "url": "https://genius.com/23508005", "state": "pending", "votes": 0, "second_sense": true, "clicked": true, "click_status": "open", "strength": "weak"}
