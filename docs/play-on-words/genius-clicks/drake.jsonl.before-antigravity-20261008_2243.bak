{"type": "line", "artist": "Drake", "song": "Crew Love", "line": "Why? ’Cause they loving the crew They loving the crew They loving the crew Oh, they loving the crew Oh, they loving the crew They loving the crew They loving the crew They loving the crew, woah", "vault_lines": ["Why? 'Cause they loving the crew", "They loving the crew", "Oh, they loving the crew", "They loving the crew, woah", "Loving the crew, oh"], "meaning": "i guess they loving the crew", "annotation_id": "37757722", "url": "https://genius.com/37757722", "state": "pending", "votes": 12, "second_sense": false, "clicked": true, "click_status": "open", "strength": "weak"}
