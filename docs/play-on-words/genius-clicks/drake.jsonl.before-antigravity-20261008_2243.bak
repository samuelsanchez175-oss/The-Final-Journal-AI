{"type": "line", "artist": "Drake", "song": "OMW", "line": "We’re face to face in the crowd", "vault_lines": ["We're face to face in the crowd"], "meaning": "When Kim Kardashian showed up to Drake’s concert.", "annotation_id": "39847665", "url": "https://genius.com/39847665", "state": "pending", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
