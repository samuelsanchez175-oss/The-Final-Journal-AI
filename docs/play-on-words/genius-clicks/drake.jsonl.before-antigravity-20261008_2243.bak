{"type": "line", "artist": "Drake", "song": "Hush It Up", "line": "I would never ever ever call Millie hot", "vault_lines": ["I would never ever ever call Millie hot"], "meaning": "He denies that he has ever had a physical connection with actor Mille Bobby Brown, which people think he had a relationship with when she was underaged.", "annotation_id": "31978426", "url": "https://genius.com/31978426", "state": "pending", "votes": 0, "second_sense": true, "clicked": true, "click_status": "open", "strength": "weak"}
{"type": "line", "artist": "Drake", "song": "Hush It Up", "line": "Ima diss you with 21, my honey bun (teehee!)", "vault_lines": ["Ima diss you with 21, my honey bun (teehee!)"], "meaning": "Drake refers to rapper 21 Savage, who Drake has always had a close friendship with.", "annotation_id": "31978385", "url": "https://genius.com/31978385", "state": "pending", "votes": 0, "second_sense": true, "clicked": true, "click_status": "open", "strength": "weak"}
