{"type": "line", "artist": "Drake", "song": "Another Late Night", "line": "Concrete", "vault_lines": [], "meaning": "“Concrete” is an ad-lib reference to Concrete Boys (or Concrete Family), Lil Yachty’s creative collective and record label imprint. Yachty frequently drops the tag across his tracks and features to shout out his team and signify their unbreakable bond.", "annotation_id": "41593074", "url": "https://genius.com/41593074", "state": "pending", "votes": 0, "second_sense": true, "clicked": true, "click_status": "open", "strength": "weak"}
