{"type": "line", "artist": "Drake", "song": "Solid", "line": "She a diamond", "vault_lines": ["She want a demon, yeah", "She want a ring or some sort of arrangement, yeah", "She quick to say, \"No,\" 'cause she know she a diamond", "She on a diet, she want a massage, yeah"], "meaning": "A woman being described as a diamond means that she makes you smile and has a genuine connection with you.", "annotation_id": "28558726", "url": "https://genius.com/28558726", "state": "pending", "votes": 7, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
