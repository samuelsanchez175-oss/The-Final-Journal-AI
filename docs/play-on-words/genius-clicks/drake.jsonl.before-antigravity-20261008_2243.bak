{"type": "line", "artist": "Drake", "song": "Fountains", "line": "Come in, come in, yeah, come in", "vault_lines": ["Come in, come in, yeah, come in", "Woah, oh, come in, come in, yeah, come in", "Come in and stay here", "It's in thе air tonight, yeah, yeah, yeah"], "meaning": "Drake is suggesting a BBC to “come in,yeah, come in”", "annotation_id": "33208012", "url": "https://genius.com/33208012", "state": "pending", "votes": -14, "second_sense": true, "clicked": true, "click_status": "open", "strength": "weak"}
