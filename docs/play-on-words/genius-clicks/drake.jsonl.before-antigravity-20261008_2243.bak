{"type": "line", "artist": "Drake", "song": "Free Spirit", "line": "Tat my name on you so I know it’s real Tat my fuckin’ name on you so I know it’s real", "vault_lines": ["Tat my name on you, girl, so I know it's real", "Tat my fuckin' name on you so I know it's real", "Tat my name on you so I know it's real", "Tat my fuckin' name on you when I go, you'll still be mine, yeah", "Tat my fuckin' name on you, let 'em know you love the boy", "Tat my fuckin' name on you, let these niggas know it's real"], "meaning": ".", "annotation_id": "30425245", "url": "https://genius.com/30425245", "state": "pending", "votes": -7, "second_sense": false, "clicked": true, "click_status": "open", "strength": "weak"}
