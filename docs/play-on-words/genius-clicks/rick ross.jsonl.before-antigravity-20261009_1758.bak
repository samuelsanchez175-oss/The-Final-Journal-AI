{"type": "line", "artist": "Rick Ross", "song": "Color Money", "line": "Until the day we even, schemin’ till you bring it back", "vault_lines": ["Until the day we even, schemin' till you bring it back"], "meaning": "PROPOSED SUGGESTION:\n\nHe says “Until we even, schemin, til you bring it back”\n\nMeaning he and his boys will be plotting on you until they get even with you.", "annotation_id": "8320096", "url": "https://genius.com/8320096", "state": "pending", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
