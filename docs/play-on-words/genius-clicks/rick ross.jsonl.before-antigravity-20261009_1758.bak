{"type": "line", "artist": "Rick Ross", "song": "Diced Pineapples", "line": "Tonight you shall reach a height that the sky won’t catch you The highest form of my admiration", "vault_lines": ["The highest form of my admiration"], "meaning": "It’s a poetic way of saying your feelings are extremely deep and uplifting—like your admiration will push someone to their highest potential or emotional “peak,” beyond limits or expectations.", "annotation_id": "39474127", "url": "https://genius.com/39474127", "state": "pending", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
