{"type": "line", "artist": "Rick Ross", "song": "Pots and Pans", "line": "Quarter ki’ box of soda, Ross whip that", "vault_lines": ["Quarter ki' box of soda, Ross whip that"], "meaning": "Baking soda is a key essential in cooking dope.\nYOLA and Arm and Hammer seem to be the most popular between the rappers.", "annotation_id": "888854", "url": "https://genius.com/888854", "state": "pending", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
