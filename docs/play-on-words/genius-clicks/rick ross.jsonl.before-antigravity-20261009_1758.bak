{"type": "line", "artist": "Rick Ross", "song": "Tupac Back", "line": "Stranded on Death Row", "vault_lines": ["Stranded on Death Row"], "meaning": "This could be a reference to “Deathrow records” which 2pac signed to when he got out of prison in 1995, just 11 months before his death.", "annotation_id": "187668", "url": "https://genius.com/187668", "state": "pending", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
