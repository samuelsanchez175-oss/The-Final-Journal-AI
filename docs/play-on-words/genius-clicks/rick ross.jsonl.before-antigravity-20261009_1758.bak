{"type": "line", "artist": "Rick Ross", "song": "Kobe or Ginobili (Remix)", "line": "Ridin! With my Rolls from New Orleans", "vault_lines": ["Ridin! With my Rolls from New Orleans"], "meaning": "Since Ross landed in New Orleans to record this verse in Macks hometown, he bought an expensive luxury car instead of renting one, even though his stay is temporary.", "annotation_id": "1830083", "url": "https://genius.com/1830083", "state": "accepted", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
