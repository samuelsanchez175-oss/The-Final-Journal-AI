{"type": "line", "artist": "Rick Ross", "song": "Think Like a Man", "line": "Penthouse, at the Trump, sit on Collins Ave", "vault_lines": ["Penthouse, at the Trump, sit on Collins Ave"], "meaning": "Ross resides in the Trump Towers (Sunny Isles Beach), which is located on Collins Avenue. Sunny Side Beach is a suburb of Miami.", "annotation_id": "618643", "url": "https://genius.com/618643", "state": "accepted", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
