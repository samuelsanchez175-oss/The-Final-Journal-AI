{"type": "line", "artist": "Rick Ross", "song": "Maybach Music 2", "line": "Martin Louis the King Jr.", "vault_lines": ["Martin Louis the King Jr."], "meaning": "This is a reference to Kanye West demanding that he be addressed as “Martin Louis The King Jr.” (a play on Martin Luther King Jr.), a name that came to him when he saw the shoes he designed for Louis Vuitton hit the runway.\n\nhttps://www.youtube.com/watch?v=XKREGO_4vJM", "annotation_id": "28596800", "url": "https://genius.com/28596800", "state": "pending", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
