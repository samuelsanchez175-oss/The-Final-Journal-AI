{"type": "line", "artist": "Rick Ross", "song": "Deep in the Game", "line": "My jewels drip like ice", "vault_lines": [], "meaning": "Ross is referring to his Dripping Ice MMG Chain:\n\n\n\nWhich is “ice”, (a Hip Hop synonym for jewelry), and drips like melting icicles off of a branch:", "annotation_id": "1672115", "url": "https://genius.com/1672115", "state": "pending", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
