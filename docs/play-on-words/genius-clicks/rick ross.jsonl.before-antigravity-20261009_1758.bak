{"type": "line", "artist": "Rick Ross", "song": "White Girl (Remix)", "line": "Yeah I put my tax on it, You don’t want it leave it then", "vault_lines": ["Yeah I put my tax on it, You don't want it leave it then"], "meaning": "Everything cost money, life takes band$. Yes Jeezy will charge you his tax for his services. He is a business man. If you have a problem with paying his tax, you can bounce.", "annotation_id": "9112468", "url": "https://genius.com/9112468", "state": "pending", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
