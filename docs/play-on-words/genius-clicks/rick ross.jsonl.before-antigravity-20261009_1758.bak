{"type": "line", "artist": "Rick Ross", "song": "The Summer’s Mine", "line": "Deadman walking, decomposing body", "vault_lines": ["Deadman walking, decomposing body"], "meaning": "Jeezy is The Walking Dead for fucking with Ross. His buzz was slowing decomposing, like a dead body. Basically, Ross will turn Jeezy into a zombie.", "annotation_id": "1455638", "url": "https://genius.com/1455638", "state": "accepted", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
