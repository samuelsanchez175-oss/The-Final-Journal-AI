{"type": "line", "artist": "Rick Ross", "song": "What It Is", "line": "Bring another band get yourself a pound of midget", "vault_lines": ["Bring another band get yourself a pound of midget"], "meaning": "If you bring another $1,000 when you go to buy your brick, Zoe will throw in a pound of mid-grade marijuana (“Midget”).", "annotation_id": "4335218", "url": "https://genius.com/4335218", "state": "accepted", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "accepted"}
