{"type": "line", "artist": "Rick Ross", "song": "Bill Gates", "line": "Uh, ya heard me", "vault_lines": ["Uh, ya heard me"], "meaning": "This beat was inspired by old Cash Money/No Limit. In New Orleans, it is a common saying to say, “Ya Heard Me” frequently. http://youtu.be/SvO73fHiY1g", "annotation_id": "7751793", "url": "https://genius.com/7751793", "state": "accepted", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "accepted"}
{"type": "line", "artist": "Rick Ross", "song": "Bill Gates", "line": "I told that bitch to save my number in her phone under Bill Gates, ya heard me", "vault_lines": ["I told that bitch to save my number in her phone under Bill Gates, ya heard me"], "meaning": "Ricky Rozay has so much cash that you may as well call him Bill Gates, CEO of Microsoft, and super rich guy.", "annotation_id": "7739665", "url": "https://genius.com/7739665", "state": "accepted", "votes": 2, "second_sense": true, "clicked": false, "click_status": "api", "strength": "accepted"}
