{"type": "line", "artist": "Rick Ross", "song": "Push Em Over (50 Cent & Lloyd Banks Diss)", "line": "You’re embrassing your colleagues", "vault_lines": ["You're embrassing your colleagues"], "meaning": "According to Ross, 50 Cent is an embarrassment to Dr. Dre and Eminem.", "annotation_id": "1586071", "url": "https://genius.com/1586071", "state": "accepted", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
