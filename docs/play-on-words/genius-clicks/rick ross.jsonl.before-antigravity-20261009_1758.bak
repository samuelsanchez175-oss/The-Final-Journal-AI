{"type": "line", "artist": "Rick Ross", "song": "Kyrie", "line": "Steven Curry, Under Armour on my gang", "vault_lines": ["Steven Curry, Under Armour on my gang"], "meaning": "Stephen Curry is another world-class NBA player.\n\nUnder Armour is a brand of sportswear, popular with many athletes including basketball teams.\n\nRick is assuring us that his crew are high class.", "annotation_id": "11109297", "url": "https://genius.com/11109297", "state": "pending", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
{"type": "line", "artist": "Rick Ross", "song": "Kyrie", "line": "Work, jumping out the gym like it’s Lebron James", "vault_lines": ["Work, jumping out the gym like it's Lebron James"], "meaning": "LeBron James, Kyrie’s teammate, has a 44 inch vertical jump, one of the highest that the NBA has ever seen.", "annotation_id": "10831474", "url": "https://genius.com/10831474", "state": "accepted", "votes": 2, "second_sense": true, "clicked": false, "click_status": "api", "strength": "accepted"}
{"type": "line", "artist": "Rick Ross", "song": "Kyrie", "line": "We cruising La Brea like we was Mexican", "vault_lines": ["We cruising La Brea like we was Mexican"], "meaning": "La Brea Avenue is a prominent street in Los Angeles known for having “diverse ethnic communities”.", "annotation_id": "10830819", "url": "https://genius.com/10830819", "state": "accepted", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "accepted"}
{"type": "line", "artist": "Rick Ross", "song": "Kyrie", "line": "Bought 20 kilos, coulda bought Miami subs", "vault_lines": ["Bought 20 kilos, coulda bought Miami subs"], "meaning": "Miami Subs Grill (commonly “Miami Subs”) was purchased by Pitbull a couple of years ago.\n\nIt was sold for a couple of millions. Here Ross is bragging he bought 20kg of coke instead.\n\nRoss is notably the owner of Wing Stop.\n\n\n\nhttp://www.miamiherald.com/latest-news/article1941495.html", "annotation_id": "10826351", "url": "https://genius.com/10826351", "state": "accepted", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "accepted"}
