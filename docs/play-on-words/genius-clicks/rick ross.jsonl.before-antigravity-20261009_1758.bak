{"type": "line", "artist": "Rick Ross", "song": "Hell’s Angels (American Heathens)", "line": "Got the Milq buzzin’ like beehives,", "vault_lines": ["Got the Milq buzzin' like beehives,"], "meaning": "“Milq City” is the nickname of Stalley’s hometown, Massillon, Ohio. His recent rise to fame is putting his city on the map. .", "annotation_id": "674560", "url": "https://genius.com/674560", "state": "accepted", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "accepted"}
