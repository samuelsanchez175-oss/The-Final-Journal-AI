{"type": "line", "artist": "Rick Ross", "song": "Veteran’s Day", "line": "Junior doing time, kicking up his feet", "vault_lines": ["Junior doing time, kicking up his feet"], "meaning": "Yet another of Waynes nicknames, this one came about because of the ‘fatherly’ way that Birdman took care of him and helped his career\n\nBirdman acknowledges Wayne’s recent time spent in prison and away from the game", "annotation_id": "54089", "url": "https://genius.com/54089", "state": "accepted", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
{"type": "line", "artist": "Rick Ross", "song": "Veteran’s Day", "line": "Thousand dollar cologne", "vault_lines": [], "meaning": "Considering the most expensive cologne in the world – Clive Christian No. 1 – can be had for $650 a bottle, this sounds like an exaggeration..", "annotation_id": "53990", "url": "https://genius.com/53990", "state": "accepted", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
