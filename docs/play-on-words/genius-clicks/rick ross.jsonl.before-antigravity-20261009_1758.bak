{"type": "line", "artist": "Rick Ross", "song": "Super Freak", "line": "Hit that jam squad Sam Sneak", "vault_lines": ["Hit that jam squad Sam Sneak"], "meaning": "Sam Sneak is the founder of the Jam Squad DJs entertainment group. He is also the official DJ for Rick Ross and A&R of Ross’s label Maybach Music Group.", "annotation_id": "18812556", "url": "https://genius.com/18812556", "state": "accepted", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
{"type": "line", "artist": "Rick Ross", "song": "Super Freak", "line": "Aces in New York, it got the super freaks", "vault_lines": ["Aces in New York, it got the super freaks"], "meaning": "Aces New York was a nightclub in the Long Island City area of New York City. The club was shut down in late 2017 after its liquor license was revoked.", "annotation_id": "18811085", "url": "https://genius.com/18811085", "state": "accepted", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
{"type": "line", "artist": "Rick Ross", "song": "Super Freak", "line": "Fuck a bougie bitch, I need a super freak", "vault_lines": ["Fuck a bougie bitch, I need a super freak"], "meaning": "The word bougie originated from the French word bourgeois which means coming from the middle-upperclass population. It refers to a girl that trys to act more popular and than she is.", "annotation_id": "11104983", "url": "https://genius.com/11104983", "state": "accepted", "votes": 2, "second_sense": true, "clicked": false, "click_status": "api", "strength": "accepted"}
{"type": "line", "artist": "Rick Ross", "song": "Super Freak", "line": "Had my suite for eight months tucked in the Fountaine Bleue", "vault_lines": ["Had my suite for eight months tucked in the Fountaine Bleue"], "meaning": "The Fountaine Bleue is a luxury hotel and club located at the Miami Beach.", "annotation_id": "11104980", "url": "https://genius.com/11104980", "state": "accepted", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "accepted"}
{"type": "line", "artist": "Rick Ross", "song": "Super Freak", "line": "Magnums on me, I’m not going out like Eazy", "vault_lines": ["Magnums on me, I'm not going out like Eazy"], "meaning": "Rapper Eazy-E, a member of N.W.A, died from HIV after having unprotected sex.\nTory references Eazy’s death to explain why he carries condoms on him.", "annotation_id": "10736137", "url": "https://genius.com/10736137", "state": "accepted", "votes": 9, "second_sense": true, "clicked": false, "click_status": "api", "strength": "accepted"}
