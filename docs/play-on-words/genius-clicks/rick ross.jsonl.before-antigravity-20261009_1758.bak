{"type": "line", "artist": "Rick Ross", "song": "Ring Ring", "line": "Crib big as Turner Field so you know we rich forever", "vault_lines": ["Crib big as Turner Field so you know we rich forever"], "meaning": "Turner Field was the baseball stadium that housed the Atlanta Braves from 1997 to 2016. In 2017, it was renovated and reconstructed as the Center Parc Stadium, and now it’s the home stadium of the Georgia State University Panthers.\n\n\nTurner Field\n\n\nCenter Parc Stadium", "annotation_id": "38960224", "url": "https://genius.com/38960224", "state": "pending", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
