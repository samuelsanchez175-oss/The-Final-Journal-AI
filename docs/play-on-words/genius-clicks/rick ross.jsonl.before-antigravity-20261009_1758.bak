{"type": "line", "artist": "Rick Ross", "song": "Panera Bread", "line": "Rocky Balboa, how I beat boys", "vault_lines": ["Rocky Balboa, how I beat boys"], "meaning": "Ross uses Rocky Balboa, a fictional boxer from the Rocky series to reference how he “beats boys”.", "annotation_id": "1682929", "url": "https://genius.com/1682929", "state": "accepted", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
{"type": "line", "artist": "Rick Ross", "song": "Panera Bread", "line": "Got that broccoli cheddar soup with that Panera bread", "vault_lines": ["Got that broccoli cheddar soup with that Panera bread"], "meaning": "Cheddar, broccoli, and bread are all synonyms for money. Broccoli cheddar soup is also a delicious menu item at Panera Bread, making this a double entendre.", "annotation_id": "1682794", "url": "https://genius.com/1682794", "state": "accepted", "votes": 3, "second_sense": true, "clicked": false, "click_status": "api", "strength": "accepted"}
