{"type": "song", "artist": "Rick Ross", "song": "Can’t Be Broke", "status": "done", "targets": 0, "clicked": 0, "genius_url": "https://genius.com/Rick-ross-cant-be-broke-lyrics", "genius_title": "Can’t Be Broke", "genius_id": 7453675, "source": "api"}
