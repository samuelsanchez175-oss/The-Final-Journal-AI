{"type": "line", "artist": "Rick Ross", "song": "Do What I Do", "line": "The Aztec, Olmec", "vault_lines": [], "meaning": "The Aztec & Olmec are both Mesoamerican civilizations wich lived in present-day Mexico.\nThe Aztec lived there from the 14th – 16th century and the Olmec 1500 – 400 BCE.", "annotation_id": "40711166", "url": "https://genius.com/40711166", "state": "pending", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
