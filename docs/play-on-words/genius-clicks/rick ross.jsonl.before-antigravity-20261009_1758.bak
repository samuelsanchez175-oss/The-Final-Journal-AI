{"type": "line", "artist": "Rick Ross", "song": "Us", "line": "You know 305, Ricky, that’s my fucking nigga", "vault_lines": ["You know 305, Ricky, that's my fucking nigga"], "meaning": "305 is the Miami area code.\n\nRick Ross is a Miami native, who collaborates with Drake frequently.", "annotation_id": "1120439", "url": "https://genius.com/1120439", "state": "accepted", "votes": 16, "second_sense": true, "clicked": false, "click_status": "api", "strength": "accepted"}
