{"type": "line", "artist": "Rick Ross", "song": "Inkredible", "line": "Big boy money bitch, pockets on Charlie Wise", "vault_lines": ["Big boy money bitch, pockets on Charlie Wise"], "meaning": "Charlie Weis is an American football coach who is currently the head football coach at the University of Kansas. He wears his pants above his Bellybutton and is overweight so it appears he has big pockets.", "annotation_id": "707742", "url": "https://genius.com/707742", "state": "accepted", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
