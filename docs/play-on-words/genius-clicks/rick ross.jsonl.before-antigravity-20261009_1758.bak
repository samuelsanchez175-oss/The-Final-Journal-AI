{"type": "line", "artist": "Rick Ross", "song": "Aiight", "line": "MMG, self made pay one up", "vault_lines": ["MMG, self made pay one up"], "meaning": "Now he is successful, and signed to Maybach Music Group. He was signed in 2011, and was on the labels album Self Made, Vol.1 ( first of 3, so far). He even has this chain to rep his label.", "annotation_id": "4387590", "url": "https://genius.com/4387590", "state": "pending", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
