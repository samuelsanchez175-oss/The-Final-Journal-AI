{"type": "line", "artist": "Rick Ross", "song": "9 Piece", "line": "No sir, not me", "vault_lines": ["No sir, not me"], "meaning": "That line (and the accompanying clip in the music video) has since gone viral, often used in social media posts and comments to express emphatic denial.", "annotation_id": "19014920", "url": "https://genius.com/19014920", "state": "pending", "votes": 6, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
