{"type": "line", "artist": "Rick Ross", "song": "2 Shots", "line": "Two shots, pour Belaire or the Blue Dot", "vault_lines": ["Two shots, pour Belaire or the Blue Dot"], "meaning": "He wants two shots of Luc Belaire Rare Rose, a sparkling Rose from the South of France – well endorsed by Rick Ross, or a shot of Ciroc Vodka", "annotation_id": "8323154", "url": "https://genius.com/8323154", "state": "pending", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
