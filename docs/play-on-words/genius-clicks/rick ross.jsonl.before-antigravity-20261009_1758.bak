{"type": "line", "artist": "Rick Ross", "song": "Panera Bread", "line": "Shit I ball so hard I make ’em wanna forfeit", "vault_lines": ["Shit I ball so hard I make 'em wanna forfeit"], "meaning": "Whereas Jay-Z only balled hard enough to incur a fine from his adversaries, Rockie is such a baller that anybody who opposes him simply accepts defeat.", "annotation_id": "1683378", "url": "https://genius.com/1683378", "state": "accepted", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
