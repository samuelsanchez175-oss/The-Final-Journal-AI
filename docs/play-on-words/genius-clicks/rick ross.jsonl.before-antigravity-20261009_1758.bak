{"type": "line", "artist": "Rick Ross", "song": "Quiet Storm", "line": "Uncut like escobars exports My bitch butt like escobars escort I’m thinking escobars next thoughts", "vault_lines": ["Uncut like escobars exports", "My bitch butt like escobars escort", "I'm thinking escobars next thoughts"], "meaning": "Pablo Escobar was a well known Colombian drug lord. He successfully trafficked Cocaine and was a rich criminal. He was assassinated on December 2nd, 1994.", "annotation_id": "998998", "url": "https://genius.com/998998", "state": "accepted", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "accepted"}
