{"type": "line", "artist": "Rick Ross", "song": "Lamborghini Doors", "line": "At the Grammys, my lil’ homie had the hammer on him", "vault_lines": ["At the Grammys, my lil' homie had the hammer on him"], "meaning": "Similar situation to the one Kendrick faced on Institutionalized, taking his friends to an award show without realizing it’s a completely different scenario to the ghetto. Or it’s just the habit of carrying something due to paranoia.", "annotation_id": "30561921", "url": "https://genius.com/30561921", "state": "pending", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
{"type": "line", "artist": "Rick Ross", "song": "Lamborghini Doors", "line": "Now we comin’ up like them Lamborghini doors, ooh", "vault_lines": ["Now we comin' up like them Lamborghini doors, ooh"], "meaning": "Meek Mill is referring to the Lamborghini Aventador, whose suicide doors rise up out in the air instead of pull to the side.", "annotation_id": "18581248", "url": "https://genius.com/18581248", "state": "pending", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
