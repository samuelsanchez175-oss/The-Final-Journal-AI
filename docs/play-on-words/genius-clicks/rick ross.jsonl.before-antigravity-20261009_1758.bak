{"type": "line", "artist": "Rick Ross", "song": "Living Better Now", "line": "Pull up in Pakistan like I’m Evel Knievel", "vault_lines": ["Pull up in Pakistan like I’m Evel Knievel"], "meaning": "Evel Knievel, born Robert Craig Knievel, was an American daredevil, entertainer, and international icon. In his career he attempted over 75 ramp-to-ramp motorcycle jumps between 1965 and 1980, and in 1974, a failed jump across Snake River Canyon.", "annotation_id": "2182262", "url": "https://genius.com/2182262", "state": "accepted", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
{"type": "line", "artist": "Rick Ross", "song": "Living Better Now", "line": "Christian Louboutin, sucker for a sneaker", "vault_lines": ["Christian Louboutin, sucker for a sneaker"], "meaning": "Christian Louboutin is a French footwear designer whose footwear has incorporated shiny, red-lacquered soles. His company has recently set up a separate website focused on protecting the brand and detailing more than 3,000 websites that sell fake goods.", "annotation_id": "2182258", "url": "https://genius.com/2182258", "state": "accepted", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
