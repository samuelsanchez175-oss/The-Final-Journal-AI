{"type": "line", "artist": "Rick Ross", "song": "BCGMMG (Remix)", "line": "Bumpin’ Tela nigga “I’m so tired of ballin’”", "vault_lines": ["Bumpin' Tela nigga \"I'm so tired of ballin'\""], "meaning": "Reference to Memphis rapper Tela’s song “Tired of Ballin'” from his album, Piece of Mind that came out in 1996. .", "annotation_id": "751549", "url": "https://genius.com/751549", "state": "accepted", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
{"type": "line", "artist": "Rick Ross", "song": "BCGMMG (Remix)", "line": "Rock came, I served somethin’", "vault_lines": ["Rock came, I served somethin'"], "meaning": "Meek used to sell cocaine.", "annotation_id": "715736", "url": "https://genius.com/715736", "state": "accepted", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
