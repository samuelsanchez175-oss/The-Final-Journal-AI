{"type": "line", "artist": "Rick Ross", "song": "Kobe or Ginobili (Remix)", "line": "Montana 102 Baby Ace Hood This the remix! Rick Ross! Mackey Ray Cyrus Busta Rhymes", "vault_lines": [], "meaning": "Basically naming everyone who is hitting in on the remix…Ace Hood, French Montana, Rick Ross, Busta Rhymes.\n\nMack+ Miley Ray Cyrus= Mackey Ray Cyrus…..Mack Maine has had a crush on Miley Cyrus", "annotation_id": "1806863", "url": "https://genius.com/1806863", "state": "accepted", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "accepted"}
{"type": "line", "artist": "Rick Ross", "song": "Kobe or Ginobili (Remix)", "line": "Bitch I ball hard like Kobe or Ginobili Bitch I ball hard like Kobe or Ginobili", "vault_lines": ["Bitch I ball hard like Kobe or Ginobili"], "meaning": "Mack balls (hustles) like Kobe or Ginobili two distinguished NBA players, but in this line he’s either referencing his extravagant lifestyle or dope dealing – either way he’s balling.", "annotation_id": "1802476", "url": "https://genius.com/1802476", "state": "accepted", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
