{"type": "line", "artist": "Rick Ross", "song": "City Lights", "line": "Grey Phantom, orange Hermès seats in it (Yeah, ooh)", "vault_lines": ["Grey Phantom, orange Hermès seats in it (Yeah, ooh)"], "meaning": "After securing the purchase, Ross hopped on stories to show off the new addition to his collection.\n\n“This is the 2025 one-of-one Mansory Phantom Rolls-Royce with the Hermes guts!”", "annotation_id": "40785495", "url": "https://genius.com/40785495", "state": "pending", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
