{"type": "line", "artist": "Rick Ross", "song": "I Don’t Give A Fuck", "line": "Fuck that rap shit, I’m a gangster I don’t get stressed nigga, I get shit poppin’", "vault_lines": ["Fuck that rap shit, I’m a gangster", "I don’t get stressed nigga, I get shit poppin'"], "meaning": "He doesn’t have any cred or anything to prove, he gets straight to business", "annotation_id": "7446094", "url": "https://genius.com/7446094", "state": "pending", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
