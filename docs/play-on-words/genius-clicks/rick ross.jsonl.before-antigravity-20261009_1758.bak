{"type": "line", "artist": "Rick Ross", "song": "Timeless", "line": "I ain’t get a letter from my homies one time But she was there for me , ain’t missed one time", "vault_lines": ["But she was there for me , ain't missed one time"], "meaning": "While in jail he didn’t get any letters from his so called friends, but his girl wrote to him every day.", "annotation_id": "307295", "url": "https://genius.com/307295", "state": "accepted", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
