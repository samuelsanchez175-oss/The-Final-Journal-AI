{"type": "line", "artist": "Rick Ross", "song": "Karate Chop (RichMix)", "line": "Hustle like I’m Makaveli", "vault_lines": ["HUH! Hustle like I'm Makaveli"], "meaning": "Makaveil is a nickname for late Hip-Hop legend Tupac Shakur. Shakur came up with this name while in prison after being falsely accused of rape when studying Niccolo Machiavelli.", "annotation_id": "40037979", "url": "https://genius.com/40037979", "state": "pending", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
{"type": "line", "artist": "Rick Ross", "song": "Karate Chop (RichMix)", "line": "Ridin’ in that ghost, hammer on my lap", "vault_lines": ["Ridin' in that ghost, hammer on my lap"], "meaning": "He is driving around in the Rolls Royce Ghost, with a gun on his lap, using the slang word for it, “hammer”.\n\n\n\nThis is his Phantom, bought from ex NFL receiver Chad “Ochocinco” Johnson.", "annotation_id": "1830670", "url": "https://genius.com/1830670", "state": "accepted", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
