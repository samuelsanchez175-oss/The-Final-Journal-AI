{"type": "line", "artist": "Rick Ross", "song": "Instagram That H**", "line": "Alexander McQueen, hundred racks in my jeans", "vault_lines": ["Alexander McQueen, hundred racks in my jeans"], "meaning": "Lee Alexander McQueen was a British fashion designer and couturier. He is known for having worked as chief designer at Givenchy from 1996 to 2001 and for founding his own Alexander McQueen label. He’s earned four British Designer of the Year awards.", "annotation_id": "2182241", "url": "https://genius.com/2182241", "state": "pending", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
{"type": "line", "artist": "Rick Ross", "song": "Instagram That H**", "line": "Givenchy all on my back Versace all in my bag Margiellas all on my feet", "vault_lines": ["Givenchy all on my back", "Versace all in my bag", "Margiellas all on my feet"], "meaning": "Givenchy, Versace, and Maison Martin Margiellas are all high class clothing companies, basically he is just bragging.", "annotation_id": "1977674", "url": "https://genius.com/1977674", "state": "pending", "votes": 2, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
