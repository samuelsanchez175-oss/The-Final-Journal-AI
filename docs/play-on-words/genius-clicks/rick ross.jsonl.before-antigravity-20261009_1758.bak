{"type": "line", "artist": "Rick Ross", "song": "I’m Only Human", "line": "I run D.C. like Leo G", "vault_lines": ["I run D.C. like Leo G"], "meaning": "Leo G is an influential DJ based in the Washington, D.C. area.\n\nNote that he started a radio website called 66RAW.com, which ties into the “raw” lyrics above.", "annotation_id": "2513732", "url": "https://genius.com/2513732", "state": "accepted", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "accepted"}
{"type": "line", "artist": "Rick Ross", "song": "I’m Only Human", "line": "He never knew chocolate milk make you fart real bad", "vault_lines": ["He never knew chocolate milk make you fart real bad"], "meaning": "Ross uses this endearing example of his childhood lactose intolerance to emphasize his fathers disconnect with his son.\n\nNot a pretty sight…", "annotation_id": "1372101", "url": "https://genius.com/1372101", "state": "accepted", "votes": 9, "second_sense": true, "clicked": false, "click_status": "api", "strength": "accepted"}
