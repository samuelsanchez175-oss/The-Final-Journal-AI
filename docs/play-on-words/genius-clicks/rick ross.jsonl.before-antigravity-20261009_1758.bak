{"type": "line", "artist": "Rick Ross", "song": "Speedin’", "line": "Look that white girl in her face, told her this was our last dance", "vault_lines": ["Look that white girl in her face, told her this was our last dance"], "meaning": "Every time Rick uses cocaine he feels it may be his last, maybe because his life could end at any time, or maybe because he knows it is interfering with his business.", "annotation_id": "635729", "url": "https://genius.com/635729", "state": "accepted", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
{"type": "line", "artist": "Rick Ross", "song": "Speedin’", "line": "Sittin’ in the living room watching the Grammys Wishin’ that was me that was on the Grammys", "vault_lines": ["Sittin' in the living room watching the Grammys", "Wishin' that was me that was on the Grammys"], "meaning": "Before he was this famous he wished and hoped a lot for this moment of his life to come.\nHe achieved all his dreams by now.", "annotation_id": "332295", "url": "https://genius.com/332295", "state": "accepted", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "accepted"}
