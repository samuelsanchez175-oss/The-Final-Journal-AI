{"type": "line", "artist": "Rick Ross", "song": "300 Soldiers", "line": "Bitch I got a connect", "vault_lines": ["Bitch I got a connect"], "meaning": "Dealers usually have connection with cook houses to get purer substance cheaper. Having more than one connection invokes competition. More connections = better.", "annotation_id": "485739", "url": "https://genius.com/485739", "state": "accepted", "votes": 2, "second_sense": true, "clicked": false, "click_status": "api", "strength": "accepted"}
