{"type": "line", "artist": "Rick Ross", "song": "Here I Am", "line": "Home from FAMU with a gorgeous face Next semester, she transfer to Florida State", "vault_lines": ["Home from FAMU with a gorgeous face", "Next semester, she transfer to Florida State"], "meaning": "College girl who transferred from Florida Agricultural and Mechanical University to Florida State. Rozay either likes young girls or he’s telling us a story when he was younger.", "annotation_id": "262937", "url": "https://genius.com/262937", "state": "accepted", "votes": 2, "second_sense": true, "clicked": false, "click_status": "api", "strength": "accepted"}
