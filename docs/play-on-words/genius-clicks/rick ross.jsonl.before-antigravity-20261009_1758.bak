{"type": "line", "artist": "Rick Ross", "song": "Cash Flow", "line": "See, you can get pumped on like a Citgo", "vault_lines": ["See, you can get pumped on like a Citgo"], "meaning": "“Pumped on” refers to reloading a shotgun. The simile refers to “pumping gas”, as Citgo is a famous gas station.", "annotation_id": "31272", "url": "https://genius.com/31272", "state": "accepted", "votes": 3, "second_sense": true, "clicked": false, "click_status": "api", "strength": "accepted"}
