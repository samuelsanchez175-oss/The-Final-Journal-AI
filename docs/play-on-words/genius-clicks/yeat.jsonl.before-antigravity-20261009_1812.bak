{"type": "line", "artist": "Yeat", "song": "DISEASE", "line": "Yeah, you too soft, you too sweet, gingerbread man", "vault_lines": ["Yeah, you too soft, you too sweet, gingerbread man"], "meaning": "Yeat insults his critics by comparing them to something fragile and easily broken. The “gingerbread man” metaphor suggests weakness and lack of durability.", "annotation_id": "38603261", "url": "https://genius.com/38603261", "state": "pending", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
{"type": "line", "artist": "Yeat", "song": "DISEASE", "line": "Always got them turnin’ around Break your neck then", "vault_lines": ["Always got them turnin' around"], "meaning": "These lines exaggerate how much attention he attracts. People turning their heads “breaking their necks” highlights his visual presence, fashion, and status.", "annotation_id": "38603258", "url": "https://genius.com/38603258", "state": "pending", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
