{"type": "line", "artist": "Yeat", "song": "BË QUIET", "line": "Backstab ya bitch, I pick apart ya art to them, huh", "vault_lines": ["Backstab ya bitch, I pick apart ya art to them, huh"], "meaning": "Yeat is calling out other artists, suggesting that he dissects and criticizes other rappers work. He’s saying that he exposes their shortcomings and flaws to others, diminishing their standing in the rap community.", "annotation_id": "33323662", "url": "https://genius.com/33323662", "state": "pending", "votes": 8, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
