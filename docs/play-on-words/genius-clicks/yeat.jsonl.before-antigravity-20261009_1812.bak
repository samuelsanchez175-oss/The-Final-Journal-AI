{"type": "line", "artist": "Yeat", "song": "I Feel Alive 4 A Min*", "line": "Shawty, yeah, you done walked back on the thing that you said", "vault_lines": ["Shawty, yeah, you done walked back on the thing that you said"], "meaning": "Hes telling a lady he knows that she is taking back her words and is not honest. Possibly not loyal/faithful depending on what she said to Yeat.", "annotation_id": "40916650", "url": "https://genius.com/40916650", "state": "pending", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
