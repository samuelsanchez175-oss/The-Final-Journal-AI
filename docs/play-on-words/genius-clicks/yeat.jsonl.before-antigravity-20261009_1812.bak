{"type": "line", "artist": "Yeat", "song": "24/7", "line": "I’m high with the gods, fuck a parachute", "vault_lines": ["I'm high with the gods, fuck a parachute"], "meaning": "Yeat is saying he doesn’t need a parachute because he won’t ever get sober, so he won’t fall out of the sky.", "annotation_id": "27920842", "url": "https://genius.com/27920842", "state": "pending", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
