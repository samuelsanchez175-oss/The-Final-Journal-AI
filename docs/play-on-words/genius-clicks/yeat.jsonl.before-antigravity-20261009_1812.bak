{"type": "line", "artist": "Yeat", "song": "Talk 2 God", "line": "All these bitches flawless, I call this bitch a sink", "vault_lines": ["All these bitches flawless, I call this bitch a sink"], "meaning": "Referring to diamonds on a piece of jewelry or watch. All the diamonds are flawless. He calls the item a “sink” because it is drippy.", "annotation_id": "24157277", "url": "https://genius.com/24157277", "state": "pending", "votes": 14, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
