{"type": "line", "artist": "Yeat", "song": "Finally #FRËË", "line": "All these kid’s brains dissolving, it’s homicide All these kid’s brains dissolving, it’s homicide All these kid’s brains dissolving, it’s homicide", "vault_lines": ["All these kid's brains dissolving, it's homicide"], "meaning": "He’s saying drugs (like Percs) are killing the youth mentally and physically; it’s like murder of a generation.", "annotation_id": "37137043", "url": "https://genius.com/37137043", "state": "pending", "votes": 2, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
