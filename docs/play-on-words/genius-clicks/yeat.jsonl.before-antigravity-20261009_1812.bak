{"type": "line", "artist": "Yeat", "song": "përctivated", "line": "Put that Perky inside my juice and I get Perctivated", "vault_lines": ["Put that Perky inside my juice and I get Perctivated"], "meaning": "A portmanteau of the words “activated” and “percocet”. Yeat is saying when he gets high off of the perc, he gets activated.", "annotation_id": "34191470", "url": "https://genius.com/34191470", "state": "pending", "votes": 2, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
