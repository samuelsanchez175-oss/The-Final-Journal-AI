{"type": "line", "artist": "Yeat", "song": "Trëndy way", "line": "I just had to point it out like the top of a tent", "vault_lines": ["I just had to point it out like the top of a tent"], "meaning": "The top of a tent is typically pointy. Yeat uses a double entendre to reference the shape of a camping tent.", "annotation_id": "27650520", "url": "https://genius.com/27650520", "state": "pending", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
{"type": "line", "artist": "Yeat", "song": "Trëndy way", "line": "A hundred milligrams, I just left the Earth", "vault_lines": ["A hundred milligrams, I just left the Earth"], "meaning": "SeptembersRich is high off of an unnamed drug, so high that it feels like hes “higher” than earth which would explain him “leaving” earth.", "annotation_id": "27073253", "url": "https://genius.com/27073253", "state": "pending", "votes": 6, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
{"type": "line", "artist": "Yeat", "song": "Trëndy way", "line": "(Keep it up, sharkboy)", "vault_lines": ["Yeah, do this shit the trendy way (Keep it up, sharkboy)"], "meaning": "Sharkboy is an underground producer which produces many beats for Yeat. Yeat helped Sharkboy gain traction when he featured on sharkboys EP, Underwater.", "annotation_id": "25914941", "url": "https://genius.com/25914941", "state": "pending", "votes": 12, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
