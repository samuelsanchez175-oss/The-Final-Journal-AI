{"type": "line", "artist": "Yeat", "song": "Talk 2 God", "line": "Couple of years ago in the basement, had a noodle pot (Yeah)", "vault_lines": ["Couple of years ago in the basement, had a noodle pot (Yeah)"], "meaning": "Yeat is showing how much his life has changed now that he is a successful rapper, comparing his rich life to his poor life he had a couple years ago.", "annotation_id": "25987322", "url": "https://genius.com/25987322", "state": "pending", "votes": 2, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
