{"type": "line", "artist": "Yeat", "song": "Good Day", "line": "Every day, Yeat going up", "vault_lines": ["(Up, up, up, up, up, up, up) Every day, Yeat going up"], "meaning": "Yeat flaunts his exponential success of the past two years in this line. He believes that he is only going up every single day, revealing his growth mindset.", "annotation_id": "29516972", "url": "https://genius.com/29516972", "state": "pending", "votes": 3, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
{"type": "line", "artist": "Yeat", "song": "Good Day", "line": "Got all fresh hunnids, got blue bills,", "vault_lines": ["Got all fresh hunnids, got blue bills,"], "meaning": "$100 dollar bills were redesigned with a blue translucent strip in 2013 to make counterfeits more distinguishable from regular bills. Yeat saying that all of his $100’s are blue, indicates that he has blown up recently and gotten money in a short period of time.", "annotation_id": "29516523", "url": "https://genius.com/29516523", "state": "pending", "votes": 2, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
