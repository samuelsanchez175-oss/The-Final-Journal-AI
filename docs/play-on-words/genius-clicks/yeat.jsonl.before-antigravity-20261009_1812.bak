{"type": "line", "artist": "Yeat", "song": "M.F.U.", "line": "Yeah, live my life, middle fingers up ’til the day I die (Woo)", "vault_lines": ["Yeah, live my life, middle fingers up 'til the day I die (Woo)"], "meaning": "A rebellious motto. He lives defiantly, rejecting criticism or authority.", "annotation_id": "38798232", "url": "https://genius.com/38798232", "state": "pending", "votes": 0, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
