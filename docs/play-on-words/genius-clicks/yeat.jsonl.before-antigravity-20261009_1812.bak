{"type": "line", "artist": "Yeat", "song": "Killin ëm", "line": "BNYX", "vault_lines": ["Got hunnid round, bitch, got hunnid round, bitch, got hunnid round, bitch, got hunnid round chops"], "meaning": "BNYX is a member of the producer collective, Working on dying. BNYX and Yeat have collaborated on many releases and unreleased songs.", "annotation_id": "27784752", "url": "https://genius.com/27784752", "state": "pending", "votes": 5, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
{"type": "line", "artist": "Yeat", "song": "Killin ëm", "line": "Yeah, I been servin’ them boys like I’m workin’ at Chili’s (What? What? Yeah)", "vault_lines": ["Yeah, I been servin' them boys like I'm workin' at Chili's (What? What? Yeah)"], "meaning": "Yeat refers to selling drugs to fiends as serving like a waiter would to the customers.", "annotation_id": "27711525", "url": "https://genius.com/27711525", "state": "pending", "votes": 2, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
