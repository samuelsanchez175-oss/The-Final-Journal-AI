{"type": "line", "artist": "Yeat", "song": "BARBARIAN", "line": "Barbarian And my diamonds in the Ice Age, barbarian", "vault_lines": ["And my diamonds in the Ice Age, barbarian"], "meaning": "Yeat channels a raw, fierce vibe that reflects his unapologetic attitude. By contrasting luxury with tough times, he highlights his journey from struggle to success, showing pride in where he came from while flexing his achievements.", "annotation_id": "33414054", "url": "https://genius.com/33414054", "state": "pending", "votes": 4, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
