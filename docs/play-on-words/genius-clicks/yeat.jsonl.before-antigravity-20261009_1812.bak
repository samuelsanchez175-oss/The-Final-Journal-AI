{"type": "line", "artist": "Yeat", "song": "Never quit", "line": "Yeah, I could never quit (Quit) Yeah, I could never quit (No, no)", "vault_lines": ["Yeah, I could never quit (Quit)"], "meaning": "Calling himself a winner who just grows and never gives up, Yeat tries to deliver his “Never give-up” attitude to the whole community with this bar.", "annotation_id": "30939692", "url": "https://genius.com/30939692", "state": "pending", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
