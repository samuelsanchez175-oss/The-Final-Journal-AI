{"type": "line", "artist": "Yeat", "song": "Doublë", "line": "Walked in YSL, then left with a closet", "vault_lines": ["Walked in YSL, then left with a closet"], "meaning": "YSL refers to the French luxury fashion brand Yves Saint Laurent.\n\nYeat went into a YSL store, presumably to shop for clothes, and ended up buying so much that they left with a closet’s worth of merchandise.", "annotation_id": "28360824", "url": "https://genius.com/28360824", "state": "pending", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
