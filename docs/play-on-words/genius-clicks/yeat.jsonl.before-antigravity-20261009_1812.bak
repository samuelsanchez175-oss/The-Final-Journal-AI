{"type": "line", "artist": "Yeat", "song": "Forëally / 4Ly", "line": "Swerving in the coupe, I’m going two hunnid, fuck a copper", "vault_lines": ["Swerving in the coupe, I'm going two hunnid, fuck a copper"], "meaning": "Yeat is speeding inside of his coupe, which refers to a fast car, whist traveling at 200 m/ph (321.87 k/ph) and is not concerned about being pulled over by a police officer.", "annotation_id": "33280454", "url": "https://genius.com/33280454", "state": "pending", "votes": -1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
