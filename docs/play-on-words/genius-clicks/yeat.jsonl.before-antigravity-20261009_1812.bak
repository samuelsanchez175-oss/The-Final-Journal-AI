{"type": "line", "artist": "Yeat", "song": "GOD TALKIN SHHH", "line": "Ran off on the mob, we popped off, and shoot a motherfucker", "vault_lines": ["Ran off on the mob, we popped off, and shoot a motherfucker"], "meaning": "Since the bar starts with a “Pl”, we can assume that he was about to say\n\nRan off on the plug\n\nRunning off on the plug means not paying for the narcotics supplied by the plug.", "annotation_id": "33353190", "url": "https://genius.com/33353190", "state": "accepted", "votes": 8, "second_sense": true, "clicked": false, "click_status": "api", "strength": "accepted"}
