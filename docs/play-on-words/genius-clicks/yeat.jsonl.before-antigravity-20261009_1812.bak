{"type": "line", "artist": "Yeat", "song": "NIGHT COME", "line": "I’m the highest, so I’m feelin’ myself, uh-huh", "vault_lines": ["I'm the highest, so I'm feelin' myself, uh-huh"], "meaning": "Being “the highest” implies that Yeat is under the influence of drugs, likely feeling the effects strongly. The drugs are making him feel super confident and self-assured of himself.", "annotation_id": "33275679", "url": "https://genius.com/33275679", "state": "pending", "votes": 4, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
