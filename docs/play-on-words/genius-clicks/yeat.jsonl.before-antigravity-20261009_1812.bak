{"type": "line", "artist": "Yeat", "song": "try me", "line": "All this bank comin’ in", "vault_lines": [", all this bank comin' in"], "meaning": "This is a flex about financial success—an indication that the speaker is doing well financially, with consistent earnings rolling in.", "annotation_id": "35416098", "url": "https://genius.com/35416098", "state": "pending", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
{"type": "line", "artist": "Yeat", "song": "try me", "line": "I’m on a new level", "vault_lines": ["I'm on a new level"], "meaning": "If an artist says “I’m on a new level,” it’s typically a flex about how far they’ve come and how they’re surpassing others, making it clear that they’ve left their previous struggles or limitations behind.", "annotation_id": "35416094", "url": "https://genius.com/35416094", "state": "pending", "votes": 1, "second_sense": true, "clicked": false, "click_status": "api", "strength": "weak"}
